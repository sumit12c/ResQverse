// SCENE 2 — START SCREEN
// ─────────────────────────────────────────────────────────────────────────────
class StartScene extends Phaser.Scene {
  constructor(){ super('Start'); }
  create(){
    SFX.startAmbient();
    const cx=W/2, cy=H/2;
    // Dark gradient bg
    const bg=this.add.graphics();
    bg.fillGradientStyle(0x0a0020,0x0a0020,0x200040,0x0a0010,1);
    bg.fillRect(0,0,W,H);

    // Stars
    for(let i=0;i<120;i++){
      const x=Phaser.Math.Between(0,W), y=Phaser.Math.Between(0,H*0.8);
      const r=Phaser.Math.FloatBetween(0.5,2.5);
      const star=this.add.circle(x,y,r,0xffffff,Phaser.Math.FloatBetween(0.3,1));
      this.tweens.add({ targets:star, alpha:{from:Phaser.Math.FloatBetween(0.1,0.4),to:1}, duration:Phaser.Math.Between(1000,3000), yoyo:true, repeat:-1, delay:Phaser.Math.Between(0,2000) });
    }

    // Ground silhouette
    const gfx=this.add.graphics();
    gfx.fillStyle(0x0a0018,1);
    gfx.fillRect(0,H*0.75,W,H*0.25);
    // City skyline silhouette
    [[50,60],[120,100],[200,70],[300,120],[380,80],[460,140],[550,90],[650,110],[720,75],[760,50]].forEach(([x,bh])=>{
      gfx.fillStyle(0x150828,1);
      gfx.fillRect(x,H*0.75-bh,50,bh);
      // Windows
      gfx.fillStyle(0xffdd44,0.4);
      for(let wy=4;wy<bh-4;wy+=10) for(let wx=4;wx<44;wx+=10){
        if(Math.random()>0.4) gfx.fillRect(x+wx,H*0.75-bh+wy,6,7);
      }
    });

    // Logo - big pixel text
    const logo=this.add.text(cx,cy-120,'ResQVerse',{
      fontFamily:'monospace', fontSize:72, fontStyle:'bold',
      fill:'#ffffff', stroke:'#ff6b35', strokeThickness:4,
      shadow:{color:'#ff00aa',blur:30,fill:true}
    }).setOrigin(0.5);

    // Animated color cycle
    let hue=0;
    this.time.addEvent({ delay:50, repeat:-1, callback:()=>{
      hue=(hue+2)%360;
      const [r,g,b]=hslToRgb(hue/360,1,0.6);
      logo.setStroke(`rgb(${r},${g},${b})`,4);
    }});
    this.tweens.add({ targets:logo, scaleX:{from:1,to:1.03}, scaleY:{from:1,to:1.03}, duration:1800, yoyo:true, repeat:-1 });

    this.add.text(cx,cy-50,'DISASTER PREPAREDNESS · SURVIVE & LEARN',{
      fontFamily:'monospace', fontSize:13, fill:'#9988bb', letterSpacing:3
    }).setOrigin(0.5);

    // Controls hint box
    const box=this.add.graphics();
    box.fillStyle(0x000000,0.5); box.fillRoundedRect(cx-220,cy-20,440,80,10);
    box.lineStyle(1,0x554477); box.strokeRoundedRect(cx-220,cy-20,440,80,10);
    const controls=[
      ['WASD','Move'],['SPACE','Jump'],['SHIFT','Sprint'],['E','Interact']
    ];
    controls.forEach(([k,v],i)=>{
      const x=cx-200+i*110;
      this.add.text(x,cy,k,{fontFamily:'monospace',fontSize:13,fill:'#ffd700',backgroundColor:'#332244',padding:{x:4,y:2}}).setOrigin(0.5);
      this.add.text(x,cy+22,v,{fontFamily:'monospace',fontSize:11,fill:'#aaaacc'}).setOrigin(0.5);
    });

    // Play button — use Container so bg + text move as one unit
    const btnContainer = this.add.container(cx, cy+106);

    const btnBg = this.add.graphics();
    btnBg.fillGradientStyle(0xff6b35,0xff6b35,0xffd700,0xffd700,1);
    btnBg.fillRoundedRect(-100,-26,200,52,26);

    const btn = this.add.text(0, 0, '▶  PLAY NOW', {
      fontFamily:'monospace', fontSize:22, fontStyle:'bold', fill:'#000000'
    }).setOrigin(0.5).setInteractive({useHandCursor:true});

    btnContainer.add([btnBg, btn]);

    // Float animation on the container — bg and text always stay aligned
    this.tweens.add({ targets:btnContainer, y:'+=6', duration:900, yoyo:true, repeat:-1 });

    btn.on('pointerover', ()=>{ this.tweens.add({targets:btnContainer, scaleX:1.06, scaleY:1.06, duration:120}); });
    btn.on('pointerout',  ()=>{ this.tweens.add({targets:btnContainer, scaleX:1,    scaleY:1,    duration:120}); });
    btn.on('pointerdown', ()=>{
      SFX.ensure(); SFX.teleport();
      this.cameras.main.fade(500,0,0,0);
      this.time.delayedCall(500,()=>{ SFX.stopAmbient(); this.scene.start('Hall'); });
    });

    // Version
    this.add.text(W-8,H-6,'v1.0 | ResQVerse',{fontFamily:'monospace',fontSize:10,fill:'#443355'}).setOrigin(1,1);
    document.getElementById('crossBtn').style.display='flex';
  }
}

// ═════════════════════════════════════════════════════════════════════════════
// ██████████████████████████  PLAYER CLASS (OOP)  █████████████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  A self-contained, reusable Player class built on top of Phaser's arcade
//  physics sprite. Any game scene can instantiate one Player and just call
//  player.update(delta) each frame — no animation state or input variables
//  need to live in the scene itself.
//
//  USAGE (in any scene):
//    // Create
//    this.player = new Player(this, x, y, { speed, jumpForce, canCrouch });
//
//    // Wire collisions (pass your static floor/platform groups)
//    this.player.addCollider(this.floorGroup);
//    this.player.addCollider(this.platformGroup);
//
//    // Each frame
//    update(){ this.player.update(); }
//
//  PUBLIC API:
//    player.sprite          — the underlying Phaser physics sprite
//    player.x / player.y   — shorthand position getters
//    player.onGround        — true when standing on something
//    player.isCrouching     — true when S/↓ is held on ground
//    player.isUnderCover    — true when crouching inside a registered cover zone
//    player.facingLeft      — current direction
//    player.addCoverZone(x,y,w,h) — register a safe cover rectangle
//    player.clearCoverZones()     — reset cover zones (new level)
//    player.setKeys(keyMap) — override default key bindings
//    player.kill()          — play death animation
//    player.reset(x, y)     — reposition and restore to alive state
// ═════════════════════════════════════════════════════════════════════════════

class Player {
  /**
   * @param {Phaser.Scene} scene   - The scene this player belongs to
   * @param {number}       x       - Spawn X
   * @param {number}       y       - Spawn Y (bottom of sprite, origin 0.5,1)
   * @param {object}       cfg     - Optional config overrides
   *   cfg.speed      {number}  - Walk speed px/s          (default 145)
   *   cfg.jumpForce  {number}  - Jump velocity (negative)  (default -430)
   *   cfg.canCrouch  {boolean} - Whether S key crouches    (default true)
   *   cfg.depth      {number}  - Render depth              (default 10)
   *   cfg.gravity    {number}  - Arcade gravity Y          (default 600)
   */
  constructor(scene, x, y, cfg={}){
    this.scene      = scene;
    this.speed      = cfg.speed     ?? 145;
    this.jumpForce  = cfg.jumpForce ?? -430;
    this.canCrouch  = cfg.canCrouch ?? true;
    this.canJump    = cfg.canJump   ?? true;
    this._depth     = cfg.depth     ?? 10;

    // ── Spawn the Phaser physics sprite ──
    this.sprite = scene.physics.add.sprite(x, y, 'player_idle0')
      .setOrigin(0.5, 1)
      .setDepth(this._depth)
      .setDisplaySize(32, 52)
      .setCollideWorldBounds(true);

    this.sprite.setGravityY(cfg.gravity ?? 600);

    // ── Internal animation state ──
    this._walkFrame  = 0;
    this._idleFrame  = 0;
    this._walkTimer  = 0;
    this._idleTimer  = 0;

    // ── Public state flags ──
    this.facingLeft  = false;
    this.isCrouching = false;
    this.isUnderCover= false;
    this.alive       = true;

    // ── Cover zones list [{x,y,w,h}] ──
    this._coverZones = [];

    // ── Default key bindings (can be overridden via setKeys) ──
    this._keys = scene.input.keyboard.addKeys({
      left:   Phaser.Input.Keyboard.KeyCodes.A,
      right:  Phaser.Input.Keyboard.KeyCodes.D,
      arrowL: Phaser.Input.Keyboard.KeyCodes.LEFT,
      arrowR: Phaser.Input.Keyboard.KeyCodes.RIGHT,
      jump:   Phaser.Input.Keyboard.KeyCodes.W,
      arrowU: Phaser.Input.Keyboard.KeyCodes.UP,
      crouch: Phaser.Input.Keyboard.KeyCodes.S,
      arrowD: Phaser.Input.Keyboard.KeyCodes.DOWN,
    });
  }

  // ── POSITION GETTERS ────────────────────────────────────────────────────────
  get x(){ return this.sprite.x; }
  get y(){ return this.sprite.y; }
  get onGround(){ return this.sprite.body.blocked.down; }

  // ── COLLIDERS ───────────────────────────────────────────────────────────────
  /** Wire a static group (floor, platform) so the player lands on it. */
  addCollider(group){
    this.scene.physics.add.collider(this.sprite, group);
    return this;
  }

  // ── COVER ZONES ─────────────────────────────────────────────────────────────
  /**
   * Register a rectangle as a valid "under cover" area.
   * @param {number} x  - Center X of the zone
   * @param {number} y  - Center Y of the zone
   * @param {number} w  - Width
   * @param {number} h  - Height
   */
  addCoverZone(x, y, w, h){
    this._coverZones.push({ x, y, w, h });
  }

  clearCoverZones(){
    this._coverZones = [];
  }

  // ── KEY OVERRIDE ────────────────────────────────────────────────────────────
  /**
   * Replace the default key map.
   * Pass a Phaser KeyMap object created with scene.input.keyboard.addKeys().
   */
  setKeys(keyMap){
    this._keys = keyMap;
  }

  // ── KILL / RESET ────────────────────────────────────────────────────────────
  kill(){
    if(!this.alive) return;
    this.alive = false;
    this.sprite.setTint(0xff0000);
    this.scene.tweens.add({
      targets: this.sprite,
      y: '+=20', alpha: 0,
      duration: 600
    });
  }

  reset(x, y){
    this.alive        = true;
    this.isCrouching  = false;
    this.isUnderCover = false;
    this.facingLeft   = false;
    this.sprite
      .setPosition(x, y)
      .setAlpha(1)
      .clearTint()
      .setDisplaySize(32, 52)
      .setTexture('player_idle0')
      .setVelocity(0, 0);
  }

  // ── UPDATE — call this every frame from your scene's update() ──────────────
  /**
   * Reads input, moves the sprite, and advances the correct animation frame.
   * Also updates this.isCrouching and this.isUnderCover automatically.
   *
   * @param {number} [dt=16.6]  - Delta time in ms (optional, used for timers)
   */
  update(dt=16.6){
    if(!this.alive) return;

    const k  = this._keys;
    const sp = this.sprite;
    const onGround = this.onGround;

    // ── Read crouch intent ──────────────────────────────────────────────────
    const wantCrouch = this.canCrouch &&
      (k.crouch.isDown || k.arrowD.isDown || window._mSprint) &&
      onGround;

    // ── Horizontal movement ─────────────────────────────────────────────────
    // Crouching allows movement but at 40% speed (crawling)
    let vx = 0;
    const moveSpeed = wantCrouch ? this.speed * 0.4 : this.speed;
    if(k.left.isDown  || k.arrowL.isDown || window._joyX < -0.25) vx = -moveSpeed;
    if(k.right.isDown || k.arrowR.isDown || window._joyX >  0.25) vx =  moveSpeed;
    if(vx < 0) this.facingLeft = true;
    if(vx > 0) this.facingLeft = false;
    sp.setVelocityX(vx);

    // ── Jump ────────────────────────────────────────────────────────────────
    if(this.canJump && (k.jump.isDown || k.arrowU.isDown || window._mJump) && onGround && !wantCrouch){
      sp.setVelocityY(this.jumpForce);
      window._mJump = false;
    } else if(!this.canJump){
      window._mJump = false; // consume so it doesn't accumulate
    }

    // ── Crouch state + sprite squish ────────────────────────────────────────
    this.isCrouching = wantCrouch;
    if(this.isCrouching){
      sp.setDisplaySize(32, 28);   // visually squish to half height
    } else {
      sp.setDisplaySize(32, 52);
    }

    // ── Cover zone check ────────────────────────────────────────────────────
    this.isUnderCover = false;
    if(this.isCrouching){
      for(const cz of this._coverZones){
        const inX = sp.x > cz.x - cz.w/2 && sp.x < cz.x + cz.w/2;
        const inY = sp.y > cz.y - cz.h/2 && sp.y <= cz.y + cz.h/2 + 10;
        if(inX && inY){ this.isUnderCover = true; break; }
      }
    }

    // ── Animation ───────────────────────────────────────────────────────────
    if(this.isCrouching){
      sp.setTexture('player_crouch');
    } else if(!onGround){
      sp.setTexture('player_jump');
    } else if(Math.abs(vx) > 0){
      this._walkTimer += dt;
      if(this._walkTimer > 100){
        this._walkTimer = 0;
        this._walkFrame = (this._walkFrame + 1) % 8;
      }
      sp.setTexture('player_walk' + this._walkFrame);
    } else {
      this._idleTimer += dt;
      if(this._idleTimer > 600){
        this._idleTimer = 0;
        this._idleFrame = (this._idleFrame + 1) % 2;
      }
      sp.setTexture('player_idle' + this._idleFrame);
    }

    // Character sprite default orientation = faces LEFT in the canvas.
    // So: facingLeft=true → no flip (default) → faces left ✓
    //     facingLeft=false → flip → faces right ✓
    sp.setFlipX(!this.facingLeft);
  }
}
// ── END OF Player CLASS ─────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// SCENE 3 — SELECTION HALL
// ─────────────────────────────────────────────────────────────────────────────
class HallScene extends Phaser.Scene {
  constructor(){ super('Hall'); }

  create(){
    SFX.startAmbient();
    this.camX=0; this.targetCamX=0;

    // ── WORLD (wide scrolling) ──
    const WORLD_W=1200;

    // Parallax BG layers
    this.bg1=this.add.graphics().setScrollFactor(0);
    this.bg1.fillGradientStyle(0x0a0028,0x0a0028,0x200840,0x100428,1);
    this.bg1.fillRect(0,0,W,H);

    // Stars (scroll slow)
    this.stars=this.add.graphics().setScrollFactor(0.1);
    for(let i=0;i<80;i++){
      const x=Phaser.Math.Between(0,WORLD_W), y=Phaser.Math.Between(0,H*0.6);
      this.stars.fillStyle(0xffffff,Phaser.Math.FloatBetween(0.2,0.9));
      this.stars.fillCircle(x,y,Phaser.Math.FloatBetween(0.5,2));
    }

    // Set world bounds
    this.cameras.main.setBounds(0,0,WORLD_W,H);
    this.physics.world.setBounds(0,0,WORLD_W,H);

    // Floor (marble tiles)
    const FLOOR_Y=H-80;
    for(let x=0;x<WORLD_W;x+=32){
      const tile=this.add.image(x,FLOOR_Y,'tile_marble').setOrigin(0,0).setDisplaySize(32,32);
      // Second row below
      this.add.image(x,FLOOR_Y+32,'tile_marble').setOrigin(0,0).setDisplaySize(32,32).setAlpha(0.7);
    }

    // Ceiling strip
    for(let x=0;x<WORLD_W;x+=32){
      this.add.image(x,0,'ceiling_dark').setOrigin(0,0).setDisplaySize(32,32).setAlpha(0.8);
    }

    // Back wall
    for(let x=0;x<WORLD_W;x+=32) for(let y=32;y<FLOOR_Y;y+=32){
      this.add.image(x,y,'wall_dark').setOrigin(0,0).setDisplaySize(32,32).setAlpha(0.6);
    }

    // Decorative pillars
    for(let x=100;x<WORLD_W;x+=200){
      this.add.image(x,FLOOR_Y-128,'pillar_lobby').setOrigin(0.5,1).setDisplaySize(24,128);
      // Glow
      const gl=this.add.circle(x,FLOOR_Y-128,12,0xaa44ff,0.4);
      this.tweens.add({targets:gl,alpha:{from:0.2,to:0.6},duration:1200,yoyo:true,repeat:-1,delay:x*2});
      // Ceiling lamp
      const lamp=this.add.circle(x,32,6,0xffffaa,1);
      this.add.circle(x,32,14,0xffffaa,0.2);
      this.tweens.add({targets:lamp,alpha:{from:0.7,to:1},duration:800,yoyo:true,repeat:-1,delay:x});
    }

    // ── SIGN ──
    const signBg=this.add.graphics();
    signBg.fillStyle(0x1a0840,0.9); signBg.fillRoundedRect(WORLD_W/2-280,40,560,52,10);
    signBg.lineStyle(2,0xaa44ff); signBg.strokeRoundedRect(WORLD_W/2-280,40,560,52,10);
    this.add.text(WORLD_W/2,66,'✦ DISASTER PREPAREDNESS SELECTION HALL ✦',{
      fontFamily:'monospace',fontSize:16,fontStyle:'bold',fill:'#ffd700'
    }).setOrigin(0.5);

    // ── PORTAL DOORS ──
    const portals=[
      { x:250, label:'EARTHQUAKE', sub:'Natural Disaster', color:0xff4400, colorHex:'#ff4400', available:true,  scene:'Earthquake',     idx:0 },
      { x:450, label:'FIRE',       sub:'Building Fire',    color:0xff8800, colorHex:'#ff8800', available:true,  scene:'Fire',           idx:1 },
      { x:650, label:'TSUNAMI',    sub:'Ocean Surge',      color:0x0088ff, colorHex:'#0088ff', available:true,  scene:'Tsunami', idx:2 },
      { x:850, label:'CYCLONE',    sub:'Storm Safety',     color:0xaa44ff, colorHex:'#aa44ff', available:true,  scene:'Cyclone', idx:3 },
      { x:1000,label:'FLOOD',      sub:'Rising Waters',    color:0x00ccff, colorHex:'#00ccff', available:true,  scene:'Flood',   idx:4 },
    ];

    this.portals=[];
    portals.forEach(p=>{
      const grp=this.add.container(p.x,FLOOR_Y-10);

      // Glow base
      const glow=this.add.ellipse(0,0,80,24,p.color,0.3);
      grp.add(glow);
      if(p.available) this.tweens.add({targets:glow,scaleX:{from:1,to:1.3},alpha:{from:0.2,to:0.5},duration:1000,yoyo:true,repeat:-1});

      // Portal frame (door)
      const tex=p.available?`portal_${p.idx}`:'portal_locked';
      const door=this.add.image(0,-56,tex).setOrigin(0.5,1).setDisplaySize(64,112);
      grp.add(door);

      // Animate available portals
      if(p.available){
        this.tweens.add({targets:door,y:{from:-56,to:-62},duration:1500,yoyo:true,repeat:-1});
        // Shimmer particles
        this.time.addEvent({delay:300,repeat:-1,callback:()=>{
          if(!p.available) return;
          const px=this.add.rectangle(p.x+Phaser.Math.Between(-20,20),FLOOR_Y-Phaser.Math.Between(20,100),3,3,p.color,0.8);
          this.tweens.add({targets:px,y:'-=40',alpha:0,duration:800,onComplete:()=>px.destroy()});
        }});
      }

      // Name label
      const nameBg=this.add.graphics();
      nameBg.fillStyle(0x000000,0.7); nameBg.fillRoundedRect(-48,-132,96,22,6);
      nameBg.lineStyle(1,p.color); nameBg.strokeRoundedRect(-48,-132,96,22,6);
      grp.add(nameBg);
      grp.add(this.add.text(0,-121,p.label,{fontFamily:'monospace',fontSize:11,fontStyle:'bold',fill:p.available?p.colorHex:'#666666'}).setOrigin(0.5));

      // Sub label
      const subTxt=this.add.text(0,-108,p.available?p.sub:'COMING SOON',{fontFamily:'monospace',fontSize:9,fill:p.available?'#cccccc':'#555555'}).setOrigin(0.5);
      grp.add(subTxt);

      // Interact zone (invisible rectangle for proximity)
      const zone=this.add.rectangle(p.x,FLOOR_Y-56,80,120,0x000000,0);
      this.portals.push({...p, glow, door, zone, grp});
    });

    // ── DECORATIONS ──
    // Carpet runner
    const carpet=this.add.graphics();
    carpet.fillStyle(0x6600aa,0.4); carpet.fillRect(0,FLOOR_Y+2,WORLD_W,30);
    carpet.lineStyle(2,0xaa44ff); carpet.strokeRect(0,FLOOR_Y+2,WORLD_W,30);

    // Benches
    [150,350,550,750,950].forEach(bx=>{
      this.add.image(bx,FLOOR_Y-2,'sofa').setOrigin(0.5,1).setDisplaySize(64,40);
    });

    // ── PLAYER (OOP Player class) ──
    // Instantiate reusable Player — no animation/input state needed in scene
    this.player = new Player(this, 80, FLOOR_Y, {
      speed: 120, jumpForce: -380, canCrouch: false, gravity: 400
    });

    // Floor collider
    const floorBody=this.physics.add.staticGroup();
    const floorBlock=this.add.rectangle(WORLD_W/2,FLOOR_Y+16,WORLD_W,32,0x000000,0);
    this.physics.add.existing(floorBlock,true);
    this.player.addCollider(floorBlock);

    // Camera follow the underlying sprite
    this.cameras.main.startFollow(this.player.sprite,true,0.08,0.08);
    this.cameras.main.setDeadzone(W*0.25,H);

    // ── INTERACT KEY (separate — not part of Player movement keys) ──
    this.interactKey=this.input.keyboard.addKey(Phaser.Input.Keyboard.KeyCodes.E);

    // ── INTERACTION LABEL ──
    this.interactLabel=this.add.text(W/2,H-110,'[ E ] Enter Portal',{
      fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#ffd700',
      backgroundColor:'rgba(0,0,0,0.8)',padding:{x:10,y:6}
    }).setOrigin(0.5).setScrollFactor(0).setVisible(false).setDepth(20);

    // ── INSTRUCTIONS STRIP ──
    this.add.text(W/2,H-20,'WASD / Arrow Keys to move  ·  SPACE to jump  ·  E to enter portal',{
      fontFamily:'monospace',fontSize:12,fontStyle:'bold',fill:'#00ff88',
      backgroundColor:'rgba(0,0,0,0.85)',padding:{x:12,y:8}
    }).setOrigin(0.5).setScrollFactor(0);

    this.nearPortal=null;

    // Mobile
    setupMobile(this);
  }

  update(dt){
    if(!this.player) return;

    // ── Delegate movement + animation to Player class ──
    this.player.update(dt);

    // ── Portal proximity (use player.x / player.y getters) ──
    this.nearPortal=null;
    this.portals.forEach(port=>{
      if(!port.available) return;
      if(Math.abs(this.player.x - port.x) < 60) this.nearPortal=port;
    });
    this.interactLabel.setVisible(!!this.nearPortal);

    // ── E key interact ──
    if(Phaser.Input.Keyboard.JustDown(this.interactKey)||window._mAction){
      window._mAction=false;
      if(this.nearPortal) this.enterPortal(this.nearPortal);
    }

    // Back button (mobile)
    if(window._mBack){ window._mBack=false; }
  }

  enterPortal(port){
    SFX.teleport();
    this.cameras.main.fade(600,0,0,0);
    this.time.delayedCall(600,()=>{
      SFX.stopAmbient();
      if(port.scene==='Fire'){
        this.scene.start('FireInstructions');
      } else if(port.scene==='Cyclone'){
        this.scene.start('CycloneInstructions');
      } else if(port.scene==='Tsunami'){
        this.scene.start('TsunamiInstructions');
      } else if(port.scene==='Flood'){
        this.scene.start('FloodInstructions');
      } else {
        currentLocation=LOCATIONS[Math.floor(Math.random()*LOCATIONS.length)];
        this.scene.start('Instructions',{location:currentLocation});
      }
    });
  }
}

