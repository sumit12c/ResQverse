// ═════════════════════════════════════════════════════════════════════════════
// ████████████████████████  CYCLONE SAFETY GAME  ██████████████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  CycloneScene — House safety before cyclone hits
//
//  TASKS (complete in any order before entering safe room):
//    1. Close 3 windows         (press E near each)
//    2. Close 2 doors           (press E near each)
//    3. Turn off electricity    (press E at fusebox)
//    4. Turn off gas valve      (press E at gas pipe)
//    5. Enter SAFE ROOM         (inner concrete room at center)
//
//  WIND DAMAGE:
//    - Wind ramps up over time, particles fly across screen
//    - Incomplete tasks = higher damage per second to house health bar
//    - House health hits 0 before all tasks = game over
//
//  SCORING:
//    +150 per task completed
//    +timeLeft * 4  time bonus
//    +200 all tasks done bonus
//    -damage taken from house health
// ═════════════════════════════════════════════════════════════════════════════
class CycloneScene extends Phaser.Scene {
  constructor(){ super('Cyclone'); }

  create(){
    this.score       = 0;
    this.timeLeft    = 120;
    this.gameOver    = false;
    this.houseHealth = 100;
    this.windStrength= 0;    // 0→100 over time
    this.allTasksDone= false;
    this.inSafeRoom  = false;
    this.windParticles=[];
    this.windFrame   = 0;
    this.tasksDone   = 0;

    // Task objects: {id, label, done, sprite, x, y, interactRange}
    this.tasks = [];

    const FY=H-80;
    this.FLOOR_Y=FY;

    this.buildHouse(FY);

    // Player
    this.player=new Player(this,80,FY-20,{speed:140,jumpForce:-390,canCrouch:false,canJump:true,gravity:600});
    this.player.addCollider(this.floorGroup);
    this.player.addCollider(this.wallGroup);

    this.interactKey=this.input.keyboard.addKey(Phaser.Input.Keyboard.KeyCodes.E);

    this.buildHUD();
    this.spawnWindParticles();

    // Countdown
    this.timerEvent=this.time.addEvent({delay:1000,repeat:119,callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.updateHUD();
      // Wind ramps up
      this.windStrength=Math.min(100,this.windStrength+1.2);
      // House damage — more damage per incomplete task
      const incomplete=this.tasks.filter(t=>!t.done).length;
      const dmg=(incomplete*0.4+0.2)*(this.windStrength/100);
      this.houseHealth=Math.max(0,this.houseHealth-dmg);
      this.updateHouseHealth();
      if(this.houseHealth<=0) this.endGame(false,'House destroyed by cyclone!');
      if(this.timeLeft<=0)    this.endGame(false,'Time ran out!');
    }});

    // Wind animation
    this.time.addEvent({delay:120,repeat:-1,callback:()=>{
      this.windFrame=(this.windFrame+1)%4;
      this.windGfxSprites&&this.windGfxSprites.forEach(w=>w.setTexture(`wind_${this.windFrame}`));
    }});

    // Notification
    this.notifTxt=this.add.text(W/2,H-130,'',{
      fontFamily:'monospace',fontSize:14,fontStyle:'bold',
      fill:'#aa44ff',backgroundColor:'rgba(0,0,0,0.88)',padding:{x:12,y:6}
    }).setOrigin(0.5).setDepth(60).setVisible(false);

    this.phaseTxt=this.add.text(W/2,H/2-20,'',{
      fontFamily:'monospace',fontSize:24,fontStyle:'bold',
      fill:'#aa44ff',stroke:'#000',strokeThickness:4,align:'center'
    }).setOrigin(0.5).setDepth(70).setVisible(false);

    this.hintTxt=this.add.text(W/2,H-58,'',{
      fontFamily:'monospace',fontSize:13,fontStyle:'bold',
      fill:'#ffd700',backgroundColor:'rgba(0,0,0,0.8)',padding:{x:8,y:4}
    }).setOrigin(0.5).setScrollFactor(0).setDepth(55).setVisible(false);

    setupMobile(this);
    const mAction=document.getElementById('mAction'); if(mAction) mAction.textContent='E';

    this.showBig('🌀 CYCLONE INCOMING!\nComplete safety tasks!','#aa44ff');
  }

  // ── BUILD HOUSE ─────────────────────────────────────────────────────────
  buildHouse(FY){
    // Sky — stormy dark purple-grey gradient
    const bg=this.add.graphics();
    bg.fillGradientStyle(0x1a0030,0x1a0030,0x330055,0x220044,1);
    bg.fillRect(0,0,W,H);
    // Storm clouds
    [[80,40],[220,30],[380,50],[560,35],[700,45]].forEach(([x,y])=>{
      bg.fillStyle(0x333355,0.6); bg.fillEllipse(x,y,120+Math.random()*60,40);
      bg.fillStyle(0x222244,0.4); bg.fillEllipse(x+20,y-10,80,30);
    });

    // Ground
    const gnd=this.add.graphics();
    gnd.fillStyle(0x2a4a1a,1); gnd.fillRect(0,FY,W,H-FY+32);
    gnd.fillStyle(0x1a3a0a,0.5); gnd.fillRect(0,FY,W,8);

    // Floor physics
    this.floorGroup=this.physics.add.staticGroup();
    const fb=this.add.rectangle(W/2,FY+16,W,32,0,0);
    this.physics.add.existing(fb,true); this.floorGroup.add(fb);
    this.wallGroup=this.physics.add.staticGroup();

    // ── HOUSE EXTERIOR (wide) ──
    const houseX=80, houseW=640, houseTop=FY-200;

    // House walls (outer)
    this.add.graphics().fillStyle(0xd4a878,1).fillRect(houseX,houseTop,houseW,200).setDepth(2);
    this.add.graphics().lineStyle(3,0x8b6914).strokeRect(houseX,houseTop,houseW,200).setDepth(3);
    // Roof
    const roof=this.add.graphics().setDepth(3);
    roof.fillStyle(0x8b2200,1);
    roof.fillTriangle(houseX-20,houseTop, houseX+houseW/2,houseTop-80, houseX+houseW+20,houseTop);
    roof.lineStyle(3,0x6b1800); roof.strokeTriangle(houseX-20,houseTop,houseX+houseW/2,houseTop-80,houseX+houseW+20,houseTop);

    // Physics walls (just floor level — house is visual, only floor matters)
    // Left wall boundary
    const lw=this.add.rectangle(houseX-15,FY-100,10,200,0,0);
    this.physics.add.existing(lw,true); this.wallGroup.add(lw);
    const rw=this.add.rectangle(houseX+houseW+15,FY-100,10,200,0,0);
    this.physics.add.existing(rw,true); this.wallGroup.add(rw);

    // ── INTERIOR ROOMS ──
    // Living room (left)
    this.add.graphics().fillStyle(0xf5e8d0,0.5).fillRect(houseX+5,houseTop+5,houseW/2-20,190).setDepth(2);
    this.add.text(houseX+houseW/4,houseTop+15,'LIVING ROOM',{fontFamily:'monospace',fontSize:9,fill:'#886644'}).setOrigin(0.5).setDepth(4);

    // Safe Room (center — concrete, darker)
    const srX=houseX+houseW/2-60, srW=120;
    this.add.graphics().fillStyle(0x888888,0.85).fillRect(srX,houseTop+5,srW,190).setDepth(3);
    this.add.graphics().lineStyle(4,0x555555).strokeRect(srX,houseTop+5,srW,190).setDepth(4);
    this.add.text(srX+srW/2,houseTop+20,'SAFE',{fontFamily:'monospace',fontSize:10,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5).setDepth(5);
    this.add.text(srX+srW/2,houseTop+34,'ROOM',{fontFamily:'monospace',fontSize:10,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5).setDepth(5);
    // Small reinforced window in safe room
    this.add.graphics().fillStyle(0x8899bb,0.6).fillRect(srX+40,houseTop+50,40,28).setDepth(4);
    this.add.graphics().lineStyle(4,0x444444).strokeRect(srX+40,houseTop+50,40,28).setDepth(5);
    // Cross bars
    this.add.graphics().lineStyle(3,0x333333).lineBetween(srX+60,houseTop+50,srX+60,houseTop+78).setDepth(5);
    this.add.graphics().lineStyle(3,0x333333).lineBetween(srX+40,houseTop+64,srX+80,houseTop+64).setDepth(5);

    // Right room
    this.add.graphics().fillStyle(0xf0dfc8,0.5).fillRect(houseX+houseW/2+60,houseTop+5,houseW/2-65,190).setDepth(2);
    this.add.text(houseX+houseW*3/4+30,houseTop+15,'BEDROOM',{fontFamily:'monospace',fontSize:9,fill:'#886644'}).setOrigin(0.5).setDepth(4);

    // Safe room entry zone (interaction area)
    this.safeRoomZone={x:srX+srW/2, y:FY-20, w:srW, h:40};
    // Glow indicator
    const sglow=this.add.rectangle(srX+srW/2,FY-20,srW,40,0x00ff88,0.12).setDepth(3);
    this.tweens.add({targets:sglow,alpha:{from:0.08,to:0.22},duration:1000,yoyo:true,repeat:-1});
    this.add.text(srX+srW/2,FY-50,'🏠 SAFE ROOM',{fontFamily:'monospace',fontSize:10,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5).setDepth(6);

    // ── TASK OBJECTS ──
    this.spawnTasks(houseX, houseW, houseTop, FY);

    // Furniture (visual)
    // Sofa
    this.add.image(houseX+80,FY-2,'sofa').setOrigin(0.5,1).setDisplaySize(90,36).setDepth(4);
    // Bookshelf
    this.add.image(houseX+houseW-80,FY-2,'shelf').setOrigin(0.5,1).setDisplaySize(50,80).setDepth(4);
    // Table
    this.add.image(houseX+houseW*3/4+30,FY-5,'table').setOrigin(0.5,1).setDisplaySize(70,16).setDepth(4);
  }

  // ── SPAWN TASKS ──────────────────────────────────────────────────────────
  spawnTasks(houseX, houseW, houseTop, FY){
    const FY2=FY;
    const taskDefs=[
      // 3 Windows
      {id:'win1', label:'Window 1', type:'window', x:houseX+80,   y:houseTop+80},
      {id:'win2', label:'Window 2', x:houseX+houseW-120, y:houseTop+80, type:'window'},
      {id:'win3', label:'Window 3', x:houseX+houseW-220, y:houseTop+130, type:'window'},
      // 2 Doors
      {id:'door1', label:'Front Door', type:'door', x:houseX+30,  y:FY2-40},
      {id:'door2', label:'Back Door',  type:'door', x:houseX+houseW-30, y:FY2-40},
      // Electricity
      {id:'elec',  label:'Electricity', type:'elec', x:houseX+160, y:houseTop+160},
      // Gas
      {id:'gas',   label:'Gas Valve',   type:'gas',  x:houseX+houseW-180, y:FY2-30},
    ];

    this.windGfxSprites=[];

    taskDefs.forEach(td=>{
      let texOpen, texClosed, dispW, dispH;
      if(td.type==='window'){  texOpen='window_open';  texClosed='window_closed'; dispW=42; dispH=36; }
      else if(td.type==='door'){texOpen='door_open'; texClosed='door_closed'; dispW=40; dispH=52; }
      else if(td.type==='elec'){texOpen='elec_on';  texClosed='elec_off'; dispW=36; dispH=44; }
      else { texOpen='gas_open'; texClosed='gas_closed'; dispW=40; dispH=40; }

      // Glow ring
      const glow=this.add.ellipse(td.x,td.y,dispW+14,dispH+14,0xffaa00,0.35).setDepth(5);
      this.tweens.add({targets:glow,scaleX:{from:0.9,to:1.1},alpha:{from:0.2,to:0.5},duration:700,yoyo:true,repeat:-1});

      const spr=this.add.image(td.x,td.y,texOpen).setDisplaySize(dispW,dispH).setDepth(6).setOrigin(0.5);
      const lbl=this.add.text(td.x,td.y-dispH/2-8,td.label,{fontFamily:'monospace',fontSize:8,fill:'#ffcc44',backgroundColor:'rgba(0,0,0,0.6)',padding:{x:3,y:1}}).setOrigin(0.5).setDepth(7);

      this.tasks.push({...td, sprite:spr, glow, label_txt:lbl, texOpen, texClosed, dispW, dispH, done:false});
    });

    // Wind stream sprites (decorative, animated)
    for(let i=0;i<8;i++){
      const ws=this.add.image(Phaser.Math.Between(0,W), Phaser.Math.Between(20,FY-40),'wind_0')
        .setDisplaySize(64,32).setAlpha(0.4).setDepth(8);
      this.windGfxSprites.push(ws);
    }
  }

  // ── HUD ──────────────────────────────────────────────────────────────────
  buildHUD(){
    const hBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    hBg.fillStyle(0x000000,0.75); hBg.fillRect(0,0,W,44);

    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 2:00',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#aa44ff'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);

    // Tasks done counter
    this.tasksTxt=this.add.text(W-14,10,'Tasks: 0/4',{fontFamily:'monospace',fontSize:13,fill:'#ffaa44'}).setOrigin(1,0).setScrollFactor(0).setDepth(41);

    // House health bar
    const hb=this.add.graphics().setScrollFactor(0).setDepth(40);
    hb.fillStyle(0x222222,1); hb.fillRect(14,46,180,10);
    this.hHealthFill=this.add.graphics().setScrollFactor(0).setDepth(41);
    this.add.text(14,58,'🏠 House',{fontFamily:'monospace',fontSize:9,fill:'#888888'}).setScrollFactor(0).setDepth(41);

    // Wind strength
    const wb=this.add.graphics().setScrollFactor(0).setDepth(40);
    wb.fillStyle(0x222222,1); wb.fillRect(W-194,46,180,10);
    this.windFill=this.add.graphics().setScrollFactor(0).setDepth(41);
    this.add.text(W-14,58,'Wind 🌀',{fontFamily:'monospace',fontSize:9,fill:'#888888'}).setOrigin(1,0).setScrollFactor(0).setDepth(41);

    // Task checklist (right side)
    this.checklistTxts=[];
    const labels=['🪟 Win 1','🪟 Win 2','🪟 Win 3','🚪 Door 1','🚪 Door 2','⚡ Elec','🔴 Gas'];
    labels.forEach((l,i)=>{
      const t=this.add.text(W-14,72+i*16,`☐ ${l}`,{fontFamily:'monospace',fontSize:10,fill:'#888888'}).setOrigin(1,0).setScrollFactor(0).setDepth(41);
      this.checklistTxts.push(t);
    });

    // Status strip
    const sBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    sBg.fillStyle(0x000000,0.65); sBg.fillRect(0,H-22,W,22);
    this.statusTxt=this.add.text(W/2,H-11,'🌀 Close windows, doors, then shut off electricity & gas!',
      {fontFamily:'monospace',fontSize:11,fill:'#aa88cc'}).setOrigin(0.5).setScrollFactor(0).setDepth(41);

    this.updateHouseHealth();
  }

  updateHUD(){
    const m=Math.floor(this.timeLeft/60), s=this.timeLeft%60;
    this.timerTxt.setText(`⏱ ${m}:${s.toString().padStart(2,'0')}`);
    if(this.timeLeft<=20) this.timerTxt.setColor('#ff4444');
    else if(this.timeLeft<=40) this.timerTxt.setColor('#ffaa00');
    this.scoreTxt.setText(`⭐ ${this.score}`);
    const done=this.tasks.filter(t=>t.done).length;
    this.tasksTxt.setText(`Tasks: ${done}/${this.tasks.length}`);
    // Wind bar
    this.windFill.clear();
    const wc=this.windStrength<50?0x4444ff:this.windStrength<80?0xaa44ff:0xff2266;
    this.windFill.fillStyle(wc,1); this.windFill.fillRect(W-194,46,Math.round(180*this.windStrength/100),10);
    // Checklist
    this.tasks.forEach((t,i)=>{
      if(this.checklistTxts[i]) this.checklistTxts[i].setText(`${t.done?'✓':'☐'} ${this.checklistTxts[i].text.slice(2)}`).setColor(t.done?'#00ff88':'#888888');
    });
  }

  updateHouseHealth(){
    this.hHealthFill.clear();
    const pct=this.houseHealth/100;
    const col=pct>0.6?0x44dd44:pct>0.3?0xffaa00:0xff3300;
    this.hHealthFill.fillStyle(col,1); this.hHealthFill.fillRect(14,46,Math.round(180*pct),10);
  }

  showNotif(msg,ok){
    this.notifTxt.setText(msg).setColor(ok?'#00ff88':'#ff6666').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifTxt);
    this.tweens.add({targets:this.notifTxt,alpha:0,duration:300,delay:2200,onComplete:()=>this.notifTxt.setVisible(false).setAlpha(1)});
  }

  showBig(msg,color='#aa44ff'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.5);
    this.tweens.add({targets:this.phaseTxt,scaleX:1,scaleY:1,duration:300,ease:'Back.Out'});
    this.time.delayedCall(2500,()=>this.tweens.add({targets:this.phaseTxt,alpha:0,duration:400,onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}));
  }

  // ── WIND PARTICLES ───────────────────────────────────────────────────────
  spawnWindParticles(){
    this.time.addEvent({delay:300,repeat:-1,callback:()=>{
      if(this.gameOver) return;
      const count=Math.ceil(this.windStrength/25)+1;
      for(let i=0;i<count;i++){
        const y=Phaser.Math.Between(30,this.FLOOR_Y-20);
        const p=this.add.rectangle(W+10,y,Phaser.Math.Between(6,18),Phaser.Math.Between(2,5),0xddddff,0.6+Math.random()*0.3).setDepth(9);
        const speed=80+this.windStrength*2.5+Phaser.Math.Between(-30,30);
        this.tweens.add({targets:p,x:-20,y:y+Phaser.Math.Between(-20,20),duration:speed*10/speed*600+400,onComplete:()=>p.destroy()});
      }
    }});
  }

  // ── INTERACT ─────────────────────────────────────────────────────────────
  tryInteract(){
    if(this.gameOver) return;
    let acted=false;
    this.tasks.forEach(t=>{
      if(t.done) return;
      const d=Phaser.Math.Distance.Between(this.player.x,this.player.y,t.x,t.y);
      if(d<70){
        t.done=true;
        t.sprite.setTexture(t.texClosed);
        t.glow.setVisible(false);
        SFX.correct();
        this.score+=150; this.tasksDone++;
        this.showNotif(`✓ ${t.label} secured! +150`,true);
        this.updateHUD();
        acted=true;
        // Check if all tasks done
        if(this.tasks.every(tt=>tt.done)){
          this.allTasksDone=true;
          this.showBig('✅ All secured!\nNow get to the SAFE ROOM!','#00ff88');
          this.score+=200;
          this.statusTxt.setText('🏠 All tasks done! Get to the SAFE ROOM in the center!').setColor('#00ff88');
        }
      }
    });
    if(!acted) this.showNotif('Nothing to interact with here',false);
  }

  // ── CHECK SAFE ROOM ──────────────────────────────────────────────────────
  checkSafeRoom(){
    if(!this.allTasksDone || this.inSafeRoom) return false;
    const sr=this.safeRoomZone;
    return this.player.x>sr.x-sr.w/2 && this.player.x<sr.x+sr.w/2 &&
           this.player.y>sr.y-sr.h/2 && this.player.y<sr.y+sr.h+20;
  }

  // ── END GAME ─────────────────────────────────────────────────────────────
  endGame(won, reason=''){
    if(this.gameOver) return;
    this.gameOver=true;
    this.timerEvent.remove();
    this.cameras.main.resetFX();
    if(won){
      SFX.teleport();
      [500,600,700,900].forEach((f,i)=>SFX.note(f,0.3,'sine',0.15,i*0.1));
      this.showBig('🏆 SAFE!\nYou survived the cyclone!','#ffd700');
    } else {
      SFX.wrong(); this.cameras.main.flash(500,180,0,220);
      this.player.kill();
      this.showBig(`💀 GAME OVER\n${reason}`,'#ff4444');
    }
    const timeBonus=won?this.timeLeft*4:0;
    const survBonus=won?300:0;
    const final=this.score+timeBonus+survBonus;
    this.cameras.main.fade(800,0,0,0);
    this.time.delayedCall(800,()=>{
      if(won){
        // Level 2 — outdoor rescue mission, carry score forward
        this.scene.start('CycloneRescue',{cycloneScore:final});
      } else {
        this.scene.start('Score',{
          score:final,timeBonus,survBonus,
          location:'cyclone_house',raw:this.score,
          died:true,reason,gameType:'cyclone'
        });
      }
    });
  }

  // ── UPDATE ───────────────────────────────────────────────────────────────
  update(){
    if(this.gameOver) return;

    this.player.update(16.6);

    // Animate wind sprites — drift left
    if(this.windGfxSprites) this.windGfxSprites.forEach((w,i)=>{
      w.x-=1.5+this.windStrength*0.04;
      if(w.x<-40) w.x=W+40;
      w.y+=Math.sin(Date.now()*0.002+i)*0.3;
      w.setAlpha(0.2+this.windStrength/200);
    });

    // Proximity hints
    let nearTask=null;
    this.tasks.forEach(t=>{
      if(t.done) return;
      if(Phaser.Math.Distance.Between(this.player.x,this.player.y,t.x,t.y)<70) nearTask=t;
    });

    // Safe room hint
    let inSafeZone=this.checkSafeRoom();
    if(inSafeZone){
      this.hintTxt.setText('[ E ] HIDE IN SAFE ROOM!').setVisible(true);
    } else if(nearTask){
      const icon={window:'🪟',door:'🚪',elec:'⚡',gas:'🔴'}[nearTask.type]||'🔧';
      this.hintTxt.setText(`[ E ] Close ${nearTask.label} ${icon}`).setVisible(true);
    } else {
      this.hintTxt.setVisible(false);
    }

    // E key
    if(Phaser.Input.Keyboard.JustDown(this.interactKey)||window._mAction){
      window._mAction=false;
      if(inSafeZone && this.allTasksDone) this.endGame(true);
      else this.tryInteract();
    }

    // Status
    const done=this.tasks.filter(t=>t.done).length;
    if(!this.allTasksDone){
      if(done===0) this.statusTxt.setText('🌀 Close windows, doors, then shut off electricity & gas!').setColor('#aa88cc');
      else this.statusTxt.setText(`🌀 ${this.tasks.length-done} tasks remaining — wind is picking up!`).setColor('#ff9944');
    }
  }
}
// ── END OF CycloneScene ─────────────────────────────────────────────────────

// ═════════════════════════════════════════════════════════════════════════════
// ████████████████  CYCLONE LEVEL 2 — RESCUE MISSION  ████████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  CycloneRescueScene — fun outdoor rescue platformer
//
//  CONCEPT: The cyclone is at peak strength. You're outside.
//  Rescue 4 survivors scattered across a damaged street, then
//  bring them all to the community shelter before debris kills you.
//
//  MECHANICS:
//    - Run/jump across broken platforms (fallen trees, rubble piles)
//    - Press E near a survivor to "carry" them (they follow you)
//    - Carrying slows speed by 30%
//    - Wind GUSTS push you sideways every few seconds — time jumps carefully
//    - Flying debris rains from sky — dodge or take damage (3 lives)
//    - Reach the SHELTER with all 4 survivors to win
//    - Survivors left behind = score penalty
//    - Reach shelter with <4 survivors = partial win
//
//  SCORING:
//    +300 per survivor delivered
//    +timeLeft * 5  speed bonus
//    cycloneScore carried from Level 1
// ═════════════════════════════════════════════════════════════════════════════
class CycloneRescueScene extends Phaser.Scene {
  constructor(){ super('CycloneRescue'); }
  init(data){ this.cycloneScore = data.cycloneScore || 0; }

  create(){
    this.score       = 0;
    this.lives       = 3;
    this.timeLeft    = 100;
    this.gameOver    = false;
    this.carrying    = 0;      // how many survivors currently following
    this.delivered   = 0;      // survivors safely in shelter
    this.survivors   = [];     // {sprite, x, y, rescued, following, frameTimer, frame}
    this.debrisPool  = [];
    this.gustActive  = false;
    this.gustDir     = 0;
    this.windFrame   = 0;
    this._hitCooldown= false;
    this.windSprites = [];

    const FY=H-80;
    this.FLOOR_Y=FY;

    this.buildStreet(FY);

    // Player starts left side
    this.player=new Player(this,60,FY-20,{
      speed:150, jumpForce:-400, canCrouch:false, canJump:true, gravity:650
    });
    this.player.addCollider(this.groundGroup);
    this.player.addCollider(this.platformGroup);

    this.interactKey=this.input.keyboard.addKey(Phaser.Input.Keyboard.KeyCodes.E);

    this.buildHUD();
    this.startGustCycle();
    this.startDebrisRain();

    // Wind frame anim
    this.time.addEvent({delay:120,repeat:-1,callback:()=>{
      this.windFrame=(this.windFrame+1)%4;
      this.windSprites.forEach(w=>w.setTexture(`wind_${this.windFrame}`));
    }});

    // Countdown
    this.timerEvent=this.time.addEvent({delay:1000,repeat:99,callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.updateHUD();
      if(this.timeLeft<=0) this.endLevel(false,'Time ran out!');
    }});

    // Survivor arm wave anim
    this.time.addEvent({delay:400,repeat:-1,callback:()=>{
      this.survivors.forEach(s=>{
        if(!s.rescued){
          s.frame=(s.frame+1)%2;
          s.sprite.setTexture(`survivor_${s.frame}`);
        }
      });
    }});

    this.phaseTxt=this.add.text(W/2,H/2-20,'',{
      fontFamily:'monospace',fontSize:24,fontStyle:'bold',
      fill:'#aa44ff',stroke:'#000',strokeThickness:4,align:'center'
    }).setOrigin(0.5).setDepth(70).setVisible(false);

    this.notifTxt=this.add.text(W/2,H-132,'',{
      fontFamily:'monospace',fontSize:13,fontStyle:'bold',
      fill:'#ffdd44',backgroundColor:'rgba(0,0,0,0.88)',padding:{x:12,y:6}
    }).setOrigin(0.5).setDepth(60).setVisible(false);

    this.hintTxt=this.add.text(W/2,H-60,'',{
      fontFamily:'monospace',fontSize:13,fontStyle:'bold',
      fill:'#ffd700',backgroundColor:'rgba(0,0,0,0.8)',padding:{x:8,y:4}
    }).setOrigin(0.5).setScrollFactor(0).setDepth(55).setVisible(false);

    setupMobile(this);
    this.showBig('🌀 LEVEL 2: RESCUE MISSION!\nFind survivors & reach the SHELTER!','#aa44ff');
  }

  // ── BUILD STREET ──────────────────────────────────────────────────────────
  buildStreet(FY){
    // Dark stormy sky
    const bg=this.add.graphics();
    bg.fillGradientStyle(0x0a0020,0x0a0020,0x220044,0x110030,1);
    bg.fillRect(0,0,W,H);

    // Storm cloud shapes
    [80,250,450,650].forEach(cx=>{
      bg.fillStyle(0x2a2a44,0.7); bg.fillEllipse(cx,30,160,50);
      bg.fillStyle(0x1a1a33,0.5); bg.fillEllipse(cx+30,20,100,35);
    });

    // Ground
    const gnd=this.add.graphics();
    gnd.fillStyle(0x3a3030,1); gnd.fillRect(0,FY,W,H-FY+32);
    gnd.fillStyle(0x2a2020,0.6); gnd.fillRect(0,FY,W,6);

    // Ground cracks
    [[60,FY+2],[200,FY+2],[380,FY+2],[560,FY+2],[700,FY+2]].forEach(([x,y])=>{
      gnd.lineStyle(2,0x111111,0.8);
      gnd.lineBetween(x,y,x+40,y+4); gnd.lineBetween(x+10,y,x+15,y+10);
    });

    // Destroyed buildings in background (silhouette)
    [[40,FY-120,60],[140,FY-90,50],[580,FY-110,55],[700,FY-80,45]].forEach(([bx,by,bw])=>{
      bg.fillStyle(0x1a1030,0.8); bg.fillRect(bx,by,bw,FY-by);
      // Broken tops
      bg.fillStyle(0x0a0820,0.9);
      bg.fillTriangle(bx,by, bx+bw/2,by-20, bx+bw,by+10);
    });

    // Physics floor
    this.groundGroup=this.physics.add.staticGroup();
    const fb=this.add.rectangle(W/2,FY+16,W,32,0,0);
    this.physics.add.existing(fb,true); this.groundGroup.add(fb);
    this.platformGroup=this.physics.add.staticGroup();

    // ── PLATFORMS (debris, rubble piles, fallen trees) ──
    const platDefs=[
      {x:180,  y:FY-55, w:90,  h:18, color:0x8b5e3c, label:'fallen tree'},
      {x:360,  y:FY-45, w:70,  h:14, color:0x706060, label:'rubble'},
      {x:510,  y:FY-65, w:100, h:18, color:0x7a5a3a, label:'roof piece'},
      {x:660,  y:FY-40, w:80,  h:14, color:0x808080, label:'concrete'},
    ];
    platDefs.forEach(pd=>{
      // Visual
      const pv=this.add.rectangle(pd.x,pd.y,pd.w,pd.h,pd.color,0.95).setOrigin(0.5,1).setDepth(4);
      this.add.rectangle(pd.x,pd.y-pd.h/2,pd.w-4,pd.h-4,0x000000,0.15).setOrigin(0.5).setDepth(5);
      // Physics
      const pb=this.add.rectangle(pd.x,pd.y-pd.h/2,pd.w,pd.h/2,0,0).setOrigin(0.5);
      this.physics.add.existing(pb,true); this.platformGroup.add(pb);
      // Label
      this.add.text(pd.x,pd.y-pd.h-4,pd.label,{fontFamily:'monospace',fontSize:7,fill:'#888866'}).setOrigin(0.5,1).setDepth(6);
    });

    // ── SHELTER on far right ──
    const shX=W-80, shY=FY;
    this.add.image(shX,shY,'shelter').setOrigin(0.5,1).setDisplaySize(128,112).setDepth(4);
    // Entry glow
    const sg=this.add.rectangle(shX,shY-20,60,40,0x00ff88,0.15).setDepth(3);
    this.tweens.add({targets:sg,alpha:{from:0.1,to:0.3},duration:800,yoyo:true,repeat:-1});
    this.shelterZone={x:shX,y:shY-20,w:70,h:50};
    this.add.text(shX,shY-118,'🏠 SHELTER',{fontFamily:'monospace',fontSize:10,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5).setDepth(6);

    // Wind stream decorations
    for(let i=0;i<10;i++){
      const ws=this.add.image(Phaser.Math.Between(0,W),Phaser.Math.Between(30,FY-40),'wind_0')
        .setDisplaySize(72,32).setAlpha(0.35).setDepth(8);
      this.windSprites.push(ws);
    }

    // ── SPAWN SURVIVORS ──
    const survivorPositions=[
      {x:140, y:FY-20},
      {x:290, y:FY-80},   // on first platform
      {x:520, y:FY-88},   // on roof piece platform
      {x:650, y:FY-20},
    ];
    survivorPositions.forEach((sp2,i)=>{
      const glow=this.add.ellipse(sp2.x,sp2.y,36,18,0xffdd44,0.4).setDepth(5);
      this.tweens.add({targets:glow,scaleX:{from:0.8,to:1.2},alpha:{from:0.2,to:0.5},duration:600,yoyo:true,repeat:-1,delay:i*150});
      const spr=this.add.image(sp2.x,sp2.y,'survivor_0').setOrigin(0.5,1).setDisplaySize(36,48).setDepth(7);
      this.add.text(sp2.x,sp2.y-56,'HELP!',{fontFamily:'monospace',fontSize:8,fontStyle:'bold',fill:'#ffdd44',backgroundColor:'rgba(0,0,0,0.7)',padding:{x:3,y:1}}).setOrigin(0.5).setDepth(8);
      this.survivors.push({sprite:spr,glow,x:sp2.x,y:sp2.y,rescued:false,following:false,frame:0,idx:i});
    });
  }

  // ── HUD ──────────────────────────────────────────────────────────────────
  buildHUD(){
    const h=this.add.graphics().setScrollFactor(0).setDepth(40);
    h.fillStyle(0x000000,0.78); h.fillRect(0,0,W,44);

    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 1:40',{fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#aa44ff'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);

    // Lives
    this.livesTxt=this.add.text(W-14,10,'❤❤❤',{fontFamily:'monospace',fontSize:14}).setOrigin(1,0).setScrollFactor(0).setDepth(41);

    // Survivors counter
    this.survivorsTxt=this.add.text(14,46,'🧑 Following: 0   🏠 Delivered: 0/4',{fontFamily:'monospace',fontSize:11,fill:'#ffcc88'}).setScrollFactor(0).setDepth(41);

    // Wind bar
    const wb=this.add.graphics().setScrollFactor(0).setDepth(40);
    wb.fillStyle(0x222244,1); wb.fillRect(W/2-80,46,160,10);
    this.gustBar=this.add.graphics().setScrollFactor(0).setDepth(41);

    // Status
    const sb=this.add.graphics().setScrollFactor(0).setDepth(40);
    sb.fillStyle(0x000000,0.65); sb.fillRect(0,H-22,W,22);
    this.statusTxt=this.add.text(W/2,H-11,'🌀 Find survivors and bring them to the SHELTER →',{fontFamily:'monospace',fontSize:11,fill:'#bb88dd'}).setOrigin(0.5).setScrollFactor(0).setDepth(41);
  }

  updateHUD(){
    const m=Math.floor(this.timeLeft/60),s=this.timeLeft%60;
    this.timerTxt.setText(`⏱ ${m}:${s.toString().padStart(2,'0')}`);
    if(this.timeLeft<=15) this.timerTxt.setColor('#ff4444');
    else if(this.timeLeft<=30) this.timerTxt.setColor('#ffaa00');
    this.scoreTxt.setText(`⭐ ${this.score}`);
    this.livesTxt.setText('❤'.repeat(this.lives)+'🖤'.repeat(Math.max(0,3-this.lives)));
    this.survivorsTxt.setText(`🧑 Following: ${this.carrying}   🏠 Delivered: ${this.delivered}/4`);
  }

  showNotif(msg,ok=true){
    this.notifTxt.setText(msg).setColor(ok?'#00ff88':'#ff6666').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifTxt);
    this.tweens.add({targets:this.notifTxt,alpha:0,duration:300,delay:2200,onComplete:()=>this.notifTxt.setVisible(false).setAlpha(1)});
  }

  showBig(msg,color='#aa44ff'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.5);
    this.tweens.add({targets:this.phaseTxt,scaleX:1,scaleY:1,duration:300,ease:'Back.Out'});
    this.time.delayedCall(2600,()=>this.tweens.add({targets:this.phaseTxt,alpha:0,duration:400,onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}));
  }

  // ── GUST CYCLE ───────────────────────────────────────────────────────────
  startGustCycle(){
    this.time.addEvent({delay:Phaser.Math.Between(5000,8000),callback:()=>{
      if(this.gameOver) return;
      this.triggerGust();
    },loop:false});
  }

  triggerGust(){
    if(this.gameOver) return;
    this.gustActive=true;
    this.gustDir=Math.random()<0.5?-1:1;
    const gustForce=180+Math.random()*80;

    // Visual: flash gust lines across screen
    const gustOverlay=this.add.graphics().setDepth(25).setScrollFactor(0);
    gustOverlay.fillStyle(0xaaccff,0.18); gustOverlay.fillRect(0,0,W,H);
    this.time.delayedCall(300,()=>gustOverlay.destroy());

    // Show gust warning
    this.showNotif(`💨 WIND GUST ${this.gustDir>0?'→':'←'} — brace yourself!`,false);
    SFX.note(200,0.4,'sine',0.15);

    // Apply force to player
    if(this.player&&!this.player.gameOver){
      this.player.sprite.setVelocityX(this.gustDir*gustForce);
    }

    // Gust lasts 1.5s then fades
    this.time.delayedCall(1500,()=>{
      this.gustActive=false;
      // Schedule next gust
      this.time.delayedCall(Phaser.Math.Between(4000,7000),()=>{ if(!this.gameOver) this.triggerGust(); });
    });
  }

  // ── DEBRIS RAIN ──────────────────────────────────────────────────────────
  startDebrisRain(){
    this.time.addEvent({delay:1200,repeat:-1,callback:()=>{
      if(this.gameOver) return;
      this.spawnFlyingDebris();
    }});
  }

  spawnFlyingDebris(){
    const x=Phaser.Math.Between(30,W-30);
    const type=Phaser.Math.Between(0,3);
    const d=this.physics.add.image(x,-10,`debris_fly_${type}`)
      .setDisplaySize(28,28).setDepth(9);
    d.setVelocityY(Phaser.Math.Between(120,260));
    d.setVelocityX(Phaser.Math.Between(-120,120));
    d.setAngularVelocity(Phaser.Math.Between(-200,200));

    // Check player hit
    this.physics.add.overlap(d,this.player.sprite,()=>{
      if(d._hit) return; d._hit=true; d.destroy();
      this.hitPlayer();
    });

    // Bounce on ground
    this.physics.add.collider(d,this.groundGroup,()=>{
      d.setVelocityX(d.body.velocity.x*0.5);
      d.setVelocityY(-Phaser.Math.Between(20,80));
      this.time.delayedCall(2000,()=>{ if(d.active) d.destroy(); });
    });
  }

  hitPlayer(){
    if(this._hitCooldown||this.gameOver) return;
    this._hitCooldown=true;
    this.lives=Math.max(0,this.lives-1);
    this.updateHUD();
    this.cameras.main.flash(200,255,100,100);
    SFX.wrong();
    // Drop all following survivors
    if(this.carrying>0){
      this.showNotif('💥 Hit! Dropped survivors!',false);
      this.survivors.forEach(s=>{ if(s.following){ s.following=false; } });
      this.carrying=0;
      this.updateHUD();
    } else {
      this.showNotif('💥 Hit by debris!',false);
    }
    this.time.delayedCall(1500,()=>this._hitCooldown=false);
    if(this.lives<=0) this.endLevel(false,'Overcome by storm!');
  }

  // ── INTERACT (E) ─────────────────────────────────────────────────────────
  tryInteract(){
    if(this.gameOver) return;
    // Check shelter first
    const sh=this.shelterZone;
    if(this.player.x>sh.x-sh.w/2&&this.player.x<sh.x+sh.w/2&&
       this.player.y>sh.y-sh.h/2&&this.player.y<sh.y+sh.h+10){
      this.deliverSurvivors();
      return;
    }
    // Check survivors to rescue
    let rescued=false;
    this.survivors.forEach(s=>{
      if(s.rescued||s.following) return;
      const d=Phaser.Math.Distance.Between(this.player.x,this.player.y,s.x,s.y);
      if(d<60){
        s.following=true;
        this.carrying++;
        SFX.correct();
        this.showNotif(`🧑 Survivor rescued! (${this.carrying} following)`,true);
        this.updateHUD();
        rescued=true;
      }
    });
    if(!rescued&&this.carrying===0) this.showNotif('Nothing nearby — find survivors!',false);
  }

  deliverSurvivors(){
    if(this.carrying===0){ this.showNotif('Bring survivors here first!',false); return; }
    const count=this.carrying;
    this.survivors.filter(s=>s.following).forEach(s=>{
      s.rescued=true; s.following=false;
      s.sprite.setTexture('survivor_0').setTint(0x00ff88);
      s.glow.setVisible(false);
      this.tweens.add({targets:s.sprite,x:this.shelterZone.x+Phaser.Math.Between(-20,20),duration:400});
      this.delivered++;
    });
    this.carrying=0;
    this.score+=count*300;
    SFX.correct(); SFX.correct();
    this.showNotif(`🏠 ${count} survivor${count>1?'s':''} delivered! +${count*300}`,true);
    this.updateHUD();

    if(this.delivered>=4){
      this.time.delayedCall(600,()=>this.endLevel(true));
    } else {
      const left=4-this.delivered;
      this.statusTxt.setText(`${left} survivor${left>1?'s':''} still out there — go get them!`).setColor('#ffaa44');
      this.showBig(`${this.delivered}/4 delivered!\nKeep going!`,'#ffd700');
    }
  }

  // ── END LEVEL ─────────────────────────────────────────────────────────────
  endLevel(won, reason=''){
    if(this.gameOver) return;
    this.gameOver=true;
    this.timerEvent.remove();
    this.cameras.main.resetFX();

    const rescueScore=this.score;
    const timeBonus=won?this.timeLeft*5:Math.floor(this.delivered*50);
    const combined=this.cycloneScore+rescueScore+timeBonus;

    if(won){
      SFX.teleport();
      [500,650,800,1000,1200].forEach((f,i)=>SFX.note(f,0.3,'sine',0.18,i*0.1));
      this.showBig('🏆 ALL RESCUED!\nBoth levels cleared!','#ffd700');
    } else {
      SFX.wrong();
      this.cameras.main.flash(500,150,0,200);
      this.player.kill();
      const partial=this.delivered>0?` (${this.delivered} delivered)`:'';
      this.showBig(`💀 GAME OVER${partial}\n${reason}`,'#ff4444');
    }

    this.cameras.main.fade(900,0,0,0);
    this.time.delayedCall(900,()=>{
      this.scene.start('Score',{
        score:combined,
        timeBonus,
        survBonus:this.cycloneScore,
        location:'cyclone_rescue',
        raw:rescueScore,
        died:!won,
        reason:won?'all rescued':reason,
        gameType:'cyclone_full',
        cycloneScore:this.cycloneScore,
        rescueScore,
        delivered:this.delivered,
      });
    });
  }

  // ── UPDATE ────────────────────────────────────────────────────────────────
  update(){
    if(this.gameOver) return;

    this.player.update(16.6);

    // Followers trail player
    let offsetIdx=0;
    this.survivors.filter(s=>s.following).forEach((s,i)=>{
      const tx=this.player.x+(this.player.facingLeft?1:-1)*(30+i*22);
      const ty=this.player.y;
      s.sprite.x+=(tx-s.sprite.x)*0.18;
      s.sprite.y+=(ty-s.sprite.y)*0.18;
      s.x=s.sprite.x; s.y=s.sprite.y;
    });

    // Slow player if carrying survivors
    if(this.carrying>0 && this.player.sprite.body){
      const vx=this.player.sprite.body.velocity.x;
      if(Math.abs(vx)>90) this.player.sprite.setVelocityX(vx*0.6);
    }

    // Drift wind sprites
    this.windSprites.forEach((w,i)=>{
      w.x-=2.5+i*0.2;
      if(w.x<-80) w.x=W+80;
    });

    // Gust bar visual
    this.gustBar.clear();
    if(this.gustActive){
      this.gustBar.fillStyle(0xaa44ff,0.7);
      this.gustBar.fillRect(W/2-80,46,160,10);
      this.statusTxt.setText('💨 WIND GUST! Hold your ground!').setColor('#ff6666');
    } else {
      this.gustBar.fillStyle(0x4422aa,0.4);
      this.gustBar.fillRect(W/2-80,46,160,10);
    }

    // Interaction hint
    let hint='';
    const sh=this.shelterZone;
    const nearShelter=this.player.x>sh.x-sh.w/2&&this.player.x<sh.x+sh.w/2&&
                      this.player.y>sh.y-sh.h/2&&this.player.y<sh.y+sh.h+10;
    if(nearShelter&&this.carrying>0){
      hint=`[ E ] Deliver ${this.carrying} survivor${this.carrying>1?'s':''}!`;
    } else if(!nearShelter){
      const ns=this.survivors.find(s=>!s.rescued&&!s.following&&
        Phaser.Math.Distance.Between(this.player.x,this.player.y,s.x,s.y)<65);
      if(ns) hint='[ E ] Rescue survivor!';
    }
    this.hintTxt.setText(hint).setVisible(hint!=='');

    if(Phaser.Input.Keyboard.JustDown(this.interactKey)||window._mAction){
      window._mAction=false; this.tryInteract();
    }
  }
}
// ── END OF CycloneRescueScene ────────────────────────────────────────────────

