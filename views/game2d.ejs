    const btn=this.add.text(cx,386,'▶ START DRILL!',{fontFamily:'monospace',fontSize:20,fontStyle:'bold',fill:'#000'}).setOrigin(0.5).setInteractive({useHandCursor:true});
    btn.on('pointerdown',()=>{
      SFX.alert();
