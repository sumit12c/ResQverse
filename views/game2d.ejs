  // Electricity switch (20×24)
  drawElecSwitch(ctx, closed=true){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<12;y++) for(let x=0;x<10;x++) px(x,y,'#e0e0e0');
    for(let x=0;x<10;x++){ px(x,0,'#888'); px(x,11,'#888'); }
    for(let y=0;y<12;y++){ px(0,y,'#888'); px(9,y,'#888'); }
    // Switch lever
    for(let y=2;y<10;y++) px(closed?3:6,y,'#ff0000');
    if(!closed) for(let y=2;y<10;y++) px(3,y,'#00aa00');
    px(4,1,'#ffff00'); px(5,1,'#ffff00');
  },

  // Safe room (concrete, small window) 80×48
  drawSafeRoom(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<24;y++) for(let x=0;x<40;x++){
      const noise=(x*3+y*7)%5===0;
      px(x,y,noise?'#888888':'#aaaaaa');
    }
    // Thick concrete border
    for(let x=0;x<40;x++){ px(x,0,'#666'); px(x,1,'#666'); px(x,22,'#666'); px(x,23,'#666'); }
    for(let y=0;y<24;y++){ px(0,y,'#666'); px(1,y,'#666'); px(38,y,'#666'); px(39,y,'#666'); }
    // Small window (reinforced)
    for(let y=4;y<10;y++) for(let x=14;x<22;x++) px(x,y,'#aaccff');
    for(let x=14;x<22;x++){ px(x,4,'#444'); px(x,9,'#444'); }
    for(let y=4;y<10;y++){ px(14,y,'#444'); px(21,y,'#444'); }
    // Grid bars on window
    px(17,4,'#444'); for(let y=4;y<10;y++) px(17,y,'#444');
    for(let x=14;x<22;x++) px(x,7,'#444');
    // Door
    for(let y=14;y<24;y++) for(let x=16;x<24;x++) px(x,y,'#555');
    px(23,19,'#ffd700');
    // SAFE ROOM label
    ctx.fillStyle='#00ff88'; ctx.font='bold 10px monospace'; ctx.textAlign='center';
