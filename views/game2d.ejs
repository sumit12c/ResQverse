// SCENE 1 — BOOT
// ─────────────────────────────────────────────────────────────────────────────
class BootScene extends Phaser.Scene {
  constructor(){ super('Boot'); }
  create(){
    // Generate ALL textures here once
    const mk=(key,w,h,fn)=>makeTex(this,key,w,h,fn);

    // Player poses — walk0..walk7, idle0, idle1, jump, crouch
    const poses=['idle0','idle1','walk0','walk1','walk2','walk3','walk4','walk5','walk6','walk7','jump','crouch'];
    poses.forEach(pose=>{
      mk(`player_${pose}`, 48, 80, ctx=>GFX.drawPlayer(ctx, pose));
    });

    // Tiles
    mk('tile_stone',32,32,ctx=>GFX.drawFloor(ctx,'stone'));
    mk('tile_wood',32,32,ctx=>GFX.drawFloor(ctx,'wood'));
    mk('tile_grass',32,32,ctx=>GFX.drawFloor(ctx,'grass'));
    mk('tile_marble',32,32,ctx=>GFX.drawFloor(ctx,'marble'));
