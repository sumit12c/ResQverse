  }
}

// ─────────────────────────────────────────────────────────────────────────────
// SCENE 5 — EARTHQUAKE GAME  (reworked mechanics)
// ═════════════════════════════════════════════════════════════════════════════
// ██████████████████████  EARTHQUAKE GAME CODE STARTS HERE  ██████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  EarthquakeScene — the core gameplay scene
//
//  FLOW:
//    Phase 0 – PRE       (~3 s)  : player freely explores room, warning rumble
//    Phase 1 – QUAKE     (~10 s) : screen shakes, debris falls from ceiling;
//                                  player must press S to crouch under a desk/table;
//                                  if debris hits player while NOT under cover → GAME OVER
//    Phase 2 – AFTERMATH         : quake stops, EXIT door unlocks & glows green;
//                                  player walks to the EXIT door on the right wall to win
//
//  SCORING:
//    +600   took cover under a desk/table during quake
//    +400   survived the full quake with no debris hit
//    + timeLeft × 3   time bonus for reaching exit quickly
//    Grade  ≥ 1400 → Expert  |  ≥ 900 → Great  |  else → Keep Practicing
//
//  KEY METHODS:
//    create()              — initialises state, builds room, spawns player, starts timer
//    buildRoom()           — floor/wall/ceiling tiles + calls location decorator
//    decorSchool/House/    — location-specific furniture + cover zones
//      Office/Theatre()
//    addCoverZone()        — registers a safe-crouch rectangle (green glow indicator)
//    buildHUD()            — score, timer, status strip, alert banner
//    startQuakePhase()     — triggers camera shake, debris wave, alert banner
//    spawnDebris()         — physics debris falling from ceiling; overlap kills player
//    startAftermathPhase() — stops quake, awards bonuses, opens exit door
//    buildExitDoor()       — creates the locked EXIT door on the right wall
//    openExitDoor()        — unlocks & animates EXIT door after quake ends
//    triggerGameOver()     — red flash, player death anim, → Score screen (died:true)
//    reachExit()           — player touched open exit → → Score screen (died:false)
//    update()              — movement (A/D), jump (W), crouch (S), anim, cover check
// ═════════════════════════════════════════════════════════════════════════════
/*
  FLOW:
  Phase 0 – PRE  (~3 s): player can explore, rumble warning builds
  Phase 1 – QUAKE (~10 s): debris falls; player must S-crouch under a desk/table;
                            if hit by debris while NOT crouching under cover → GAME OVER
  Phase 2 – AFTERMATH: quake stops; EXIT door opens; player must walk to exit
  Scoring:
    +600  crouched in time (under desk/table when debris wave starts)
    +400  no debris hit during quake
    +timeLeft*3  time bonus on reaching exit
    Grade thresholds: ≥1400 Expert, ≥900 Good, else Needs Work
*/
class EarthquakeScene extends Phaser.Scene {
  constructor(){ super('Earthquake'); }
  init(data){ this.location=data.location||'school'; }

  // ── EARTHQUAKE: create() ─────────────────────────────────────────────────
  // Called once when the scene starts. Sets up all state variables,
  // builds the room, spawns the player, wires input, starts the countdown,
  // and schedules the single earthquake trigger after 3 seconds.
  create(){
    // ── STATE ──
    this.score=0;
    this.timeLeft=120;
    this.phase='pre';          // pre | quake | aftermath | done
    this.isCrouching=false;
    this.isUnderCover=false;   // true when crouching AND inside a cover zone
    this.debrisHit=false;
    this.coverBonus=true;      // will award cover bonus if player was safe during quake
    this.gameOver=false;

    // physics groups
    this.floorGroup=null;
    this.platformGroup=null;
    this.debrisList=[];
    this.coverZones=[];        // managed by Player instance via player.addCoverZone()
    this.exitDoor=null;
    this.exitOpen=false;

    const theme=LOC_THEMES[this.location];
    const FLOOR_Y=H-80;
    this.FLOOR_Y=FLOOR_Y;

    // ── BUILD ROOM (must happen before Player so floorGroup exists) ──
    this.buildRoom(theme, FLOOR_Y);

    // ── PLAYER (OOP Player class — canCrouch:true for earthquake game) ──
    // All movement, jump, crouch, cover detection and animation are
    // handled inside the Player class. This scene just calls player.update().
    this.player = new Player(this, 80, FLOOR_Y-20, {
      speed: 145, jumpForce: -430, canCrouch: true, gravity: 600
    });
    this.player.addCollider(this.floorGroup);
    this.player.addCollider(this.platformGroup);

    // Forward cover zones collected during buildRoom() to the Player instance
    // (buildRoom runs before Player exists, so zones were buffered in this.coverZones)
    this.coverZones.forEach(cz => this.player.addCoverZone(cz.x, cz.y, cz.w, cz.h));

    // ── E / INTERACT key (scene-level only, not part of Player movement) ──
    this.interactKey=this.input.keyboard.addKey(Phaser.Input.Keyboard.KeyCodes.E);

    // ── HUD ──
    this.buildHUD();

    // ── NOTIFICATION TEXT ──
    this.notifText=this.add.text(W/2,H-130,'',{
      fontFamily:'monospace',fontSize:14,fontStyle:'bold',
      fill:'#00ff88',backgroundColor:'rgba(0,0,0,0.88)',
      padding:{x:12,y:6},align:'center'
    }).setOrigin(0.5).setDepth(60).setVisible(false);

    // ── PHASE LABEL (big center alerts) ──
    this.phaseTxt=this.add.text(W/2,H/2-20,'',{
      fontFamily:'monospace',fontSize:28,fontStyle:'bold',
      fill:'#ffffff',stroke:'#000000',strokeThickness:4,align:'center'
    }).setOrigin(0.5).setDepth(65).setVisible(false);

    this.frameTimer=0; // kept for legacy; animation now lives in Player class

    // ── COUNTDOWN ──
    this.timerEvent=this.time.addEvent({delay:1000,repeat:119,callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.updateHUD();
      if(this.timeLeft<=0) this.triggerGameOver('Time ran out!',false);
    }});

    // ── PRE-QUAKE RUMBLE (3 s then quake) ──
    this.time.delayedCall(3000,()=>this.startQuakePhase());

    // mobile
    setupMobile(this);

    // update mobile button labels for this scene
    const mJump=document.getElementById('mJump');
    const mAction=document.getElementById('mAction');
    const mSprint=document.getElementById('mSprint');
    if(mJump) mJump.textContent='W/↑';
    if(mAction) mAction.textContent='E';
    if(mSprint) mSprint.textContent='S↓';
  }

  // ─── ROOM BUILD ───────────────────────────────────────────────────────────
  // ── EARTHQUAKE: buildRoom() ──────────────────────────────────────────────
  // Lays down floor/wall/ceiling tiles using the location theme,
  // creates the physics floor collider, calls the correct location
  // decorator (school/house/office/theatre), then builds the exit door.
  buildRoom(theme, FY){
    const bg=this.add.graphics();
    bg.fillStyle(Phaser.Display.Color.HexStringToColor(theme.sky).color,1);
    bg.fillRect(0,0,W,FY);

    for(let y=0;y<FY;y+=32){
      this.add.image(0,y,'wall_'+theme.wall).setOrigin(0,0).setDisplaySize(40,32).setAlpha(0.7);
      this.add.image(W-40,y,'wall_'+theme.wall).setOrigin(0,0).setDisplaySize(40,32).setAlpha(0.7).setFlipX(true);
    }
    for(let x=0;x<W;x+=32){
      this.add.image(x,FY,'tile_'+theme.floor).setOrigin(0,0).setDisplaySize(32,32);
      this.add.image(x,FY+32,'tile_'+theme.floor).setOrigin(0,0).setDisplaySize(32,32).setAlpha(0.5);
      this.add.image(x,0,'ceiling_'+(this.location==='theatre'?'dark':'light')).setOrigin(0,0).setDisplaySize(32,24);
    }

    this.floorGroup=this.physics.add.staticGroup();
    const fb=this.add.rectangle(W/2,FY+16,W,32,0,0);
    this.physics.add.existing(fb,true);
    this.floorGroup.add(fb);

    this.platformGroup=this.physics.add.staticGroup();

    if(this.location==='school')   this.decorSchool(FY);
    else if(this.location==='house')  this.decorHouse(FY);
    else if(this.location==='office') this.decorOffice(FY);
    else if(this.location==='theatre')this.decorTheatre(FY);

    // Ceiling lamps
    [W/4,W/2,W*3/4].forEach(lx=>{
      this.add.circle(lx,20,8,0xffffaa,0.9);
      this.add.ellipse(lx,50,80,40,0xffffaa,0.1);
    });

    // ── EXIT DOOR (locked until aftermath) ──
    this.buildExitDoor(FY);
  }

  // ── EARTHQUAKE: buildExitDoor() ──────────────────────────────────────────
  // Draws the locked EXIT door on the far-right wall. Stays dark/locked
  // until startAftermathPhase() calls openExitDoor().
  buildExitDoor(FY){
    // Place exit door on the RIGHT side wall
    const ex=W-50, ey=FY-60;
    // Frame
    const frame=this.add.graphics().setDepth(6);
    frame.lineStyle(4,0x555555); frame.strokeRect(ex-20,ey-60,40,80);
    frame.fillStyle(0x333333,1); frame.fillRect(ex-20,ey-60,40,80);
    // Sign above
    const signBg=this.add.graphics().setDepth(7);
    signBg.fillStyle(0x005500,1); signBg.fillRect(ex-24,ey-80,48,20);
    this.exitSignTxt=this.add.text(ex,ey-70,'EXIT',{fontFamily:'monospace',fontSize:10,fontStyle:'bold',fill:'#00ff00'}).setOrigin(0.5).setDepth(8).setAlpha(0.4);
    // Door fill (locked = dark)
    this.exitDoorFill=this.add.rectangle(ex,ey-20,36,76,0x222222,1).setDepth(7);
    // Lock icon
    this.lockIcon=this.add.text(ex,ey-20,'🔒',{fontSize:18}).setOrigin(0.5).setDepth(8);
    // Store position
    this.exitDoor={x:ex, y:ey-20, w:40, h:80};
  }

  // ── EARTHQUAKE: openExitDoor() ───────────────────────────────────────────
  // Called after the quake ends. Turns the door green, removes the lock
  // icon, pulses it, and shows a bouncing arrow hint pointing at the exit.
  openExitDoor(){
    this.exitOpen=true;
    this.exitDoorFill.setFillStyle(0x00ff88,0.7);
    this.lockIcon.setText('🚪');
    this.exitSignTxt.setAlpha(1);
    // Glow pulse
    this.tweens.add({targets:this.exitDoorFill,alpha:{from:0.5,to:1},duration:500,yoyo:true,repeat:-1});
    // Hint arrow
    this.exitArrow=this.add.text(W-50,this.FLOOR_Y-160,'⬇ EXIT',{
      fontFamily:'monospace',fontSize:13,fontStyle:'bold',fill:'#00ff88',
      backgroundColor:'rgba(0,0,0,0.7)',padding:{x:6,y:3}
    }).setOrigin(0.5).setDepth(20);
    this.tweens.add({targets:this.exitArrow,y:'+=8',duration:600,yoyo:true,repeat:-1});
  }

  // ── LOCATION DECOR (with cover zones registered) ───────────────────────────
  // ── EARTHQUAKE: addCoverZone(x, y, w, h) ─────────────────────────────────
  // Registers a rectangle as a valid "under cover" area (under desks/tables).
  // Stores locally first (buildRoom runs before Player is created),
  // then forwarded to the Player instance in create() after spawn.
  addCoverZone(x,y,w,h){
    // Guard: initialize if not yet set (safety for scene re-entry)
    if(!this.coverZones) this.coverZones=[];
    // Always push to local array (works even before Player is instantiated)
    this.coverZones.push({x,y,w,h});
    // Visual hint: faint green underlay
    const r=this.add.rectangle(x,y,w,h,0x00ff88,0.08).setDepth(3);
    this.tweens.add({targets:r,alpha:{from:0.05,to:0.18},duration:900,yoyo:true,repeat:-1});
    // "COVER" label
    this.add.text(x,y-h/2-8,'COVER',{fontFamily:'monospace',fontSize:8,fill:'#00ff88',alpha:0.7}).setOrigin(0.5).setDepth(4);
  }

  // ── EARTHQUAKE: decorSchool(FY) ──────────────────────────────────────────
  // Builds the school classroom: desk rows (cover zones underneath),
  // colored lockers, blackboard with "DROP COVER HOLD", wall posters.
  decorSchool(FY){
    const deskXs=[180,340,500,630];
    deskXs.forEach(dx=>{
      this.add.image(dx,FY-60,'desk').setOrigin(0.5,1).setDisplaySize(90,32);
      this.add.image(dx+35,FY-62,'chair').setOrigin(0.5,1).setDisplaySize(32,44);
      const p=this.add.rectangle(dx,FY-60,90,10,0,0);
      this.physics.add.existing(p,true); this.platformGroup.add(p);
      // Cover zone under desk (crouching here = safe)
      this.addCoverZone(dx,FY-30,80,40);
    });
    ['locker_r','locker_b','locker_g','locker_r'].forEach((l,i)=>{
      this.add.image(55+i*44,FY,''+l).setOrigin(0.5,1).setDisplaySize(38,80);
    });
    const bbg=this.add.graphics();
    bbg.fillStyle(0x1a4a1a,1); bbg.fillRect(230,50,300,120);
    bbg.lineStyle(3,0x8b6914); bbg.strokeRect(230,50,300,120);
    this.add.text(380,115,'DROP • COVER • HOLD',{fontFamily:'monospace',fontSize:16,fontStyle:'bold',fill:'#ffffff'}).setOrigin(0.5);
    [[0x3498db,50,70],[0xe74c3c,50,170],[0x00c0c0,710,70],[0xf39c12,710,170]].forEach(([c,x,y])=>{
      this.add.rectangle(x+20,y+25,38,56,c,0.9);
    });
  }

  // ── EARTHQUAKE: decorHouse(FY) ───────────────────────────────────────────
  // Builds the family home: raised dining table with legs (walk/crouch under),
  // sofa, TV on stand, bookshelf, windows with light shafts, plant.
  decorHouse(FY){
    // ── Dining table — raised with legs so player can walk/crouch under ──
    const tableX=320, tableTopY=FY-70;
    // Table top surface (visual)
    this.add.image(tableX, tableTopY, 'table').setOrigin(0.5,1).setDisplaySize(140,22);
    // Table legs (visual)
    [[tableX-60,FY],[tableX+60,FY]].forEach(([lx,ly])=>{
      this.add.rectangle(lx, ly, 8, 70, 0x8b6030, 1).setOrigin(0.5,1);
    });
    // Physics platform ON TOP of table so player can stand on it
    const tp=this.add.rectangle(tableX, tableTopY, 140, 10, 0x000000, 0);
    this.physics.add.existing(tp, true);
    this.platformGroup.add(tp);
    // Cover zone: wide & tall enough under the table for a crouching player
    // Player crouches to 28px tall, so zone needs to reach from floor up to table underside
    this.addCoverZone(tableX, FY-35, 120, 70);

    // ── Sofa ──
    this.add.image(520, FY, 'sofa').setOrigin(0.5,1).setDisplaySize(130,48);

    // ── TV on stand ──
    this.add.rectangle(680, FY, 50, 40, 0x5a3010, 1).setOrigin(0.5,1); // TV stand
    this.add.image(680, FY-40, 'tv').setOrigin(0.5,1).setDisplaySize(80,56);

    // ── Bookshelf ──
    this.add.image(100, FY, 'shelf').setOrigin(0.5,1).setDisplaySize(60,100);

    // ── Rug ──
    this.add.ellipse(390, FY-6, 300,22, 0xcc4444, 0.35);

    // ── Windows ──
    [[120,80],[560,80]].forEach(([x,y])=>{
      this.add.rectangle(x, y, 100, 80, 0x88ccff, 0.5);
      this.add.rectangle(x, y, 100, 80, 0x000000, 0).setStrokeStyle(4, 0x8b6914);
      this.add.line(x, y, 0,0, 0,80, 0x8b6914, 0.8);
      this.add.line(x, y, 0,40, 100,40, 0x8b6914, 0.8);
    });

    // ── Plant ──
    this.add.circle(700, FY-28, 20, 0x228822, 0.9);
    this.add.circle(700, FY-14, 8, 0x8b4513, 1);
  }

  // ── EARTHQUAKE: decorOffice(FY) ──────────────────────────────────────────
  // Builds the office floor: cubicle desks with monitors (cover zones),
  // office partitions, filing cabinets, colorful chairs.
  decorOffice(FY){
    [[130,FY-50],[290,FY-50],[450,FY-50],[600,FY-50]].forEach(([dx,dy])=>{
      this.add.image(dx,dy,'desk').setOrigin(0.5,1).setDisplaySize(100,32);
      this.add.image(dx,dy-24,'monitor').setOrigin(0.5,1).setDisplaySize(56,44);
      this.add.image(dx+35,dy,'chair').setOrigin(0.5,1).setDisplaySize(32,44);
      const p=this.add.rectangle(dx,dy,100,10,0,0); this.physics.add.existing(p,true); this.platformGroup.add(p);
      this.addCoverZone(dx,FY-30,90,40);
    });
    [200,370,530].forEach(px=>{
      this.add.rectangle(px,FY-90,6,80,0x9e9e9e,0.8);
    });
    [[50,FY],[700,FY]].forEach(([x,y])=>{
      this.add.rectangle(x,y-40,40,80,0x9e9e9e,0.9).setOrigin(0.5,1);
      this.add.rectangle(x,y-20,20,4,0xffd700,0.8);
      this.add.rectangle(x,y-50,20,4,0xffd700,0.8);
    });
  }

  // ── EARTHQUAKE: decorTheatre(FY) ─────────────────────────────────────────
  // Builds the theatre: raised stage (crouch underneath for cover),
  // red curtains, colored spotlights, tiered audience seats, star ceiling.
  decorTheatre(FY){
    this.add.image(W/2,FY-30,'stage').setOrigin(0.5,1).setDisplaySize(400,60);
    const sp=this.add.rectangle(W/2,FY-58,400,10,0,0);
    this.physics.add.existing(sp,true); this.platformGroup.add(sp);
    // Under the stage lip = cover
    this.addCoverZone(W/2,FY-20,380,36);
    this.add.image(200,FY/2,'curtain').setOrigin(1,0.5).setDisplaySize(60,FY-60).setAlpha(0.95);
    this.add.image(600,FY/2,'curtain').setOrigin(0,0.5).setDisplaySize(60,FY-60).setAlpha(0.95).setFlipX(true);
    ['spot_0','spot_1','spot_2'].forEach((k,i)=>{
      this.add.image(250+i*150,20,k).setOrigin(0.5,0).setDisplaySize(48,100).setAlpha(0.5);
      this.add.circle(250+i*150,24,10,0xffffff,0.8);
    });
    [[0x6020a0,'seat_p'],[0xa02020,'seat_r'],[0x2040a0,'seat_b']].forEach(([c,tex],row)=>{
      for(let col=0;col<7;col++) this.add.image(100+col*80,FY-100-row*30,tex).setOrigin(0.5,1).setDisplaySize(32,36);
    });
    for(let i=0;i<30;i++) this.add.circle(Phaser.Math.Between(50,W-50),Phaser.Math.Between(5,40),Phaser.Math.FloatBetween(0.5,2),0xffffff,Phaser.Math.FloatBetween(0.3,1));
  }

  // ─── HUD ─────────────────────────────────────────────────────────────────
  // ── EARTHQUAKE: buildHUD() ───────────────────────────────────────────────
  // Creates the top HUD bar (score ⭐, timer ⏱, location name),
  // the crouch/cover indicator strip, and the red alert banner.
  buildHUD(){
    const hudBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    hudBg.fillStyle(0x000000,0.65); hudBg.fillRect(0,0,W,40);

    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:16,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 2:00',{fontFamily:'monospace',fontSize:16,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);
    this.locTxt=this.add.text(W-12,10,LOC_NAMES[this.location]||'',{fontFamily:'monospace',fontSize:12,fill:'#00bfff'}).setOrigin(1,0).setScrollFactor(0).setDepth(41);

    // Status strip (phase info)
    this.statusBg=this.add.graphics().setScrollFactor(0).setDepth(54);
    this.statusTxt=this.add.text(W/2,H-20,'Explore the room — earthquake incoming!',{
      fontFamily:'monospace',fontSize:12,fill:'#cccccc'
    }).setOrigin(0.5,1).setScrollFactor(0).setDepth(55);

    // Crouch indicator
    this.crouchIndicator=this.add.text(14,46,'',{fontFamily:'monospace',fontSize:12,fill:'#00ff88',backgroundColor:'rgba(0,100,0,0.7)',padding:{x:6,y:2}}).setScrollFactor(0).setDepth(55).setVisible(false);

    // Alert banner
    this.alertBg=this.add.graphics().setScrollFactor(0).setDepth(57);
    this.alertTxt=this.add.text(W/2,H-52,'',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#ffffff',stroke:'#000',strokeThickness:3}).setOrigin(0.5).setScrollFactor(0).setDepth(58).setVisible(false);
  }

  updateHUD(){
    const m=Math.floor(this.timeLeft/60), s=this.timeLeft%60;
    this.timerTxt.setText(`⏱ ${m}:${s.toString().padStart(2,'0')}`);
    if(this.timeLeft<=15) this.timerTxt.setColor('#ff4444');
    else if(this.timeLeft<=30) this.timerTxt.setColor('#ffaa00');
    else this.timerTxt.setColor('#00ff88');
    this.scoreTxt.setText(`⭐ ${this.score}`);
  }

  showStatus(msg,color='#cccccc'){
    this.statusBg.clear();
    this.statusBg.fillStyle(0x000000,0.7); this.statusBg.fillRect(0,H-24,W,24);
    this.statusTxt.setText(msg).setColor(color);
  }

  showNotif(msg,ok){
    this.notifText.setText(msg).setColor(ok?'#00ff88':'#ff6666').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifText);
    this.tweens.add({targets:this.notifText,alpha:0,duration:300,delay:2200,onComplete:()=>this.notifText.setVisible(false).setAlpha(1)});
  }

  showBigAlert(msg,color='#ff4444'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.5);
    this.tweens.add({targets:this.phaseTxt,scaleX:1,scaleY:1,duration:300,ease:'Back.Out'});
    this.time.delayedCall(2200,()=>{ this.tweens.add({targets:this.phaseTxt,alpha:0,duration:400,onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}); });
  }

  // ─── PHASES ──────────────────────────────────────────────────────────────
  // ── EARTHQUAKE: startQuakePhase() ────────────────────────────────────────
  // THE EARTHQUAKE BEGINS HERE.
  // Plays alert sound + rumble, starts camera shake for 9 seconds,
  // shows the red "EARTHQUAKE!" banner, spawns debris every 600 ms (19 waves),
  // and schedules startAftermathPhase() after 10 seconds.
  startQuakePhase(){
    if(this.gameOver) return;
    this.phase='quake';
    SFX.alert(); SFX.rumble();
    this.showBigAlert('⚠ EARTHQUAKE!\nDROP & TAKE COVER!','#ff4444');
    this.showStatus('🔴 EARTHQUAKE! Crouch (S) under a desk or table!','#ff6666');

    // Alert banner
    this.alertBg.clear();
    this.alertBg.fillStyle(0xaa0000,0.85); this.alertBg.fillRect(0,H-72,W,38);
    this.alertTxt.setText('⚠  EARTHQUAKE — CROUCH (S) UNDER COVER  ⚠').setVisible(true);

    this.cameras.main.shake(9000,0.013,true);

    // Debris waves
    this.debrisWave=0;
    this.debrisTimer=this.time.addEvent({delay:600,repeat:18,callback:()=>this.spawnDebris()});

    // After 10 s → aftermath
    this.time.delayedCall(10000,()=>this.startAftermathPhase());
  }

  // ── EARTHQUAKE: startAftermathPhase() ────────────────────────────────────
  // Called 10 seconds after the quake starts (quake is now over).
  // Stops camera shake, hides alert banner, awards cover/no-hit bonuses,
  // and calls openExitDoor() so the player can escape.
  startAftermathPhase(){
    if(this.gameOver) return;
    this.phase='aftermath';
    this.cameras.main.resetFX();
    this.alertBg.clear(); this.alertTxt.setVisible(false);
    if(this.debrisTimer) this.debrisTimer.remove();

    SFX.correct();
    this.showBigAlert('✅ Quake Over!\nHead to the EXIT →','#00ff88');
    this.showStatus('Quake stopped! Walk to the EXIT door →','#00ff88');

    // Score cover bonus
    if(this.coverBonus){
      this.score+=400;
      this.showNotif('🛡 Safe during quake! +400',true);
      this.time.delayedCall(1000,()=>{ this.score+=600; this.showNotif('✓ Took cover in time! +600',true); this.updateHUD(); });
    }
    this.updateHUD();
    this.openExitDoor();
  }

  // ─── DEBRIS ──────────────────────────────────────────────────────────────
  // ── EARTHQUAKE: spawnDebris() ────────────────────────────────────────────
  // Drops a single physics debris chunk from a random X position at the top.
  // If it overlaps the player while player is NOT under cover → triggerGameOver().
  // Bounces on the floor and auto-destroys after 2.5 seconds.
  spawnDebris(){
    if(this.gameOver) return;
    const x=Phaser.Math.Between(40,W-80); // keep away from exit zone
    const texKeys=['debris_a','debris_b','debris_c'];
    const d=this.physics.add.image(x,-10,texKeys[Phaser.Math.Between(0,2)]).setDisplaySize(22,22).setDepth(9);
    // All debris move at same speed: 250 px/s downward, random horizontal drift
    d.setVelocityY(250);
    d.setVelocityX(Phaser.Math.Between(-30,30));
    d.setAngularVelocity(Phaser.Math.Between(-180,180));
    // Overlap with player sprite → game over if not under cover
    this.physics.add.overlap(d, this.player.sprite, ()=>{
      if(d._hit) return; d._hit=true; d.destroy();
      if(!this.player.isUnderCover){
        this.coverBonus=false;
        this.triggerGameOver('Hit by debris!',true);
      }
    });
    this.physics.add.collider(d,this.floorGroup,()=>{
      d.setVelocityX(d.body.velocity.x*0.4);
      d.setVelocityY(-Phaser.Math.Between(10,50));
      this.time.delayedCall(2500,()=>{ if(d.active) d.destroy(); });
    });
    this.debrisList.push(d);
  }

  // ─── GAME OVER ────────────────────────────────────────────────────────────
  // ── EARTHQUAKE: triggerGameOver(reason, dead) ────────────────────────────
  // Ends the game with a failure. Flashes red, plays wrong sound,
  // optionally kills the player sprite (dead=true when hit by debris),
  // shows the big "GAME OVER" text, then fades to ScoreScene with died:true.
  triggerGameOver(reason, dead){
    if(this.gameOver) return;
    this.gameOver=true;
    if(this.debrisTimer) this.debrisTimer.remove();
    this.timerEvent.remove();
    this.cameras.main.resetFX();
    SFX.wrong();

    // Flash red
    this.cameras.main.flash(500,255,0,0);
    if(dead){
      this.player.kill(); // OOP Player handles tint + death tween
    }

    this.showBigAlert(`💀 GAME OVER\n${reason}`,'#ff4444');

    this.time.delayedCall(2000,()=>{
      this.cameras.main.fade(600,0,0,0);
      this.time.delayedCall(600,()=>{
        this.scene.start('Score',{
          score:this.score, timeBonus:0, survBonus:0,
          location:this.location, raw:this.score,
          died:true, reason
        });
      });
    });
  }

  // ─── WIN: REACH EXIT ─────────────────────────────────────────────────────
  // ── EARTHQUAKE: reachExit() ──────────────────────────────────────────────
  // Called when the player walks into the open EXIT door (aftermath phase).
  // Stops the timer, calculates time bonus + survival bonus, plays teleport
  // sound, fades out, then goes to ScoreScene with died:false.
  reachExit(){
    if(this.gameOver) return;
    this.gameOver=true;
    this.timerEvent.remove();
    this.cameras.main.resetFX();

    const timeBonus=this.timeLeft*3;
    const survBonus=this.coverBonus?500:0;
    const final=this.score+timeBonus+survBonus;

    SFX.teleport();
    this.showBigAlert('🏆 ESCAPED!\nHeading to safety…','#ffd700');
    this.cameras.main.fade(800,0,0,0);
    this.time.delayedCall(800,()=>{
      this.scene.start('Score',{
        score:final, timeBonus, survBonus,
        location:this.location, raw:this.score,
        died:false, reason:'escaped'
      });
    });
  }

  // ─── UPDATE LOOP ─────────────────────────────────────────────────────────
  // ── EARTHQUAKE: update() ─────────────────────────────────────────────────
  // Main game loop (called every frame ~60fps).
  // Handles: A/D movement, W jump, S crouch, cover zone detection,
  // exit door collision, player sprite animation switching,
  // and the crouch indicator HUD text.
  update(){
    if(this.gameOver) return;

    // ── Delegate ALL movement, jump, crouch, animation to Player class ──
    this.player.update(16.6);

    // ── Read player state from OOP Player (no local copies needed) ──
    const isCrouching  = this.player.isCrouching;
    const isUnderCover = this.player.isUnderCover;

    // ── CROUCH INDICATOR HUD ──
    if(isCrouching){
      this.crouchIndicator.setVisible(true);
      this.crouchIndicator.setText(isUnderCover ? '🛡 COVERED' : '⚠ NOT COVERED');
      this.crouchIndicator.setColor(isUnderCover ? '#00ff88' : '#ffaa00');
    } else {
      this.crouchIndicator.setVisible(false);
    }

    // ── EXIT DOOR CHECK ──
    if(this.exitOpen && this.phase==='aftermath'){
      const ed = this.exitDoor;
      const px = this.player.x, py = this.player.y;
      if(px > ed.x-ed.w/2 && px < ed.x+ed.w/2 && py > ed.y-ed.h/2 && py < ed.y+ed.h+10){
        this.reachExit();
      }
    }

    // ── PRE-QUAKE STATUS ──
    if(this.phase==='pre'){
      if(this.timeLeft<110 && this.timeLeft>=108)
        this.showStatus('⚠ Rumbling detected... Find a desk to hide under!','#ffaa00');
    }

    // ── E KEY: reserved for interactions in future games ──
    if(Phaser.Input.Keyboard.JustDown(this.interactKey) || window._mAction){
      window._mAction = false;
    }
  }
}

