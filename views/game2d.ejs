    const bg=this.add.graphics();
    bg.fillStyle(0x000000,0.93); bg.fillRect(0,0,W,H);
    const box=this.add.graphics();
    box.fillStyle(0x000a1a,1); box.fillRoundedRect(cx-260,50,520,400,16);
