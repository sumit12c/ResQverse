// SCENE 7 — FIRE INSTRUCTIONS
// ─────────────────────────────────────────────────────────────────────────────
class FireInstructionsScene extends Phaser.Scene {
  constructor(){ super('FireInstructions'); }
  create(){
    const cx=W/2;
    const bg=this.add.graphics();
    bg.fillStyle(0x000000,0.93); bg.fillRect(0,0,W,H);

    const box=this.add.graphics();
    box.fillStyle(0x1a0500,1); box.fillRoundedRect(cx-260,55,520,390,16);
    box.lineStyle(3,0xff6600); box.strokeRoundedRect(cx-260,55,520,390,16);

    this.add.text(cx,90,'🔥 BUILDING FIRE DRILL',{fontFamily:'monospace',fontSize:24,fontStyle:'bold',fill:'#ff6600'}).setOrigin(0.5);
    this.add.text(cx,122,'Office Building — Floor 3',{fontFamily:'monospace',fontSize:14,fill:'#ffaa44',letterSpacing:2}).setOrigin(0.5);
    this.add.text(cx,152,'Fire broke out! Find the extinguisher,\npick it up, put out the fire, then reach EXIT.',{
      fontFamily:'monospace',fontSize:13,fill:'#cccccc',align:'center',lineSpacing:5
    }).setOrigin(0.5);

    const tips=[
      '🎮  A / D move  ·  W jump  ·  E interact',
      '🧯  Walk to the extinguisher and press E to pick up',
      '🔥  Walk toward a fire and press E to spray it',
      '🚪  Once all fires out, EXIT door opens — reach it!',
      '⚠️  Touching fire directly = health damage',
      '⏱  Faster escape = better score bonus',
    ];
    const tipBg=this.add.graphics();
    tipBg.fillStyle(0xff6600,0.08); tipBg.fillRoundedRect(cx-215,195,430,148,8);
    tipBg.lineStyle(1,0xff6600,0.3); tipBg.strokeRoundedRect(cx-215,195,430,148,8);
    tips.forEach((t,i)=>this.add.text(cx-200,205+i*23,t,{fontFamily:'monospace',fontSize:11,fill:'#ffcc88'}));

    // Start button
    const btnG=this.add.graphics();
    btnG.fillGradientStyle(0xff6600,0xff6600,0xff2200,0xff2200,1);
    btnG.fillRoundedRect(cx-110,358,220,50,25);
    const btn=this.add.text(cx,383,'▶ START DRILL!',{fontFamily:'monospace',fontSize:19,fontStyle:'bold',fill:'#ffffff'})
      .setOrigin(0.5).setInteractive({useHandCursor:true});
    btn.on('pointerdown',()=>{
      SFX.alert();
      this.cameras.main.fade(500,0,0,0);
      this.time.delayedCall(500,()=>this.scene.start('Fire'));
    });

    const back=this.add.text(cx,422,'← Back to Hall',{fontFamily:'monospace',fontSize:12,fill:'#665533'})
      .setOrigin(0.5).setInteractive({useHandCursor:true});
    back.on('pointerdown',()=>{
      this.cameras.main.fade(400,0,0,0);
      this.time.delayedCall(400,()=>this.scene.start('Hall'));
    });
  }
}

// ═════════════════════════════════════════════════════════════════════════════
// ████████████████████████  FIRE GAME CODE STARTS HERE  ███████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  FireScene — Office building fire escape
//
//  FLOW:
//    Phase 1 – FIND    : Explore office floor, locate extinguisher (glowing red)
//    Phase 2 – PICKUP  : Press E near extinguisher to pick it up (HUD changes)
//    Phase 3 – EXTINGUISH: Walk toward fire tiles, press E to spray them out
//                          Player loses health if touching active fire
//    Phase 4 – ESCAPE  : All fires out → EXIT door opens → walk to exit to win
//
//  SCORING:
//    +300  per fire extinguished
//    +200  picked up extinguisher quickly (within 20s)
//    +timeLeft * 4  time bonus on escape
//    -50   per health point lost to fire
//
//  KEY METHODS:
//    create()            — builds office room, spawns fires, extinguisher, player
//    buildOffice()       — multi-room office with desks, cabinets, carpet tiles
//    spawnFires()        — places fire objects at fixed positions
//    spawnExtinguisher() — places the pickup item
//    buildExitDoor()     — locked exit top-right
//    openExit()          — unlocks when all fires out
//    tryInteract()       — E key: pickup extinguisher OR spray fire
//    updateFire()        — animates fire frames, checks player contact damage
//    checkAllOut()       — checks if every fire is extinguished → openExit
//    endGame(won)        — fade to ScoreScene
//    update()            — delegates to Player, fire damage, interaction hints
// ═════════════════════════════════════════════════════════════════════════════
class FireScene extends Phaser.Scene {
  constructor(){ super('Fire'); }

  create(){
    this.score       = 0;
    this.timeLeft    = 150;      // 2.5 minutes
    this.health      = 5;        // fire hits
    this.maxHealth   = 5;
    this.hasExtinguisher = false;
    this.fires       = [];       // {x,y,sprite,smokeSprite,out,frame,timer}
    this.exitOpen    = false;
    this.gameOver    = false;
    this.phase       = 'find';   // find | extinguish | escape
    this.fireCount   = 0;
    this.extObj      = null;     // extinguisher pickup object
    this.sprayAnims  = [];
    this.pickupBonus = true;     // +200 if picked up within 20s

    const FY = H - 80;
    this.FLOOR_Y = FY;
    this.lightTiles = [];    // must exist before buildOffice pushes into it

    this.buildOffice(FY);

    // ── PLAYER (reusing OOP Player class) ──
    this.player = new Player(this, 60, FY - 20, {
      speed:140, jumpForce:0, canCrouch:false, canJump:false, gravity:600
    });
    this.player.addCollider(this.floorGroup);
    this.player.addCollider(this.platformGroup);

    this.spawnExtinguisher(FY);
    this.spawnFires(FY);
    this.buildExitDoor(FY);

    // ── E / INTERACT key ──
    this.interactKey = this.input.keyboard.addKey(Phaser.Input.Keyboard.KeyCodes.E);

    this.buildHUD();

    // ── COUNTDOWN ──
    this.timerEvent = this.time.addEvent({ delay:1000, repeat:149, callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.updateHUD();
      // pickup bonus window
      if(this.timeLeft===130) this.pickupBonus=false;
      if(this.timeLeft<=0) this.endGame(false,'Time ran out!');
    }});

    // ── PHASE LABEL ──
    this.phaseTxt = this.add.text(W/2, H/2-20,'',{
      fontFamily:'monospace',fontSize:26,fontStyle:'bold',
      fill:'#ff6600',stroke:'#000',strokeThickness:4,align:'center'
    }).setOrigin(0.5).setDepth(70).setVisible(false);

    // ── NOTIF ──
    this.notifTxt = this.add.text(W/2,H-130,'',{
      fontFamily:'monospace',fontSize:14,fontStyle:'bold',
      fill:'#ff9900',backgroundColor:'rgba(0,0,0,0.88)',padding:{x:12,y:6}
    }).setOrigin(0.5).setDepth(60).setVisible(false);

    // ── INTERACT HINT ──
    this.hintTxt = this.add.text(W/2,H-58,'',{
      fontFamily:'monospace',fontSize:13,fontStyle:'bold',
      fill:'#ffd700',backgroundColor:'rgba(0,0,0,0.8)',padding:{x:8,y:4}
    }).setOrigin(0.5).setScrollFactor(0).setDepth(55).setVisible(false);

    // ── FIRE AMBIENT FLICKER (orange overlay) ──
    this.fireOverlay = this.add.rectangle(W/2,H/2,W,H,0xff2200,0)
      .setScrollFactor(0).setDepth(48);
    this.tweens.add({
      targets:this.fireOverlay, alpha:{from:0,to:0.06},
      duration:400, yoyo:true, repeat:-1
    });

    // ── FIRE ANIMATION TIMER ──
    this.fireFrame = 0;
    this.time.addEvent({ delay:200, repeat:-1, callback:()=>{
      this.fireFrame=(this.fireFrame+1)%3;
      this.fires.forEach(f=>{ if(!f.out) f.sprite.setTexture(`fire_${this.fireFrame}`); });
      this.fires.forEach(f=>{ if(!f.out && f.smokeSprite) f.smokeSprite.setTexture(`smoke_${this.fireFrame}`); });
    }});

    // random flickering lights
    this.time.addEvent({ delay:150, repeat:-1, callback:()=>{
      this.lightTiles.forEach(l=>l.setAlpha(0.6+Math.random()*0.4));
    }});

    setupMobile(this);
    const mSprint=document.getElementById('mSprint');
    if(mSprint) mSprint.textContent='E';
    const mJump=document.getElementById('mJump');
    if(mJump) mJump.textContent='W/↑';

    this.showBig('🔥 FIRE!\nFind the extinguisher!','#ff6600');
  }

  // ── BUILD OFFICE ROOM ────────────────────────────────────────────────────
  buildOffice(FY){
    // Sky/background
    const bg = this.add.graphics();
    bg.fillStyle(0x1a0800,1); bg.fillRect(0,0,W,H);
    // Smoke haze background
    bg.fillStyle(0x331100,0.4); bg.fillRect(0,0,W,H*0.4);

    // Carpet floor tiles
    for(let x=0;x<W;x+=32){
      this.add.image(x,FY,'tile_carpet').setOrigin(0,0).setDisplaySize(32,32);
      this.add.image(x,FY+32,'tile_carpet').setOrigin(0,0).setDisplaySize(32,32).setAlpha(0.5);
    }

    // Walls (dark scorched panel)
    for(let y=0;y<FY;y+=32){
      this.add.image(0,y,'wall_panel').setOrigin(0,0).setDisplaySize(36,32).setTint(0x553322).setAlpha(0.9);
      this.add.image(W-36,y,'wall_panel').setOrigin(0,0).setDisplaySize(36,32).setTint(0x553322).setAlpha(0.9).setFlipX(true);
    }
    // Ceiling
    for(let x=0;x<W;x+=32){
      const c=this.add.image(x,0,'ceiling_light').setOrigin(0,0).setDisplaySize(32,24).setTint(0x885544);
      this.lightTiles.push(c);
    }

    // Physics floor
    this.floorGroup = this.physics.add.staticGroup();
    const fb = this.add.rectangle(W/2,FY+16,W,32,0,0);
    this.physics.add.existing(fb,true); this.floorGroup.add(fb);

    this.platformGroup = this.physics.add.staticGroup();
    // NOTE: No desk platforms in fire scene — player walks freely under them.
    // Tables/desks are purely visual decorations here.

    // ── OFFICE FURNITURE (visual only — no physics platforms) ──
    const deskXs=[130,280,430,580];
    deskXs.forEach(dx=>{
      // Desk legs (so player can clearly walk under)
      this.add.rectangle(dx-44, FY-25, 6, 50, 0x8b5a2b, 1).setOrigin(0.5,1);
      this.add.rectangle(dx+44, FY-25, 6, 50, 0x8b5a2b, 1).setOrigin(0.5,1);
      // Desk top — raised high enough (FY-75) that player (52px) fits underneath
      this.add.image(dx, FY-75, 'desk').setOrigin(0.5,1).setDisplaySize(100,18).setTint(0xcc8844);
      // Monitor on desk
      this.add.image(dx, FY-90, 'monitor').setOrigin(0.5,1).setDisplaySize(50,38).setTint(0x886633);
      // Chair beside desk (visual only)
      this.add.image(dx+42, FY-5, 'chair').setOrigin(0.5,1).setDisplaySize(30,40).setTint(0x994422);
    });

    // Filing cabinets
    [50,700,740].forEach(fx=>{
      this.add.image(fx,FY,'filing').setOrigin(0.5,1).setDisplaySize(32,48).setTint(0x776655);
    });

    // Partitions (walls between desks)
    [200,360,520].forEach(px2=>{
      this.add.rectangle(px2,FY-70,6,100,0x775544,1);
    });

    // Ceiling lights (hanging)
    [W/5, W*2/5, W*3/5, W*4/5].forEach(lx=>{
      const bulb=this.add.ellipse(lx,20,18,18,0xffaa44,0.8);
      this.lightTiles.push(bulb);
      this.add.ellipse(lx,40,60,30,0xffaa44,0.12);
      // Hanging wire
      this.add.rectangle(lx,10,2,20,0x888888,0.9);
    });

    // Scorched wall patches (decor)
    [[60,120],[380,100],[650,140],[720,80]].forEach(([x,y])=>{
      this.add.image(x,y,`burnwall_${Phaser.Math.Between(0,2)}`).setOrigin(0.5).setDisplaySize(48,48).setAlpha(0.7);
    });

    // Cracks in floor
    [[150,FY-8],[400,FY-8],[600,FY-8]].forEach(([cx2,cy])=>{
      this.add.image(cx2,cy,'crack').setOrigin(0.5,1).setDisplaySize(32,24).setAlpha(0.6);
    });

    // Broken window (far right)
    this.add.rectangle(W-80,120,80,80,0x8888bb,0.15);
    this.add.rectangle(W-80,120,80,80,0x000000,0).setStrokeStyle(3,0x664433);
    // Shatter lines
    [[W-80,80,W-60,160],[W-90,120,W-50,130],[W-100,100,W-65,140]].forEach(([x1,y1,x2,y2])=>{
      this.add.line(0,0,x1,y1,x2,y2,0x664433,0.8).setOrigin(0);
    });
  }

  // ── SPAWN FIRES ─────────────────────────────────────────────────────────
  spawnFires(FY){
    const firePositions=[
      {x:320, y:FY-30},
      {x:500, y:FY-30},
      {x:650, y:FY-30},
    ];

    firePositions.forEach((fp,i)=>{
      const spr = this.add.image(fp.x, fp.y,'fire_0').setOrigin(0.5,1).setDisplaySize(48,48).setDepth(7);
      const smoke = this.add.image(fp.x, fp.y-50,'smoke_0').setOrigin(0.5,1).setDisplaySize(48,32).setDepth(6).setAlpha(0.7);
      // glow halo
      const glow = this.add.ellipse(fp.x, fp.y-8, 70, 30, 0xff4400, 0.25).setDepth(5);
      this.tweens.add({targets:glow, scaleX:{from:0.9,to:1.1}, alpha:{from:0.15,to:0.35}, duration:300+i*80, yoyo:true, repeat:-1});
      // Physics body (player overlap for damage)
      const body = this.add.rectangle(fp.x, fp.y-24, 40, 48, 0,0).setDepth(4);
      this.physics.add.existing(body, true);
      this.fires.push({ x:fp.x, y:fp.y, sprite:spr, smokeSprite:smoke, glow, body, out:false });
      this.fireCount++;
    });
  }

  // ── SPAWN EXTINGUISHER ──────────────────────────────────────────────────
  spawnExtinguisher(FY){
    const ex=180, ey=FY-20;
    // Glow behind it
    const glow=this.add.ellipse(ex,ey,50,30,0xff0000,0.3).setDepth(5);
    this.tweens.add({targets:glow, scaleX:{from:0.8,to:1.2}, alpha:{from:0.2,to:0.5}, duration:500, yoyo:true, repeat:-1});
    // Sprite
    const spr=this.add.image(ex,ey,'extinguisher').setOrigin(0.5,1).setDisplaySize(28,42).setDepth(8);
    this.tweens.add({targets:spr, y:{from:ey,to:ey-6}, duration:600, yoyo:true, repeat:-1});
    // Label
    const lbl=this.add.text(ex,ey-52,'🧯 EXTINGUISHER',{fontFamily:'monospace',fontSize:9,fill:'#ff4400',backgroundColor:'rgba(0,0,0,0.7)',padding:{x:4,y:2}}).setOrigin(0.5).setDepth(9);
    this.extObj = { x:ex, y:ey, sprite:spr, glow, label:lbl, picked:false };
  }

  // ── BUILD EXIT DOOR ─────────────────────────────────────────────────────
  buildExitDoor(FY){
    const ex=W-55, ey=FY-40;
    const frame=this.add.graphics().setDepth(6);
    frame.fillStyle(0x222222,1); frame.fillRect(ex-22,ey-70,44,80);
    frame.lineStyle(4,0x444444); frame.strokeRect(ex-22,ey-70,44,80);
    // Sign
    this.add.image(ex,ey-78,'exit_sign').setOrigin(0.5,1).setDisplaySize(56,20).setDepth(7).setAlpha(0.3);
    this.exitSignImg=this.add.image(ex,ey-78,'exit_sign').setOrigin(0.5,1).setDisplaySize(56,20).setDepth(8).setAlpha(0.3);
    this.exitDoorFill=this.add.rectangle(ex,ey-30,38,74,0x111111,1).setDepth(7);
    this.lockIcon=this.add.text(ex,ey-30,'🔒',{fontSize:18}).setOrigin(0.5).setDepth(9);
    this.exitDoor={x:ex, y:ey-30, w:44, h:80};
  }

  openExit(){
    this.exitOpen=true;
    this.exitDoorFill.setFillStyle(0x00ff88,0.8);
    this.lockIcon.setText('🚪');
    this.exitSignImg.setAlpha(1);
    this.tweens.add({targets:this.exitDoorFill, alpha:{from:0.5,to:1}, duration:400, yoyo:true, repeat:-1});
    // Arrow
    this.exitArrow=this.add.text(W-55,this.FLOOR_Y-160,'⬇ EXIT',{
      fontFamily:'monospace',fontSize:12,fontStyle:'bold',fill:'#00ff88',
      backgroundColor:'rgba(0,0,0,0.7)',padding:{x:6,y:3}
    }).setOrigin(0.5).setDepth(20);
    this.tweens.add({targets:this.exitArrow, y:'+=7', duration:500, yoyo:true, repeat:-1});
    this.showNotif('✅ All fires out! Get to the EXIT →',true);
    this.phase='escape';
  }

  // ── HUD ────────────────────────────────────────────────────────────────
  buildHUD(){
    const hudBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    hudBg.fillStyle(0x000000,0.7); hudBg.fillRect(0,0,W,40);

    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 2:30',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#ff9900'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);
    this.healthTxt=this.add.text(W-14,10,'❤️❤️❤️❤️❤️',{fontFamily:'monospace',fontSize:13}).setOrigin(1,0).setScrollFactor(0).setDepth(41);
    // Extinguisher status
    this.extHUD=this.add.text(14,46,'',{fontFamily:'monospace',fontSize:11,fill:'#ffaa44',backgroundColor:'rgba(0,0,0,0.6)',padding:{x:6,y:2}}).setScrollFactor(0).setDepth(41).setVisible(false);
    // Status bar
    const sBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    sBg.fillStyle(0x000000,0.6); sBg.fillRect(0,H-22,W,22);
    this.statusTxt=this.add.text(W/2,H-11,'🔥 Find the fire extinguisher!',{fontFamily:'monospace',fontSize:11,fill:'#ffaa44'}).setOrigin(0.5).setScrollFactor(0).setDepth(41);
  }

  updateHUD(){
    const m=Math.floor(this.timeLeft/60), s=this.timeLeft%60;
    this.timerTxt.setText(`⏱ ${m}:${s.toString().padStart(2,'0')}`);
    if(this.timeLeft<=20) this.timerTxt.setColor('#ff4444');
    else if(this.timeLeft<=40) this.timerTxt.setColor('#ffaa00');
    this.scoreTxt.setText(`⭐ ${this.score}`);
    const hearts='❤️'.repeat(this.health)+'🖤'.repeat(this.maxHealth-this.health);
    this.healthTxt.setText(hearts);
    if(this.hasExtinguisher){
      const outsLeft=this.fires.filter(f=>!f.out).length;
      this.extHUD.setText(`🧯 Extinguisher ready — ${outsLeft} fire${outsLeft!==1?'s':''} left`).setVisible(true);
    }
  }

  setStatus(msg,color='#ffaa44'){ this.statusTxt.setText(msg).setColor(color); }

  showNotif(msg, ok){
    this.notifTxt.setText(msg).setColor(ok?'#00ff88':'#ff6666').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifTxt);
    this.tweens.add({targets:this.notifTxt, alpha:0, duration:300, delay:2500, onComplete:()=>this.notifTxt.setVisible(false).setAlpha(1)});
  }

  showBig(msg, color='#ff6600'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.5);
    this.tweens.add({targets:this.phaseTxt, scaleX:1, scaleY:1, duration:300, ease:'Back.Out'});
    this.time.delayedCall(2500,()=>this.tweens.add({targets:this.phaseTxt, alpha:0, duration:400, onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}));
  }

  // ── INTERACT (E key) ────────────────────────────────────────────────────
  tryInteract(){
    if(this.gameOver) return;

    // Pickup extinguisher
    if(!this.hasExtinguisher && this.extObj && !this.extObj.picked){
      const d=Phaser.Math.Distance.Between(this.player.x, this.player.y, this.extObj.x, this.extObj.y);
      if(d<70){
        this.extObj.picked=true;
        this.extObj.sprite.destroy();
        this.extObj.glow.destroy();
        this.extObj.label.destroy();
        this.hasExtinguisher=true;
        if(this.pickupBonus){ this.score+=200; }
        SFX.correct();
        this.showNotif('🧯 Extinguisher picked up! Spray the fires!',true);
        this.setStatus('🔥 Spray each fire — walk close and press E!','#ff9900');
        this.phase='extinguish';
        this.updateHUD();
        return;
      }
    }

    // Spray a fire
    if(this.hasExtinguisher && this.phase==='extinguish'){
      let sprayed=false;
      this.fires.forEach(f=>{
        if(f.out) return;
        const d=Phaser.Math.Distance.Between(this.player.x, this.player.y, f.x, f.y);
        if(d<90){
          this.extinguishFire(f);
          sprayed=true;
        }
      });
      if(!sprayed) this.showNotif('Get closer to the fire!',false);
    }
  }

  extinguishFire(f){
    f.out=true;
    f.sprite.setVisible(false);
    f.smokeSprite.setVisible(false);
    f.glow.setVisible(false);
    SFX.correct();
    this.score+=300;
    this.updateHUD();

    // Spray effect
    for(let i=0;i<4;i++){
      const sx=f.x+Phaser.Math.Between(-20,20), sy=f.y-Phaser.Math.Between(10,40);
      const sp=this.add.image(sx,sy,'spray_0').setDisplaySize(40,24).setDepth(15);
      this.tweens.add({targets:sp, x:f.x+Phaser.Math.Between(-40,40), y:f.y-80, alpha:0, duration:600, delay:i*80, onComplete:()=>sp.destroy()});
    }
    // Char mark where fire was
    this.add.ellipse(f.x,f.y-5,50,16,0x111111,0.7).setDepth(4);
    this.showNotif(`🧯 Fire extinguished! +300`,true);

    const fires_left=this.fires.filter(ff=>!ff.out).length;
    if(fires_left===0){
      this.time.delayedCall(600,()=>this.openExit());
    } else {
      this.setStatus(`🔥 ${fires_left} fire${fires_left!==1?'s':''} remaining — keep spraying!`,'#ff9900');
    }
  }

  // ── FIRE DAMAGE ─────────────────────────────────────────────────────────
  checkFireDamage(){
    if(this.gameOver || this._damageCooldown) return;
    this.fires.forEach(f=>{
      if(f.out) return;
      const d=Phaser.Math.Distance.Between(this.player.x, this.player.y, f.x, f.y);
      if(d<36){
        this.health=Math.max(0,this.health-1);
        this.score=Math.max(0,this.score-50);
        this.updateHUD();
        this.cameras.main.flash(200,255,80,0);
        SFX.wrong();
        this._damageCooldown=true;
        this.time.delayedCall(1500,()=>this._damageCooldown=false);
        if(this.health<=0) this.endGame(false,'Overcome by fire!');
      }
    });
  }

  // ── CHECK ALL FIRES OUT ─────────────────────────────────────────────────
  checkAllOut(){
    return this.fires.every(f=>f.out);
  }

  // ── END GAME ────────────────────────────────────────────────────────────
  endGame(won, reason=''){
    if(this.gameOver) return;
    this.gameOver=true;
    this.timerEvent.remove();
    this.cameras.main.resetFX();

    if(!won){
      SFX.wrong();
      this.cameras.main.flash(600,255,50,0);
      this.player.kill();
      this.showBig(`💀 GAME OVER\n${reason}`,'#ff4444');
    } else {
      SFX.teleport();
      this.showBig('🏆 ESCAPED!\nWell done!','#ffd700');
    }

    const timeBonus = won ? this.timeLeft*4 : 0;
    const survBonus = won ? 300 : 0;
    const final = this.score + timeBonus + survBonus;

    this.cameras.main.fade(800,0,0,0);
    this.time.delayedCall(800,()=>{
      if(won){
        // ── WIN: proceed to Level 2 — Smoke Corridor (same disaster, new challenge) ──
        this.scene.start('SmokeEscape',{ fireScore: final });
      } else {
        this.scene.start('Score',{
          score:final, timeBonus, survBonus,
          location:'office_fire',
          raw:this.score,
          died:true,
          reason,
          gameType:'fire'
        });
      }
    });
  }

  // ── UPDATE ──────────────────────────────────────────────────────────────
  update(){
    if(this.gameOver) return;

    // Delegate movement + animation to Player OOP class
    this.player.update(16.6);

    // Fire damage check
    this.checkFireDamage();

    // Exit door check
    if(this.exitOpen && this.phase==='escape'){
      const ed=this.exitDoor;
      if(this.player.x>ed.x-ed.w/2 && this.player.x<ed.x+ed.w/2 &&
         this.player.y>ed.y-ed.h/2 && this.player.y<ed.y+ed.h+10){
        this.endGame(true);
      }
    }

    // Interaction hint
    let hint='';
    if(!this.hasExtinguisher && this.extObj && !this.extObj.picked){
      const d=Phaser.Math.Distance.Between(this.player.x, this.player.y, this.extObj.x, this.extObj.y);
      if(d<80) hint='[ E ] Pick up extinguisher';
    } else if(this.hasExtinguisher && this.phase==='extinguish'){
      const near=this.fires.some(f=>!f.out && Phaser.Math.Distance.Between(this.player.x, this.player.y, f.x, f.y)<90);
      if(near) hint='[ E ] Spray fire!';
    }
    this.hintTxt.setText(hint).setVisible(hint!=='');

    // E key
    if(Phaser.Input.Keyboard.JustDown(this.interactKey) || window._mAction){
      window._mAction=false;
      this.tryInteract();
    }
    // mobile sprint button = E for this scene
    if(window._mSprint){ window._mSprint=false; this.tryInteract(); }
  }
}
// ── END OF FireScene ────────────────────────────────────────────────────────



// ═════════════════════════════════════════════════════════════════════════════
// ████████████████████████  SMOKE ESCAPE GAME CODE  ███████████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  SmokeEscapeScene — corridor filled with thick smoke
//
//  MECHANICS:
//    - No extinguisher, no fire to fight — just survive and navigate
//    - Corridor is split into 3 sections with smoke density increasing
//    - Player MUST crouch (S) to move safely; standing drains oxygen fast
//    - Oxygen bar replaces health — hits 0 = game over
//    - Green floor arrows point toward the exit
//    - Some sections have obstacles (fallen cabinets, debris) to jump over
//    - EXIT door at far right
//
//  SCORING:
//    +oxygenLeft * 8    oxygen efficiency bonus
//    +timeLeft * 3      time bonus
//    +300               reached exit crouching (low-crawl bonus)
//    -100               per standing-in-smoke penalty triggered
// ═════════════════════════════════════════════════════════════════════════════
class SmokeEscapeScene extends Phaser.Scene {
  constructor(){ super('SmokeEscape'); }

  // Receives fireScore passed from FireScene on win
  init(data){ this.fireScore = data.fireScore || 0; }

  create(){
    this.oxygen      = 100;   // 0-100, drains over time
    this.maxOxygen   = 100;
    this.timeLeft    = 90;    // 1.5 minutes — tight but fair
    this.score       = 0;
    this.penalties   = 0;
    this.gameOver    = false;
    this.crouchBonus = true;  // track if player mostly crawled

    const FY = H - 80;
    this.FLOOR_Y = FY;
    this.smokeGfx  = [];   // will be populated by buildCorridor
    this.smokeTime = 0;    // elapsed time for drift animation

    this.buildCorridor(FY);

    // ── PLAYER — crouch slows but still allows movement ──
    this.player = new Player(this, 50, FY - 20, {
      speed:130, jumpForce:-320, canCrouch:true, canJump:true, gravity:700
    });
    this.player.addCollider(this.floorGroup);
    this.player.addCollider(this.obstacleGroup);

    this.buildExitDoor(FY);
    this.buildHUD();

    // ── OXYGEN DRAIN TIMER (every 200ms) ──
    this.oxyTimer = this.time.addEvent({ delay:200, repeat:-1, callback:()=>{
      if(this.gameOver) return;
      const crouch = this.player.isCrouching;
      const drain  = crouch ? 0.5 : 3.0;   // crouching drains WAY less
      this.oxygen  = Math.max(0, this.oxygen - drain);
      this.updateOxyBar();
      if(!crouch && this.oxygen < 80 && Math.random()<0.05){
        this.score = Math.max(0, this.score-100);
        this.penalties++;
        this.showNotif('⚠ Crouch to avoid smoke!',false);
      }
      if(this.oxygen <= 0) this.endGame(false,'Oxygen depleted!');
    }});

    // ── COUNTDOWN ──
    this.timerEvent = this.time.addEvent({ delay:1000, repeat:89, callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.timerTxt.setText(`⏱ ${Math.floor(this.timeLeft/60)}:${(this.timeLeft%60).toString().padStart(2,'0')}`);
      if(this.timeLeft<=15) this.timerTxt.setColor('#ff4444');
      else if(this.timeLeft<=30) this.timerTxt.setColor('#ffaa00');
      if(this.timeLeft<=0) this.endGame(false,'Time ran out!');
    }});

    // ── PHASE TEXT ──
    this.phaseTxt=this.add.text(W/2,H/2-20,'',{
      fontFamily:'monospace',fontSize:24,fontStyle:'bold',
      fill:'#aaaaaa',stroke:'#000',strokeThickness:4,align:'center'
    }).setOrigin(0.5).setDepth(70).setVisible(false);

    this.notifTxt=this.add.text(W/2,H-130,'',{
      fontFamily:'monospace',fontSize:13,fontStyle:'bold',
      fill:'#aaaaaa',backgroundColor:'rgba(0,0,0,0.88)',padding:{x:12,y:6}
    }).setOrigin(0.5).setDepth(60).setVisible(false);

    setupMobile(this);
    const mJump=document.getElementById('mJump'); if(mJump) mJump.textContent='W';
    const mSprint=document.getElementById('mSprint'); if(mSprint) mSprint.textContent='S↓';
    const mAction=document.getElementById('mAction'); if(mAction) mAction.textContent='→';

    this.showBig('🔥 LEVEL 2: SMOKE CORRIDOR\nCrouch & crawl to EXIT!','#ff9944');
  }

  // ── BUILD CORRIDOR ───────────────────────────────────────────────────────
  buildCorridor(FY){
    // Dark background
    const bg=this.add.graphics();
    bg.fillStyle(0x050505,1); bg.fillRect(0,0,W,H);

    // Floor tiles
    for(let x=0;x<W;x+=32){
      this.add.image(x,FY,'tile_carpet').setOrigin(0,0).setDisplaySize(32,32).setTint(0x554433);
      this.add.image(x,FY+32,'tile_carpet').setOrigin(0,0).setDisplaySize(32,32).setAlpha(0.4).setTint(0x221100);
    }

    // Wall panels
    for(let y=0;y<FY;y+=32){
      this.add.image(0,y,'wall_panel').setOrigin(0,0).setDisplaySize(36,32).setTint(0x222222).setAlpha(0.95);
      this.add.image(W-36,y,'wall_panel').setOrigin(0,0).setDisplaySize(36,32).setTint(0x222222).setAlpha(0.95).setFlipX(true);
    }
    // Ceiling
    for(let x=0;x<W;x+=32){
      this.add.image(x,0,'ceiling_light').setOrigin(0,0).setDisplaySize(32,24).setTint(0x333333).setAlpha(0.9);
    }

    // Physics floor
    this.floorGroup=this.physics.add.staticGroup();
    const fb=this.add.rectangle(W/2,FY+16,W,32,0,0);
    this.physics.add.existing(fb,true); this.floorGroup.add(fb);
    this.obstacleGroup=this.physics.add.staticGroup();

    // Obstacles
    [{x:220,y:FY,w:28,h:55},{x:450,y:FY,w:26,h:48},{x:640,y:FY,w:30,h:58}].forEach(od=>{
      this.add.rectangle(od.x,od.y-od.h/2,od.w,od.h,0x775533,0.9).setOrigin(0.5).setDepth(5);
      this.add.rectangle(od.x,od.y-od.h/2,od.w-4,od.h-4,0x000000,0.25).setOrigin(0.5).setDepth(6);
      const body=this.add.rectangle(od.x,od.y-od.h/2,od.w,od.h,0,0).setOrigin(0.5);
      this.physics.add.existing(body,true); this.obstacleGroup.add(body);
      this.add.text(od.x,od.y-od.h-4,'↕ JUMP',{fontFamily:'monospace',fontSize:7,fill:'#ffaa44'}).setOrigin(0.5,1).setDepth(7);
    });

    // Green floor arrows
    [80,200,330,470,600,710].forEach(ax=>{
      this.add.image(ax,FY-4,'floor_arrow').setOrigin(0.5,1).setDisplaySize(40,20).setAlpha(0.7).setDepth(4);
    });

    // Wall scorch marks
    [[40,80],[180,60],[350,100],[550,70],[700,90]].forEach(([x,y])=>{
      this.add.image(x,y,`burnwall_${Phaser.Math.Between(0,2)}`).setOrigin(0.5).setDisplaySize(44,44).setAlpha(0.5).setDepth(3);
    });

    // Emergency red strip lights
    [100,280,430,610,740].forEach(lx=>{
      const strip=this.add.rectangle(lx,FY-8,32,5,0xff2200,0.85).setDepth(4);
      this.tweens.add({targets:strip,alpha:{from:0.4,to:1},duration:500+lx*0.5,yoyo:true,repeat:-1});
    });

    // ── SMOKE CLOUDS — Phaser Graphics, white/grey/black, animated ──
    this.smokeGfx=[];
    this.buildSmokeZone(0,   260, FY, 'light');
    this.buildSmokeZone(260, 520, FY, 'medium');
    this.buildSmokeZone(520, W,   FY, 'heavy');
  }

  buildSmokeZone(x1, x2, FY, type){
    const zoneW=x2-x1;
    const configs={
      light:  {upperH:FY*0.50, lowerH:FY*0.08, colorsU:[0xffffff,0xeeeeee,0xdddddd], colorsL:[0xcccccc,0xbbbbbb], alphaU:0.55, alphaL:0.18, count:5},
      medium: {upperH:FY*0.70, lowerH:FY*0.18, colorsU:[0xffffff,0xffffff,0xdddddd,0x999999], colorsL:[0xdddddd,0xaaaaaa], alphaU:0.75, alphaL:0.32, count:7},
      heavy:  {upperH:FY*0.85, lowerH:FY*0.32, colorsU:[0xffffff,0xffffff,0xeeeeee,0xaaaaaa,0x444444], colorsL:[0xeeeeee,0xbbbbbb,0x666666], alphaU:0.90, alphaL:0.50, count:9},
    };
    const cfg=configs[type];
    const step=zoneW/cfg.count;

    for(let i=0;i<cfg.count;i++){
      const sx=x1+i*step;
      const sw=step+8;
      const phase=i*0.6;

      // Upper cloud (ceiling down)
      const colorU=cfg.colorsU[i%cfg.colorsU.length];
      const gU=this.add.graphics().setDepth(22);
      gU.fillStyle(colorU, cfg.alphaU);
      gU.fillRoundedRect(sx-2, 0, sw, cfg.upperH, 10);
      this.smokeGfx.push({gfx:gU, baseX:sx-2, baseY:0, w:sw, h:cfg.upperH,
        color:colorU, alpha:cfg.alphaU, phase, speed:Phaser.Math.FloatBetween(0.4,1.0), ox:0});

      // Lower wisp (floor up) — thin clear gap in middle for crouching
      const colorL=cfg.colorsL[i%cfg.colorsL.length];
      const gL=this.add.graphics().setDepth(21);
      gL.fillStyle(colorL, cfg.alphaL);
      gL.fillRoundedRect(sx-2, FY-cfg.lowerH, sw, cfg.lowerH, 6);
      this.smokeGfx.push({gfx:gL, baseX:sx-2, baseY:FY-cfg.lowerH, w:sw, h:cfg.lowerH,
        color:colorL, alpha:cfg.alphaL, phase:phase+1.5, speed:Phaser.Math.FloatBetween(0.3,0.7), ox:0});
    }

    // Zone label at top
    const lcolor={light:'#cccccc',medium:'#ffbb66',heavy:'#ff7733'}[type];
    const ltext={light:'◈ LIGHT SMOKE',medium:'◈ HEAVY SMOKE',heavy:'◈ DENSE SMOKE'}[type];
    this.add.text((x1+x2)/2, 28, ltext,{fontFamily:'monospace',fontSize:9,fontStyle:'bold',fill:lcolor}).setOrigin(0.5,0).setDepth(30).setAlpha(0.9);
  }

  // ── EXIT DOOR ────────────────────────────────────────────────────────────
  buildExitDoor(FY){
    const ex=W-55, ey=FY-40;
    const frame=this.add.graphics().setDepth(8);
    frame.fillStyle(0x1a3322,1); frame.fillRect(ex-22,ey-70,44,84);
    frame.lineStyle(4,0x00ff88); frame.strokeRect(ex-22,ey-70,44,84);
    this.add.image(ex,ey-78,'exit_sign').setOrigin(0.5,1).setDisplaySize(56,20).setDepth(9);
    this.exitDoorFill=this.add.rectangle(ex,ey-28,38,78,0x00ff88,0.6).setDepth(8);
    this.tweens.add({targets:this.exitDoorFill, alpha:{from:0.4,to:0.8}, duration:600, yoyo:true, repeat:-1});
    // Arrow pointing to exit
    const arr=this.add.text(W-55,FY-155,'⬇ EXIT',{fontFamily:'monospace',fontSize:12,fontStyle:'bold',fill:'#00ff88',backgroundColor:'rgba(0,0,0,0.7)',padding:{x:6,y:3}}).setOrigin(0.5).setDepth(26);
    this.tweens.add({targets:arr, y:'+=7', duration:500, yoyo:true, repeat:-1});
    this.exitDoor={x:ex, y:ey-28, w:44, h:84};
  }

  // ── HUD ──────────────────────────────────────────────────────────────────
  buildHUD(){
    const hudBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    hudBg.fillStyle(0x000000,0.75); hudBg.fillRect(0,0,W,44);

    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 1:30',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#88bbff'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);

    // Oxygen bar label
    this.add.text(W-16,10,'💨 O₂',{fontFamily:'monospace',fontSize:12,fill:'#aaaaaa'}).setOrigin(1,0).setScrollFactor(0).setDepth(41);

    // Oxygen bar (dynamic — redrawn each update)
    this.oxyBarBg=this.add.graphics().setScrollFactor(0).setDepth(41);
    this.oxyBarBg.fillStyle(0x222222,1); this.oxyBarBg.fillRect(W-135,26,128,12);
    this.oxyBarFill=this.add.graphics().setScrollFactor(0).setDepth(42);
    this.updateOxyBar();

    // Crouch indicator
    this.crouchInd=this.add.text(14,46,'',{fontFamily:'monospace',fontSize:11,fill:'#00ff88',backgroundColor:'rgba(0,80,0,0.7)',padding:{x:6,y:2}}).setScrollFactor(0).setDepth(41).setVisible(false);

    // Status strip
    const sBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    sBg.fillStyle(0x000000,0.65); sBg.fillRect(0,H-22,W,22);
    this.statusTxt=this.add.text(W/2,H-11,'💨 Crouch (S) to stay below the smoke — follow arrows!',{fontFamily:'monospace',fontSize:11,fill:'#aaaaaa'}).setOrigin(0.5).setScrollFactor(0).setDepth(41);
  }

  updateOxyBar(){
    this.oxyBarFill.clear();
    const pct=this.oxygen/this.maxOxygen;
    const col = pct>0.5 ? 0x44dd44 : pct>0.25 ? 0xffaa00 : 0xff3300;
    this.oxyBarFill.fillStyle(col,1);
    this.oxyBarFill.fillRect(W-134, 27, Math.round(126*pct), 10);
    if(this.scoreTxt) this.scoreTxt.setText(`⭐ ${this.score}`);
  }

  showNotif(msg,ok){
    this.notifTxt.setText(msg).setColor(ok?'#00ff88':'#ff8844').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifTxt);
    this.tweens.add({targets:this.notifTxt,alpha:0,duration:300,delay:2200,onComplete:()=>this.notifTxt.setVisible(false).setAlpha(1)});
  }

  showBig(msg,color='#aaaaaa'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.6);
    this.tweens.add({targets:this.phaseTxt,scaleX:1,scaleY:1,duration:300,ease:'Back.Out'});
    this.time.delayedCall(2500,()=>this.tweens.add({targets:this.phaseTxt,alpha:0,duration:400,onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}));
  }

  // ── REACH EXIT ───────────────────────────────────────────────────────────
  reachExit(){
    if(this.gameOver) return;
    this.gameOver=true;
    this.oxyTimer.remove(); this.timerEvent.remove();
    const oxyBonus  = Math.round(this.oxygen * 8);
    const timeBonus = this.timeLeft * 3;
    const crawlBonus= this.crouchBonus ? 300 : 0;
    const smokeScore= this.score + oxyBonus + timeBonus + crawlBonus;
    const final     = smokeScore + this.fireScore; // combined both levels
    SFX.teleport();
    this.showBig('🏆 ESCAPED!\nBoth levels cleared!','#ffd700');
    this.cameras.main.fade(800,0,0,0);
    this.time.delayedCall(800,()=>{
      this.scene.start('Score',{
        score:final, timeBonus, survBonus:oxyBonus+crawlBonus,
        location:'office_fire', raw:smokeScore,
        died:false, reason:'escaped', gameType:'fire_full',
        fireScore:this.fireScore, smokeScore
      });
    });
  }

  // ── END GAME (failure) ───────────────────────────────────────────────────
  endGame(won, reason){
    if(this.gameOver) return;
    this.gameOver=true;
    this.oxyTimer.remove(); this.timerEvent.remove();
    SFX.wrong();
    this.cameras.main.flash(500,100,100,150);
    this.player.kill();
    this.showBig(`💀 GAME OVER\n${reason}`,'#ff4444');
    this.cameras.main.fade(800,0,0,0);
    this.time.delayedCall(800,()=>{
      this.scene.start('Score',{
        score:this.score + this.fireScore,
        timeBonus:0, survBonus:0,
        location:'office_fire', raw:this.score,
        died:true, reason, gameType:'fire_full',
        fireScore:this.fireScore, smokeScore:this.score
      });
    });
  }

  // ── UPDATE ───────────────────────────────────────────────────────────────
  update(time, delta){
    if(this.gameOver) return;

    // Delegate ALL movement, crouch, animation to Player OOP class
    this.player.update(delta||16.6);

    // ── ANIMATE SMOKE DRIFT (redraw each frame with horizontal sway) ──
    this.smokeTime += (delta||16.6) * 0.001;
    if(this.smokeGfx){
      this.smokeGfx.forEach(s=>{
        const drift = Math.sin(this.smokeTime * s.speed + s.phase) * 6;
        s.gfx.clear();
        s.gfx.fillStyle(s.color, s.alpha);
        s.gfx.fillRoundedRect(s.baseX + drift, s.baseY, s.w, s.h, 8);
      });
    }

    const crouch=this.player.isCrouching;

    // Crouch indicator
    if(crouch){
      this.crouchInd.setText('⬇ CRAWLING — Below smoke  (slow)').setVisible(true);
    } else {
      const pct=this.oxygen/this.maxOxygen;
      if(pct<0.6) this.crouchBonus=false;
      this.crouchInd.setVisible(false);
    }

    // Status tip based on oxygen
    const pct=this.oxygen/this.maxOxygen;
    if(pct<0.3)       this.statusTxt.setText('🚨 LOW OXYGEN — CROUCH and move FAST!').setColor('#ff4444');
    else if(pct<0.55) this.statusTxt.setText('⚠ Oxygen dropping — stay crouched!').setColor('#ffaa00');
    else              this.statusTxt.setText('💨 Hold S to crawl below smoke — follow green arrows →').setColor('#aaaaaa');

    // Check exit door
    const ed=this.exitDoor;
    if(this.player.x>ed.x-ed.w/2 && this.player.x<ed.x+ed.w/2 &&
       this.player.y>ed.y-ed.h/2 && this.player.y<ed.y+ed.h+10){
      this.reachExit();
    }

    // Vignette darkens as oxygen drops
    if(!this.vigOverlay){
      this.vigOverlay=this.add.rectangle(W/2,H/2,W,H,0x000000,0).setScrollFactor(0).setDepth(47);
    }
    this.vigOverlay.setAlpha(Math.max(0,(1-pct)*0.6));
  }
}
// ── END OF SmokeEscapeScene ─────────────────────────────────────────────────

