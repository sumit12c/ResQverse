// ─────────────────────────────────────────────────────────────────────────────
// AUDIO
// ─────────────────────────────────────────────────────────────────────────────
class AudioEngine {
  constructor(){ this.ctx=null; this.ambient=null; this._init=false; }
  ensure(){ if(!this.ctx) this.ctx=new(window.AudioContext||window.webkitAudioContext)(); }
  note(freq,dur,type='sine',vol=0.25,delay=0){
    try{
      this.ensure();
      const o=this.ctx.createOscillator(), g=this.ctx.createGain();
      o.connect(g); g.connect(this.ctx.destination);
      o.type=type; o.frequency.value=freq;
      const t=this.ctx.currentTime+delay;
      g.gain.setValueAtTime(vol,t);
      g.gain.exponentialRampToValueAtTime(0.001,t+dur);
      o.start(t); o.stop(t+dur+0.05);
    }catch(e){}
  }
  chord(notes,dur,vol=0.15){ notes.forEach((f,i)=>this.note(f,dur,'sine',vol,i*0.05)); }
  correct(){ this.chord([523,659,784,1047],0.3); }
  wrong(){ this.note(150,0.5,'sawtooth',0.3); this.note(120,0.5,'sawtooth',0.2,0.1); }
  alert(){
    [880,1100,880,1100,660].forEach((f,i)=>this.note(f,0.15,'square',0.35,i*0.12));
  }
  startAmbient(){
    this.ensure();
    const scale=[261,293,329,392,440,523,587,659];
    let i=0;
    const play=()=>{
      if(this._stopAmb) return;
      const trio=[scale[i%scale.length],scale[(i+2)%scale.length],scale[(i+4)%scale.length]];
      this.chord(trio,2.5,0.05);
      i++;
      this._ambTimer=setTimeout(play,2800);
    };
    this._stopAmb=false; play();
  }
  stopAmbient(){ this._stopAmb=true; clearTimeout(this._ambTimer); }
  rumble(){
    try{
      this.ensure();
      const buf=this.ctx.createBuffer(1,this.ctx.sampleRate*2,this.ctx.sampleRate);
      const d=buf.getChannelData(0);
      for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*0.4;
      const s=this.ctx.createBufferSource();
      const f=this.ctx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=90;
      s.buffer=buf; s.connect(f); f.connect(this.ctx.destination);
      s.start();
    }catch(e){}
  }
  teleport(){
    [440,550,660,880,1100].forEach((f,i)=>this.note(f,0.12,'sine',0.2,i*0.06));
  }
  menuSelect(){ this.note(660,0.1,'sine',0.3); this.note(880,0.15,'sine',0.2,0.1); }
}
