class ScoreScene extends Phaser.Scene {
  constructor(){ super('Score'); }
  init(data){ this.data2=data; }
  create(){
    const d=this.data2;
    const died=!!d.died;
    SFX.startAmbient();
    if(!died)[600,700,800,1000].forEach((f,i)=>SFX.note(f,0.25,'sine',0.15,i*0.1));
    else SFX.note(200,0.8,'sawtooth',0.3);

    const cx=W/2;
    const bg=this.add.graphics();
    if(died) bg.fillGradientStyle(0x1a0000,0x1a0000,0x0a0000,0x0a0000,1);
    else bg.fillGradientStyle(0x000000,0x000000,0x001a00,0x001a00,1);
    bg.fillRect(0,0,W,H);

    for(let i=0;i<60;i++){
      const sx=Phaser.Math.Between(0,W),sy=Phaser.Math.Between(0,H);
      this.add.circle(sx,sy,Phaser.Math.FloatBetween(0.5,2),0xffffff,Phaser.Math.FloatBetween(0.1,0.6));
    }

    const boxColor=died?0x1a0000:0x050f05;
    const borderColor=died?0xff4444:0x00ff88;
    const box=this.add.graphics();
    box.fillStyle(boxColor,0.96); box.fillRoundedRect(cx-240,35,480,H-70,18);
    box.lineStyle(3,borderColor); box.strokeRoundedRect(cx-240,35,480,H-70,18);

    if(died){
      this.add.text(cx,72,'💀 GAME OVER',{fontFamily:'monospace',fontSize:26,fontStyle:'bold',fill:'#ff4444'}).setOrigin(0.5);
      this.add.text(cx,104,d.reason||'Hit by falling debris!',{fontFamily:'monospace',fontSize:13,fill:'#ff8888'}).setOrigin(0.5);
    } else {
      this.add.text(cx,72,'🏆 ESCAPED SAFELY!',{fontFamily:'monospace',fontSize:24,fontStyle:'bold',fill:'#ffd700'}).setOrigin(0.5);
      const locLabel = (d.gameType==='fire'||d.gameType==='fire_full') ? '🔥 Office Building Fire'
                      : d.gameType==='cyclone' ? '🌀 Cyclone Safety Drill'
                      : d.gameType==='cyclone_full' ? '🌀 Cyclone — Safety & Rescue'
                      : d.gameType==='tsunami' ? '🌊 Tsunami Coastal Evacuation'
                      : d.gameType==='flood' ? '💧 Flood — Building Evacuation'
                      : d.gameType==='flood_full' ? '💧 Flood — Evacuation & Rescue'
                      : (LOC_NAMES[d.location]||'');
      this.add.text(cx,104,locLabel,{fontFamily:'monospace',fontSize:13,fill:'#00bfff',letterSpacing:3}).setOrigin(0.5);
    }

    this.add.text(cx,130,'YOUR SCORE',{fontFamily:'monospace',fontSize:11,fill:'#555555',letterSpacing:3}).setOrigin(0.5);
    const scoreColor=died?'#ff6666':'#00ff88';
    const scoreNum=this.add.text(cx,168,'0',{fontFamily:'monospace',fontSize:60,fontStyle:'bold',fill:scoreColor,stroke:died?'#880000':'#008840',strokeThickness:3}).setOrigin(0.5);
    let disp=0;
    this.tweens.add({targets:{v:0},v:d.score,duration:1200,ease:'Sine.Out',onUpdate:(tw,t)=>{ const v=Math.floor(t.v); if(v!==disp){disp=v;scoreNum.setText(v.toString());} }});

    let grade,gcol;
    if(died){ grade='Practice DROP · COVER · HOLD!'; gcol='#ff8844'; }
    else if(d.score>=1400){ grade='⭐⭐⭐ EXPERT SURVIVOR!'; gcol='#ffd700'; }
    else if(d.score>=900){ grade='⭐⭐ GREAT RESPONSE!'; gcol='#00ff88'; }
    else { grade='⭐ GOOD START — Keep Practicing!'; gcol='#00bfff'; }
    this.add.text(cx,232,grade,{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:gcol}).setOrigin(0.5);

    const rowY=262;
    const rows=died
      ?[['Tasks Completed',`${d.raw}`],['Time Bonus','0 — game over'],['TOTAL',`${d.score}`]]
      : (d.gameType==='flood'||d.gameType==='flood_full')
        ? d.gameType==='flood_full'
          ?[['Level 1 — Building Climb',`${d.floodScore||0}`],['Level 2 — Boat Rescue',`${d.boatScore||0}`],['Survivors',`${d.delivered||0}/5`],['Time Bonus',`+${d.timeBonus}`],['TOTAL',`${d.score}`]]
          :[['Climb Score',`${d.raw}`],['Time Bonus',`+${d.timeBonus}`],['TOTAL',`${d.score}`]]
      : d.gameType==='tsunami'
        ?[['Climb Score',`${d.raw}`],['Height Bonus',`+${d.heightBonus||0}`],['Time Bonus',`+${d.timeBonus}`],['Escape Bonus',`+${d.escapeBonus||0}`],['TOTAL',`${d.score}`]]
      : d.gameType==='cyclone_full'
        ?[['Level 1 — Secure House',`${d.cycloneScore||0}`],['Level 2 — Rescue Score',`${d.rescueScore||0}`],['Survivors Delivered',`${d.delivered||0}/4`],['Time Bonus',`+${d.timeBonus}`],['TOTAL',`${d.score}`]]
      : d.gameType==='cyclone'
        ?[['Tasks Secured',`${d.raw}`],['All Tasks Bonus','+200'],['Time Bonus',`+${d.timeBonus}`],['Shelter Bonus',`+${d.survBonus}`],['TOTAL',`${d.score}`]]
      : (d.gameType==='fire_full')
        ?[['Fire Score (Lvl 1)',`${d.fireScore||0}`],['Smoke Score (Lvl 2)',`${d.smokeScore||0}`],['Time Bonus',`+${d.timeBonus}`],['O₂+Crawl Bonus',`+${d.survBonus}`],['TOTAL',`${d.score}`]]
      : d.gameType==='fire'
        ?[['Fires Extinguished',`${d.raw}`],['Time Bonus',`+${d.timeBonus}`],['Escape Bonus',`+${d.survBonus}`],['TOTAL',`${d.score}`]]
        :[['Cover Bonus','+600'],['No-hit Bonus',`+${d.survBonus?400:0}`],['Time Bonus',`+${d.timeBonus}`],['TOTAL',`${d.score}`]];
    const divG=this.add.graphics();
    divG.lineStyle(1,died?0x331111:0x112211);
    divG.lineBetween(cx-200,rowY-5,cx+200,rowY-5);
    rows.forEach(([k,v],i)=>{
      const isTotal=k==='TOTAL';
      this.add.text(cx-195,rowY+i*26,k,{fontFamily:'monospace',fontSize:isTotal?13:11,fontStyle:isTotal?'bold':'normal',fill:isTotal?'#ffffff':'#888888'}).setOrigin(0,0.5);
      this.add.text(cx+195,rowY+i*26,v,{fontFamily:'monospace',fontSize:isTotal?14:12,fontStyle:'bold',fill:isTotal?'#ffd700':scoreColor}).setOrigin(1,0.5);
      if(i<rows.length-1) divG.lineBetween(cx-195,rowY+i*26+13,cx+195,rowY+i*26+13);
    });

    if(died){
      const tipBg=this.add.graphics();
      const tipY=rowY+rows.length*26+10;
      tipBg.fillStyle(0x220000,1); tipBg.fillRoundedRect(cx-200,tipY,400,38,8);
      tipBg.lineStyle(1,0x882222); tipBg.strokeRoundedRect(cx-200,tipY,400,38,8);
      this.add.text(cx,tipY+19,'💡 Press S near a desk BEFORE debris falls!',{fontFamily:'monospace',fontSize:11,fill:'#ffaa88'}).setOrigin(0.5);
    }

    const btnY=H-62;
    const paG=this.add.graphics();
    paG.fillGradientStyle(died?0xff6644:0x00ff88,died?0xff6644:0x00ff88,died?0xcc2200:0x00bfff,died?0xcc2200:0x00bfff,1);
    paG.fillRoundedRect(cx-195,btnY,178,42,21);
    const paTxt=this.add.text(cx-106,btnY+21,'▶ PLAY AGAIN',{fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#000'}).setOrigin(0.5).setInteractive({useHandCursor:true});
    paTxt.on('pointerdown',()=>{
      SFX.stopAmbient();
      this.cameras.main.fade(400,0,0,0);
      this.time.delayedCall(400,()=>{
        if(d.gameType==='fire'||d.gameType==='fire_full'){
          this.scene.start('FireInstructions');
        } else if(d.gameType==='cyclone'||d.gameType==='cyclone_full'){
          this.scene.start('CycloneInstructions');
        } else if(d.gameType==='tsunami'){
          this.scene.start('TsunamiInstructions');
        } else if(d.gameType==='flood'||d.gameType==='flood_full'){
          this.scene.start('FloodInstructions');
        } else {
          this.scene.start('Instructions',{location:LOCATIONS[Math.floor(Math.random()*LOCATIONS.length)]});
        }
      });
    });

    const hallG=this.add.graphics();
    hallG.fillStyle(0x1a2233,1); hallG.fillRoundedRect(cx+17,btnY,178,42,21);
    hallG.lineStyle(2,0x4488cc); hallG.strokeRoundedRect(cx+17,btnY,178,42,21);
    const hallTxt=this.add.text(cx+106,btnY+21,'⬅ SELECTION HALL',{fontFamily:'monospace',fontSize:12,fontStyle:'bold',fill:'#ffffff'}).setOrigin(0.5).setInteractive({useHandCursor:true});
    hallTxt.on('pointerdown',()=>{
      SFX.stopAmbient();
      this.cameras.main.fade(400,0,0,0);
      this.time.delayedCall(400,()=>this.scene.start('Hall'));
    });

    if(!died&&d.score>=900){
      for(let i=0;i<25;i++) this.time.delayedCall(i*90,()=>{
        const px=Phaser.Math.Between(0,W),py=Phaser.Math.Between(0,H/2);
        const colors=[0xffd700,0x00ff88,0xff6b35,0x00bfff,0xff6b9d];
        const star=this.add.image(px,py,'star_icon').setDisplaySize(18,18).setTint(colors[Phaser.Math.Between(0,4)]).setDepth(20);
        this.tweens.add({targets:star,y:py+80,alpha:0,duration:1300,onComplete:()=>star.destroy()});
      });
    }
  }
}
// MOBILE INPUT
// ─────────────────────────────────────────────────────────────────────────────
window._joyX=0; window._joyY=0; window._mJump=false; window._mAction=false; window._mSprint=false; window._mBack=false;

function setupMobile(scene){
  const jBase=document.getElementById('joyBase');
  const jKnob=document.getElementById('joyKnob');
  let jCenter={x:0,y:0};

  jBase.ontouchstart=e=>{
    e.preventDefault(); SFX.ensure();
    const r=jBase.getBoundingClientRect();
    jCenter={x:r.left+r.width/2,y:r.top+r.height/2};
  };
  jBase.ontouchmove=e=>{
    e.preventDefault();
    const t=e.touches[0];
    const dx=t.clientX-jCenter.x, dy=t.clientY-jCenter.y;
    const dist=Math.min(Math.sqrt(dx*dx+dy*dy),38);
    const ang=Math.atan2(dy,dx);
    window._joyX=(dist/38)*Math.cos(ang);
    window._joyY=(dist/38)*Math.sin(ang);
    jKnob.style.transform=`translate(calc(-50% + ${Math.cos(ang)*dist}px),calc(-50% + ${Math.sin(ang)*dist}px))`;
  };
  jBase.ontouchend=e=>{
    e.preventDefault(); window._joyX=0; window._joyY=0;
    jKnob.style.transform='translate(-50%,-50%)';
  };

  document.getElementById('mJump').ontouchstart=e=>{ e.preventDefault(); SFX.ensure(); window._mJump=true; };
  document.getElementById('mJump').ontouchend=e=>{ e.preventDefault(); window._mJump=false; };
  document.getElementById('mAction').ontouchstart=e=>{ e.preventDefault(); SFX.ensure(); window._mAction=true; };
  document.getElementById('mAction').ontouchend=e=>{ e.preventDefault(); };
  document.getElementById('mSprint').ontouchstart=e=>{ e.preventDefault(); SFX.ensure(); window._mSprint=true; };
  document.getElementById('mSprint').ontouchend=e=>{ e.preventDefault(); window._mSprint=false; };
  document.getElementById('mBack').ontouchstart=e=>{
    e.preventDefault(); SFX.ensure();
    scene.cameras.main.fade(400,0,0,0);
    scene.time.delayedCall(400,()=>scene.scene.start('Hall'));
  };
}

