<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>ResQVerse - Disaster Preparedness</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { background:#0a0010; overflow:hidden; font-family:'Segoe UI',sans-serif; }
#game-container { position:relative; width:100vw; height:100vh; display:flex; align-items:center; justify-content:flex-start; }
canvas { display:block; image-rendering:pixelated; }

/* Cross button */
#crossBtn {
  position:fixed; top:16px; right:16px; z-index:999;
  width:42px; height:42px; border-radius:50%;
  background:rgba(220,50,50,0.25); border:2px solid rgba(220,50,50,0.6);
  color:#ff6666; font-size:18px; font-weight:900; cursor:pointer;
  display:none; align-items:center; justify-content:center;
  backdrop-filter:blur(8px); transition:all 0.2s;
}
#crossBtn:hover { background:rgba(220,50,50,0.5); transform:scale(1.1); }

/* Mobile controls */
#mobile-ui {
  position:fixed; bottom:0; left:0; right:0; z-index:500;
  display:none; padding:16px; pointer-events:none;
}
@media(max-width:768px),(pointer:coarse){ #mobile-ui{ display:block; } }

.joy-wrap { position:absolute; bottom:20px; left:20px; pointer-events:all; }
.joy-base {
  width:100px; height:100px; border-radius:50%;
  background:rgba(255,255,255,0.12); border:2px solid rgba(255,255,255,0.3);
  position:relative; touch-action:none;
}
.joy-knob {
  width:40px; height:40px; border-radius:50%;
  background:rgba(255,255,255,0.55); border:2px solid white;
  position:absolute; top:50%; left:50%;
  transform:translate(-50%,-50%); pointer-events:none;
}
.action-pad { position:absolute; bottom:20px; right:16px; display:grid; grid-template-columns:1fr 1fr; gap:10px; pointer-events:all; }
.act-btn {
  width:58px; height:58px; border-radius:50%; border:none; cursor:pointer;
  font-size:11px; font-weight:800; color:#fff; letter-spacing:0.5px;
  text-transform:uppercase; backdrop-filter:blur(6px); touch-action:manipulation;
}
.btn-jump { background:rgba(0,180,255,0.55); border:2px solid #00b4ff; }
.btn-action { background:rgba(255,200,0,0.55); border:2px solid #ffc800; color:#222; }
.btn-sprint { background:rgba(255,100,40,0.55); border:2px solid #ff6428; }
.btn-back { background:rgba(200,50,200,0.55); border:2px solid #c832c8; }
</style>
</head>
<body>
<div id="game-container">
  <button id="crossBtn" onclick="window.location.href='/dashboard'">✕</button>
  <div id="mobile-ui">
    <div class="joy-wrap">
      <div class="joy-base" id="joyBase"><div class="joy-knob" id="joyKnob"></div></div>
    </div>
    <div class="action-pad">
      <button class="act-btn btn-jump" id="mJump">JUMP</button>
      <button class="act-btn btn-action" id="mAction">E</button>
      <button class="act-btn btn-sprint" id="mSprint">RUN</button>
      <button class="act-btn btn-back" id="mBack">BACK</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/phaser/3.60.0/phaser.min.js"></script>
<script>
// ─────────────────────────────────────────────────────────────────────────────
// PIXEL ART GENERATOR — draws all sprites/tiles onto canvases, exported as keys
// ─────────────────────────────────────────────────────────────────────────────
const GFX = {
  // Color palettes
  PAL:{
    skin:'#f4c08c', skinDark:'#d4956c', hair:'#3a2010',
    shirt:'#4488cc', pants:'#334488', shoe:'#222244',
    red:'#e63030', green:'#30c030', blue:'#3080e0',
    yellow:'#f0c020', orange:'#f07020', purple:'#9030c0',
    white:'#f8f8f8', black:'#101010', gray:'#808080', lgray:'#c0c0c0',
    brown:'#8b5a2b', dbrown:'#5a3010', wood:'#c8a060', dwood:'#8b6030',
    brick:'#c06040', dbrick:'#804030', grass:'#40b040', dgrass:'#208020',
    sky:'#87ceeb', stone:'#909090', dstone:'#606060',
    gold:'#ffd700', teal:'#00c0c0', pink:'#f080c0',
  },

  // Draw a single pixel
  px(ctx, x, y, color, s=2){ ctx.fillStyle=color; ctx.fillRect(x*s,y*s,s,s); },

  // ── PLAYER CHARACTER (24×40 @ 2x = 48×80 canvas) ──
  drawPlayer(ctx, pose='idle0'){
    const p = this.PAL;
    const S = 3; // pixel scale — 3px per game-pixel gives cleaner look
    ctx.clearRect(0, 0, 48, 80);

    // Helper: fill a game-pixel at (gx, gy) with color c
    const px = (gx, gy, c) => { ctx.fillStyle = c; ctx.fillRect(gx*S, gy*S, S, S); };
    // Fill a rectangle from (x1,y1) to (x2,y2) inclusive
    const fill = (x1, y1, x2, y2, c) => {
      for(let y=y1; y<=y2; y++) for(let x=x1; x<=x2; x++) px(x, y, c);
    };

    // ── SPRITE IS 12w × 22h game-pixels @ 3x = 36×66px on canvas ──
    // We draw everything relative to Y=0 at top of head.
    // Canvas is 48×80 but we only use ~36×66 so there's padding.
    // Center X offset = 1 (so sprite is centered in 14px width)
    const OX = 1; // horizontal offset

    const isCrouch = pose === 'crouch';
    const isJump   = pose === 'jump';
    const isWalk   = pose.startsWith('walk');
    const isIdle   = pose.startsWith('idle');

    // ── SHARED DRAWING HELPERS ──────────────────────────────────────────────
    // Draw the head at headY (top of hair)
    const drawHead = (headY, expression='normal') => {
      // Hair — flat top, 6px wide
      fill(OX+3, headY,   OX+8, headY,   p.hair);
      fill(OX+2, headY+1, OX+9, headY+1, p.hair);
      // Face skin
      fill(OX+2, headY+2, OX+9, headY+5, p.skin);
      fill(OX+3, headY+6, OX+8, headY+6, p.skin);
      // Ear nubs
      px(OX+1, headY+3, p.skin);
      px(OX+10,headY+3, p.skin);
      // Eyes (white + pupil)
      fill(OX+3, headY+3, OX+4, headY+4, '#ffffff');
      fill(OX+7, headY+3, OX+8, headY+4, '#ffffff');
      px(OX+4, headY+4, '#222233');
      px(OX+7, headY+4, '#222233');
      // Eyebrows
      fill(OX+3, headY+2, OX+4, headY+2, p.hair);
      fill(OX+7, headY+2, OX+8, headY+2, p.hair);
      // Nose
      px(OX+6, headY+5, p.skinDark);
      // Mouth
      if(expression === 'smile'){
        px(OX+4, headY+6, p.skinDark);
        fill(OX+5, headY+6, OX+7, headY+6, p.red);
        px(OX+8, headY+6, p.skinDark);
      } else if(expression === 'open'){
        fill(OX+5, headY+5, OX+7, headY+6, '#cc2222');
        px(OX+5, headY+6, '#222222'); px(OX+7, headY+6, '#222222');
      } else if(expression === 'determined'){
        fill(OX+4, headY+6, OX+8, headY+6, p.skinDark);
        // Stern brows
        px(OX+4, headY+2, p.hair); px(OX+8, headY+2, p.hair);
      } else {
        // neutral small smile
        px(OX+4, headY+6, p.skinDark);
        px(OX+8, headY+6, p.skinDark);
      }
    };

    // Draw torso at bodyY (top of body)
    const drawBody = (bodyY) => {
      // Shirt body — 8px wide, 6px tall
      fill(OX+2, bodyY,   OX+9, bodyY+5, p.shirt);
      // Collar V
      px(OX+5, bodyY,   '#ffffff');
      px(OX+6, bodyY,   '#ffffff');
      px(OX+5, bodyY+1, '#ffffff');
      // Shirt shading (right side darker)
      fill(OX+9, bodyY, OX+9, bodyY+5, '#3366aa');
      // Belt
      fill(OX+2, bodyY+6, OX+9, bodyY+6, p.brown);
      px(OX+5, bodyY+6, '#ccaa00');
      px(OX+6, bodyY+6, '#ccaa00');
    };

    // Draw a straight leg (thigh+shin) at column x, starting at startY, length len, with shoe
    const drawLeg = (x, startY, len, shoeX) => {
      fill(x, startY, x+1, startY+len-1, p.pants);
      // Shoe
      fill(shoeX, startY+len, shoeX+2, startY+len, p.shoe);
      fill(shoeX, startY+len+1, shoeX+1, startY+len+1, p.shoe);
    };

    // Draw arm at side (left or right)
    const drawArm = (side, bodyY, swing) => {
      // side: 'left'=x at OX+1, 'right'=x at OX+10
      const ax = side==='left' ? OX+1 : OX+10;
      const ay = bodyY;
      fill(ax, ay+1, ax, ay+4, p.shirt);
      // Hand
      px(ax, ay+5+Math.abs(swing/3|0), p.skin);
    };

    // ── POSES ──────────────────────────────────────────────────────────────

    if(isCrouch){
      // Head lower, body compressed, knees bent out
      drawHead(1, 'determined');
      // Body compressed 1px lower
      fill(OX+2, 8, OX+9, 12, p.shirt);
      fill(OX+2, 13, OX+9, 13, p.brown); // belt
      px(OX+5,13,'#ccaa00'); px(OX+6,13,'#ccaa00');
      // Arms tucked
      fill(OX+1, 8, OX+1, 11, p.shirt); px(OX+1, 12, p.skin);
      fill(OX+10,8, OX+10,11, p.shirt); px(OX+10,12, p.skin);
      // Thighs angled out (knees up)
      fill(OX+2, 14, OX+3, 16, p.pants);
      fill(OX+8, 14, OX+9, 16, p.pants);
      // Shins down
      fill(OX+2, 17, OX+3, 18, p.pants);
      fill(OX+8, 17, OX+9, 18, p.pants);
      // Flat shoes
      fill(OX+1, 19, OX+4, 19, p.shoe);
      fill(OX+7, 19, OX+10,19, p.shoe);
      return;
    }

    if(isJump){
      drawHead(0, 'open');
      drawBody(7);
      // Arms raised
      fill(OX+1, 5, OX+1, 8, p.shirt); px(OX+1, 4, p.skin);
      fill(OX+10,5, OX+10,8, p.shirt); px(OX+10,4, p.skin);
      // Legs bent up
      fill(OX+2, 14, OX+3, 16, p.pants);
      fill(OX+8, 14, OX+9, 16, p.pants);
      fill(OX+1, 17, OX+3, 18, p.pants);
      fill(OX+8, 17, OX+10,18, p.pants);
      fill(OX+1, 19, OX+3, 19, p.shoe);
      fill(OX+8, 19, OX+10,19, p.shoe);
      return;
    }

    // ── WALK & IDLE ──
    // Walk frames: 8 frames of clean leg alternation
    // Each frame: {lSwing, rSwing, armSwing, bodyBob}
    //   lSwing/rSwing: how many pixels the leg swings (+forward, -back)
    //   legs always stay attached — no floating
    const walkData = [
      {ls: 0, rs: 0, as: 0, bb: 0},  // 0 neutral
      {ls: 1, rs:-1, as: 2, bb: 1},  // 1 left forward
      {ls: 2, rs:-2, as: 3, bb: 1},  // 2 left full forward
      {ls: 1, rs:-1, as: 2, bb: 0},  // 3 passing
      {ls: 0, rs: 0, as: 0, bb: 0},  // 4 neutral
      {ls:-1, rs: 1, as:-2, bb: 1},  // 5 right forward
      {ls:-2, rs: 2, as:-3, bb: 1},  // 6 right full forward
      {ls:-1, rs: 1, as:-2, bb: 0},  // 7 passing
    ];

    let wd;
    if(isWalk){
      wd = walkData[parseInt(pose.replace('walk','')) % 8];
    } else {
      // idle — very slight breathe
      const iF = parseInt(pose.replace('idle','')) % 2;
      wd = {ls:0, rs:0, as:0, bb: iF===0 ? 0 : 1};
    }

    const bb = wd.bb; // body bob (0 or 1)

    // Head
    drawHead(bb, isIdle ? 'smile' : 'normal');

    // Body
    drawBody(7 + bb);

    // Arms — swing with walk
    const armY = 8 + bb;
    // Left arm (swings with right leg = -wd.as)
    const laX = OX+1;
    fill(laX, armY, laX, armY+3, p.shirt);
    px(laX, armY + 4 + (wd.as < 0 ? 1 : 0), p.skin);
    // Right arm
    const raX = OX+10;
    fill(raX, armY, raX, armY+3, p.shirt);
    px(raX, armY + 4 + (wd.as > 0 ? 1 : 0), p.skin);

    // Legs — clean column-based, no floating
    // Left leg (columns OX+2, OX+3)
    const legTop = 14 + bb;
    const legLen = 4; // thigh length
    const shinLen = 3;

    // Left thigh
    const lThighX = OX+2;
    const lThighEndY = legTop + legLen + (wd.ls < 0 ? 1 : 0);
    fill(lThighX, legTop, lThighX+1, lThighEndY, p.pants);
    // Left shin — hangs from thigh end
    const lShinX = lThighX + (wd.ls > 0 ? 1 : wd.ls < 0 ? -1 : 0);
    fill(Math.max(OX,lShinX), lThighEndY+1, Math.max(OX,lShinX)+1, lThighEndY+shinLen, p.pants);
    // Left shoe
    const lShoeX = Math.max(OX, lShinX - 1);
    fill(lShoeX, lThighEndY+shinLen+1, lShoeX+2, lThighEndY+shinLen+1, p.shoe);

    // Right thigh
    const rThighX = OX+7;
    const rThighEndY = legTop + legLen + (wd.rs < 0 ? 1 : 0);
    fill(rThighX, legTop, rThighX+1, rThighEndY, p.pants);
    // Right shin
    const rShinX = rThighX + (wd.rs > 0 ? 1 : wd.rs < 0 ? -1 : 0);
    fill(Math.min(OX+11,rShinX), rThighEndY+1, Math.min(OX+11,rShinX)+1, rThighEndY+shinLen, p.pants);
    // Right shoe
    const rShoeX = Math.min(OX+9, rShinX - 1);
    fill(rShoeX, rThighEndY+shinLen+1, rShoeX+2, rThighEndY+shinLen+1, p.shoe);
  },

  // ── TILES 32×32 ──
  drawFloor(ctx, type='stone'){
    const p=this.PAL, px=(x,y,c)=>this.px(ctx,x,y,c,2);
    const base = type==='wood'?p.wood:type==='grass'?p.grass:type==='marble'?'#e8e0d0':p.stone;
    const dark = type==='wood'?p.dwood:type==='grass'?p.dgrass:type==='marble'?'#c8c0b0':p.dstone;
    for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,base);
    if(type==='stone'||type==='marble'){
      // Grid lines
      for(let i=0;i<16;i+=8){ for(let j=0;j<16;j++) px(j,i,dark); for(let j=0;j<16;j++) px(i,j,dark); }
    } else if(type==='wood'){
      for(let y=0;y<16;y+=4) for(let x=0;x<16;x++) px(x,y,dark);
      for(let y=0;y<16;y++) px(Math.floor(y/4)%2===0?8:0,y,dark);
    } else if(type==='grass'){
      for(let x=0;x<16;x++) px(x,0,p.dgrass);
      for(let x=1;x<16;x+=3) px(x,1,'#60d060');
    }
  },

  drawWall(ctx, type='brick'){
    const p=this.PAL, px=(x,y,c)=>this.px(ctx,x,y,c,2);
    if(type==='brick'){
      for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,p.brick);
      for(let y=0;y<16;y+=4){
        for(let x=0;x<16;x++) px(x,y,p.dbrick);
        const off=Math.floor(y/4)%2===0?0:4;
        for(let yy=y;yy<y+4;yy++) px(off,yy,p.dbrick); if(off+8<16) for(let yy=y;yy<y+4;yy++) px(off+8,yy,p.dbrick);
      }
    } else if(type==='panel'){
      for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,'#c8d8e8');
      for(let x=0;x<16;x++){ px(x,0,'#a0b8c8'); px(x,15,'#a0b8c8'); }
      for(let y=0;y<16;y++){ px(0,y,'#a0b8c8'); px(15,y,'#a0b8c8'); }
    } else if(type==='wallpaper'){
      for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,'#f0e0d0');
      for(let y=2;y<16;y+=4) for(let x=2;x<16;x+=4){ px(x,y,'#e0a080'); px(x+1,y,'#e0a080'); }
    } else if(type==='dark'){
      for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,'#301848');
      for(let y=0;y<16;y+=4) for(let x=0;x<16;x++) px(x,y,'#201030');
      for(let x=2;x<16;x+=6) for(let y=0;y<16;y++) px(x,y,'#402060');
    }
  },

  drawCeiling(ctx, color='#d0c8b8'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,color);
    for(let x=0;x<16;x++){ px(x,15,'#b0a898'); }
  },

  // ── PORTAL DOOR ──
  drawPortal(ctx, color, available=true){
    const p=this.PAL, px=(x,y,c)=>this.px(ctx,x,y,c,2);
    // Frame
    const fc = available?color:'#444444';
    for(let y=0;y<28;y++){ px(0,y,fc); px(1,y,fc); px(14,y,fc); px(15,y,fc); }
    for(let x=0;x<16;x++){ px(x,0,fc); px(x,1,fc); }
    // Door fill
    const bg = available?this._lighten(color,80):'#222222';
    for(let y=2;y<28;y++) for(let x=2;x<14;x++) px(x,y, available?this._portal(x,y,color):bg);
    // Handle
    if(available) px(11,16,p.gold);
  },
  _portal(x,y,hex){
    const r=parseInt(hex.slice(1,3),16), g=parseInt(hex.slice(3,5),16), b=parseInt(hex.slice(5,7),16);
    const noise=Math.sin(x*0.8+y*0.5)*30;
    return `rgb(${Math.min(255,r+noise|0)},${Math.min(255,g+noise|0)},${Math.min(255,b+noise|0)})`;
  },
  _lighten(hex,amt){ const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16); return `rgb(${Math.min(255,r+amt)},${Math.min(255,g+amt)},${Math.min(255,b+amt)})`; },

  // ── FURNITURE ──
  drawDesk(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let x=0;x<16;x++) for(let y=0;y<3;y++) px(x,y,'#c8a060');// top
    for(let x=0;x<16;x++) px(x,3,'#a07840');
    px(0,4,'#806030'); px(0,5,'#806030'); px(0,6,'#806030');
    px(15,4,'#806030'); px(15,5,'#806030'); px(15,6,'#806030');
    px(0,7,'#604820'); px(15,7,'#604820');
  },
  drawShelf(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,'#a07840');
    for(let y=0;y<16;y+=5) for(let x=0;x<16;x++) px(x,y,'#806030');
    // Books
    const bc=['#e03030','#3080e0','#30c030','#f0c020','#c030c0'];
    let bx=1;
    bc.forEach((c,i)=>{ for(let y=1;y<5;y++) px(bx+i*3,y,c); if(bx+i*3+1<16) for(let y=1;y<5;y++) px(bx+i*3+1,c);});
  },
  drawSofa(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    const c='#e05080', dark='#b03060';
    for(let x=0;x<16;x++) for(let y=4;y<10;y++) px(x,y,c);
    for(let x=0;x<3;x++) for(let y=0;y<10;y++) px(x,y,c);
    for(let x=13;x<16;x++) for(let y=0;y<10;y++) px(x,y,c);
    for(let x=0;x<16;x++) px(x,10,dark); for(let x=0;x<16;x++) px(x,11,'#604020');
    px(2,12,'#604020'); px(13,12,'#604020');
  },
  drawTable(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let x=0;x<16;x++) for(let y=0;y<2;y++) px(x,y,'#d4b080');
    for(let x=0;x<16;x++) px(x,2,'#b08040');
    px(2,3,'#907030'); px(2,4,'#907030'); px(2,5,'#907030');
    px(13,3,'#907030'); px(13,4,'#907030'); px(13,5,'#907030');
  },
  drawChair(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    const colors=['#4488cc','#cc4444','#44cc44','#cc8844'];
    const c=colors[Math.floor(Math.random()*colors.length)];
    for(let x=2;x<14;x++) for(let y=5;y<9;y++) px(x,y,c);
    for(let x=2;x<14;x++) for(let y=0;y<5;y++) px(x,y,c);
    px(2,9,'#404040'); px(13,9,'#404040');
    px(2,10,'#404040'); px(13,10,'#404040');
  },
  drawLocker(ctx, color='#44aacc'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<16;y++) for(let x=0;x<8;x++) px(x,y,color);
    for(let x=0;x<8;x++){ px(x,0,'#206080'); px(x,7,'#206080'); px(x,15,'#206080'); }
    for(let y=0;y<16;y++) px(7,y,'#206080');
    px(5,3,'#ffd700'); px(5,10,'#ffd700');
  },
  drawTV(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<12;y++) for(let x=0;x<16;x++) px(x,y,'#222222');
    for(let y=1;y<11;y++) for(let x=1;x<15;x++) px(x,y,'#001088');
    for(let y=1;y<4;y++) for(let x=1;x<8;x++) px(x,y,'#0020cc');
    px(7,12,'#444444'); px(8,12,'#444444');
    for(let x=4;x<12;x++) px(x,13,'#444444');
  },
  drawCurtain(ctx, color='#8b0000'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<16;y++) for(let x=0;x<8;x++) px(x,y,color);
    for(let y=0;y<16;y+=2) for(let x=0;x<8;x+=3) px(x,y,'#601010');
    for(let x=0;x<8;x++) px(x,0,'#ffd700');
  },
  drawDebris(ctx, color='#888888'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=2;y<6;y++) for(let x=2;x<6;x++) px(x,y,color);
    px(1,3,color); px(6,4,color); px(3,1,color); px(4,6,color);
    px(0,4,'#606060'); px(7,3,'#606060');
  },
  drawSafeZone(ctx, correct=true){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    const c=correct?'#00ff88':'#ff4444';
    // Glowing circle outline
    const pairs=[[8,1],[11,2],[13,4],[14,7],[14,9],[13,12],[11,14],[8,15],[5,15],[3,14],[2,12],[1,9],[1,7],[2,4],[4,2],[6,1]];
    pairs.forEach(([x,y])=>{ px(x,y,c); try{px(x-1,y,c+'88');}catch(e){} });
    ctx.globalAlpha=0.3; for(let y=5;y<12;y++) for(let x=5;x<12;x++) px(x,y,c);
    ctx.globalAlpha=1;
    const icon=correct?'✓':'✗';
    ctx.fillStyle=c; ctx.font='bold 14px Arial'; ctx.textAlign='center'; ctx.fillText(icon,16,20);
  },
  drawStar(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    const pts=[[3,0],[4,0],[4,1],[2,1],[2,2],[0,2],[0,3],[1,3],[0,4],[1,4],[2,5],[3,5],[4,6],[5,6],[6,5],[7,5],[8,4],[7,4],[8,3],[8,2],[6,2],[6,1],[5,1],[5,0]];
    pts.forEach(([x,y])=>px(x,y,'#ffd700'));
    for(let y=2;y<6;y++) for(let x=3;x<6;x++) px(x,y,'#ffd700');
  },
  drawParticle(ctx, color){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    px(1,0,color); px(0,1,color); px(1,1,color); px(2,1,color); px(1,2,color);
  },
  drawHallBg(ctx, w, h){
    // Grand hall background - marble floor, ornate walls
    const px=(x,y,c)=>{ ctx.fillStyle=c; ctx.fillRect(x,y,1,1); };
    // Gradient sky/ceiling
    for(let y=0;y<h*0.3;y++) for(let x=0;x<w;x++){
      const t=y/(h*0.3);
      const r=Math.floor(30+t*40), g=Math.floor(0+t*10), b=Math.floor(60+t*60);
      px(x,y,`rgb(${r},${g},${b})`);
    }
    // Floor
    for(let y=h*0.7;y<h;y++) for(let x=0;x<w;x++){
      const tile=Math.floor(x/40)+Math.floor((y-h*0.7)/40);
      px(x,y,tile%2===0?'#2a1a4a':'#1a0a3a');
    }
    // Mid walls
    for(let y=h*0.3;y<h*0.7;y++) for(let x=0;x<w;x++){
      px(x,y,'#1a0840');
    }
  },
  drawMonitor(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<9;y++) for(let x=0;x<14;x++) px(x,y,'#333333');
    for(let y=1;y<8;y++) for(let x=1;x<13;x++) px(x,y,'#003366');
    for(let y=1;y<4;y++) for(let x=1;x<7;x++) px(x,y,'#0055aa');
    px(6,9,'#555'); px(7,9,'#555');
    for(let x=3;x<11;x++) px(x,10,'#555');
  },
  drawStage(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<6;y++) for(let x=0;x<32;x++) px(x,y,'#5a3010');
    for(let x=0;x<32;x++) px(x,0,'#8b5a2b'); for(let x=0;x<32;x++) px(x,5,'#3a2008');
  },
  drawSeat(ctx, color='#6020a0'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=4;y<8;y++) for(let x=1;x<7;x++) px(x,y,color);
    for(let y=0;y<4;y++) for(let x=1;x<7;x++) px(x,y,color);
    px(2,8,'#222'); px(5,8,'#222');
  },
  drawPillar(ctx, color='#8800cc'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<32;y++) for(let x=1;x<7;x++) px(x,y,color);
    for(let y=0;y<32;y++){ px(1,y,'#ffffff22'); px(6,y,'#00000044'); }
    for(let x=0;x<8;x++){ px(x,0,color); px(x,1,color); px(x,30,color); px(x,31,color); }
  },
  drawSpotlight(ctx, color){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    ctx.globalAlpha=0.6;
    for(let y=0;y<16;y++) for(let x=0;x<8;x++){
      const d=Math.abs(x-4)/4; if(d+y/16<1.2) px(x,y,color);
    }
    ctx.globalAlpha=1;
  },

  // ── FIRE SPRITES ──────────────────────────────────────────────────────────
  // Animated fire tile (32×32) — frame 0..2
  drawFire(ctx, frame=0){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    ctx.clearRect(0,0,32,32);
    // Base glow
    const offsets=[[0,0],[1,-1],[-1,1]][frame%3];
    const ox=offsets[0], oy=offsets[1];
    // Outer flame (orange)
    [[4,14],[3,12],[4,10],[5,8],[6,6],[7,5],[8,4],[9,5],[10,6],[11,8],[12,10],[12,12],[11,14]].forEach(([x,y])=>px(x+ox,y+oy,'#ff6600'));
    // Mid flame (bright orange)
    [[5,13],[5,11],[6,9],[7,7],[8,6],[9,7],[10,9],[10,11],[10,13]].forEach(([x,y])=>px(x+ox,y+oy,'#ff9900'));
    // Inner flame (yellow)
    [[6,12],[6,10],[7,9],[8,8],[9,9],[9,11],[9,12]].forEach(([x,y])=>px(x,y,'#ffdd00'));
    // Core (white-hot)
    [[7,11],[8,10],[8,11]].forEach(([x,y])=>px(x,y,'#ffffff'));
    // Ember base
    for(let x=3;x<14;x++) px(x,15,'#cc3300');
    for(let x=2;x<15;x++) px(x,15+(frame%2),'#ff4400');
    // Sparks
    const sparks=[[2,8+frame],[13,6+frame],[5,3+(frame*2)%5]];
    sparks.forEach(([x,y])=>{ if(y>=0&&y<16) px(x,y,'#ffaa00'); });
  },

  // Fire extinguisher (16×28)
  drawExtinguisher(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    // Body (red cylinder)
    for(let y=4;y<22;y++) for(let x=2;x<10;x++) px(x,y,'#dd1111');
    // Shine
    for(let y=4;y<22;y++) px(3,y,'#ff6666');
    // Top cap
    for(let x=3;x<9;x++) px(x,3,'#cc0000');
    for(let x=4;x<8;x++) px(x,2,'#cc0000');
    px(5,1,'#cc0000'); px(6,1,'#cc0000');
    // Nozzle
    px(9,5,'#888888'); px(10,5,'#888888'); px(11,5,'#888888');
    px(11,4,'#888888'); px(12,4,'#aaaaaa');
    // Handle
    for(let x=3;x<9;x++) px(x,0,'#aaaaaa');
    // Label (white strip)
    for(let y=10;y<16;y++) for(let x=2;x<10;x++) px(x,y,'#ffffff');
    px(4,11,'#dd1111'); px(5,11,'#dd1111'); px(6,11,'#dd1111');
    px(5,12,'#dd1111'); px(5,13,'#dd1111');
    // Bottom
    for(let x=2;x<10;x++) px(x,22,'#aa0000');
    for(let x=3;x<9;x++) px(x,23,'#880000');
  },

  // Extinguisher spray (24×16) — frame 0..2
  drawSpray(ctx, frame=0){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    ctx.clearRect(0,0,24,16);
    const spread=[2,3,4][frame];
    for(let i=0;i<8+frame*2;i++){
      const x=i*1.2|0, y=8+Math.sin(i*0.8+frame)*spread|0;
      if(x<12&&y>=0&&y<16) px(x,y,'#aaeeff');
      if(x<12&&y+1<16) px(x,y+1,'#88ddff');
    }
    // CO2 cloud
    for(let cx2=8;cx2<12;cx2++) for(let cy=4;cy<12;cy++) px(cx2,cy,'#ddeeff');
  },

  // Fire smoke (32×16) drifting up
  drawSmoke(ctx, frame=0){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    ctx.clearRect(0,0,32,16);
    const offX=[0,1,-1][frame%3];
    [[6,12],[7,10],[6,8],[8,6],[7,4],[9,3],[8,2]].forEach(([x,y],i)=>{
      const a=Math.max(0.1,0.8-i*0.1);
      ctx.globalAlpha=a;
      px(x+offX,y,'#666666');
      if(i<4) px(x+offX+1,y,'#555555');
    });
    ctx.globalAlpha=1;
  },

  // Exit sign (40×16) green glowing
  drawExitSign(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<8;y++) for(let x=0;x<20;x++) px(x,y,'#004400');
    for(let y=0;y<8;y++) for(let x=0;x<20;x++){
      if(x===0||x===19||y===0||y===7) px(x,y,'#00ff44');
    }
    // E-X-I-T pixel letters
    [[1,2],[1,3],[1,4],[1,5],[1,6],[2,2],[3,2],[2,4],[3,4],[2,6],[3,6]].forEach(([x,y])=>px(x,y,'#00ff44'));
    [[5,2],[6,3],[7,4],[8,3],[9,2],[5,6],[9,6]].forEach(([x,y])=>px(x,y,'#00ff44'));
    [[11,2],[11,3],[11,4],[11,5],[11,6],[12,2],[13,2]].forEach(([x,y])=>px(x,y,'#00ff44'));
    [[15,2],[15,3],[15,4],[15,5],[15,6],[16,2],[17,2],[16,4],[17,4]].forEach(([x,y])=>px(x,y,'#00ff44'));
  },

  // Floor tile — office carpet (16×16)
  drawCarpet(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<16;y++) for(let x=0;x<16;x++) px(x,y,(x+y)%4===0?'#5533aa':'#4422aa');
    for(let i=0;i<16;i+=8){ for(let x=0;x<16;x++) px(x,i,'#3311aa'); for(let y=0;y<16;y++) px(i,y,'#3311aa'); }
  },

  // Crack / hazard on floor
  drawCrack(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    [[4,2],[5,3],[4,4],[5,5],[6,6],[5,7],[6,8],[7,9],[6,10],[7,11]].forEach(([x,y])=>px(x,y,'#333333'));
    [[5,2],[6,4],[5,6],[6,9],[7,10]].forEach(([x,y])=>px(x,y,'#ff4400'));
  },

  // Burning wall section (32×32)
  drawBurningWall(ctx, frame=0){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<16;y++) for(let x=0;x<16;x++){
      const dark=(x+y)%3===0;
      px(x,y,dark?'#441100':'#553300');
    }
    // Scorched marks
    [[2,2],[5,4],[10,3],[13,7],[8,8],[3,10],[12,11],[6,13]].forEach(([x,y])=>px(x,y,'#221100'));
    // Small fire licks at bottom
    [2,5,8,11,14].forEach(x=>{
      const h=2+frame%3;
      for(let y=16-h;y<16;y++) px(x,y,'#ff6600');
      px(x,15-h,'#ffdd00');
    });
  },

  // Large dense smoke cloud tile (32×32) for corridor
  drawSmokeCloud(ctx, frame=0, density=1){
    const S=2;
    ctx.clearRect(0,0,64,64);
    const offsets=[[0,0],[2,-1],[-1,2],[1,-2],[-2,1]];
    const off=offsets[frame%offsets.length];
    const cols=['#777777','#666666','#888888','#555555','#999999'];
    const positions=[
      [6,12],[8,8],[10,14],[4,10],[12,10],[7,6],[13,7],[5,14],[11,5],[9,11],
      [3,8],[14,12],[8,3],[12,4],[6,15],[10,7],[4,13],[13,3],[7,9],[11,13],
    ];
    positions.forEach(([x,y],i)=>{
      const a=density*(0.5+Math.sin(i+frame)*0.15);
      ctx.globalAlpha=Math.min(1,Math.max(0,a));
      ctx.fillStyle=cols[i%cols.length];
      ctx.fillRect((x+off[0])*S,(y+off[1])*S,S*2+density,S*2+density);
    });
    ctx.globalAlpha=1;
  },

  // Floor arrow (directional guide) 32×16
  drawArrow(ctx, color='#00ff88'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    [[4,3],[5,3],[10,3],[11,3],[12,2],[13,1],[14,0],[13,3],[14,4],[12,4],
     [4,4],[5,4],[6,4],[7,4],[8,4],[9,4],[10,4],
     [4,5],[5,5],[10,5],[11,5],[12,6],[13,7],[14,8],[13,5],[14,4]].forEach(([x,y])=>px(x,y,color));
  },

  // Smoke visibility meter bar (64×8)
  drawSmokeBar(ctx, pct=1){
    const S=2;
    ctx.clearRect(0,0,128,16);
    ctx.fillStyle='#222222'; ctx.fillRect(0,0,128,16);
    ctx.fillStyle='#444444'; ctx.fillRect(1,1,126,14);
    const w=Math.round(124*pct);
    const col = pct>0.5?'#88ff44': pct>0.25?'#ffaa00':'#ff3300';
    ctx.fillStyle=col; ctx.fillRect(2,2,w,12);
    ctx.strokeStyle='#666'; ctx.lineWidth=1; ctx.strokeRect(0,0,128,16);
  },

  // Filing cabinet / office furniture (16×24) — for office floor decor
  drawFiling(ctx, color='#777777'){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<12;y++) for(let x=0;x<8;x++) px(x,y,color);
    for(let x=0;x<8;x++){ px(x,0,'#999'); px(x,5,'#555'); px(x,6,'#555'); px(x,11,'#555'); }
    px(5,2,'#ffdd00'); px(5,7,'#ffdd00');
  },

  // ── CYCLONE SPRITES ──────────────────────────────────────────────────────
  // House exterior (80×64) — warm colours, windows and door visible
  drawHouseExterior(ctx){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    // Walls
    for(let y=8;y<32;y++) for(let x=0;x<40;x++) px(x,y,'#e8c89a');
    // Roof
    [[20,0],[18,1],[16,2],[14,3],[12,4],[10,5],[8,6],[6,7],[4,8],[2,9],[0,10]].forEach(([x,y])=>{
      for(let i=x;i<=40-x;i++) px(i,y,'#c0522a');
    });
    // Door (center bottom)
    for(let y=22;y<32;y++) for(let x=16;x<24;x++) px(x,y,'#8b4513');
    px(23,27,'#ffd700'); // doorknob
    // Left window
    for(let y=12;y<20;y++) for(let x=4;x<12;x++) px(x,y,'#88ccff');
    for(let x=4;x<12;x++){ px(x,12,'#8b6914'); px(x,19,'#8b6914'); }
    for(let y=12;y<20;y++){ px(4,y,'#8b6914'); px(11,y,'#8b6914'); }
    px(8,12,'#8b6914'); for(let y=12;y<20;y++) px(8,y,'#8b6914');
    // Right window
    for(let y=12;y<20;y++) for(let x=28;x<36;x++) px(x,y,'#88ccff');
    for(let x=28;x<36;x++){ px(x,12,'#8b6914'); px(x,19,'#8b6914'); }
    for(let y=12;y<20;y++){ px(28,y,'#8b6914'); px(35,y,'#8b6914'); }
    px(32,12,'#8b6914'); for(let y=12;y<20;y++) px(32,y,'#8b6914');
    // Ground
    for(let x=0;x<40;x++) px(x,32,'#5a8a3a');
  },

  // Closed window icon (24×20)
  drawWindow(ctx, closed=true){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<10;y++) for(let x=0;x<12;x++) px(x,y,closed?'#885500':'#88ccff');
    for(let x=0;x<12;x++){ px(x,0,'#663300'); px(x,9,'#663300'); }
    for(let y=0;y<10;y++){ px(0,y,'#663300'); px(11,y,'#663300'); }
    for(let y=0;y<10;y++) px(6,y,'#663300');
    for(let x=0;x<12;x++) px(x,5,'#663300');
    if(closed) px(5,5,'#ffcc00');
  },

  // Closed door icon (24×32)
  drawDoor(ctx, closed=true){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    for(let y=0;y<16;y++) for(let x=0;x<12;x++) px(x,y,closed?'#7a4510':'#c87a40');
    for(let x=0;x<12;x++){ px(x,0,'#5a3000'); px(x,15,'#5a3000'); }
    for(let y=0;y<16;y++){ px(0,y,'#5a3000'); px(11,y,'#5a3000'); }
    px(9,8,closed?'#ffd700':'#888888');
  },

  // Gas pipeline valve (24×24)
  drawGasValve(ctx, closed=true){
    const px=(x,y,c)=>this.px(ctx,x,y,c,2);
    // Pipe horizontal
    for(let x=0;x<12;x++) for(let y=4;y<8;y++) px(x,y,'#777777');
    // Valve wheel
    for(let y=0;y<12;y++) for(let x=3;x<9;x++) px(x,y,closed?'#cc2200':'#228800');
    for(let x=3;x<9;x++){ px(x,0,closed?'#aa1100':'#116600'); px(x,11,closed?'#aa1100':'#116600'); }
    for(let y=0;y<12;y++){ px(3,y,closed?'#aa1100':'#116600'); px(8,y,closed?'#aa1100':'#116600'); }
    px(6,0,'#ffffff'); px(6,11,'#ffffff'); px(3,5,'#ffffff'); px(8,5,'#ffffff');
