      '⚠️  Touching rising water = instant game over',
    ];
    const tipBg=this.add.graphics();
    tipBg.fillStyle(0x0088ff,0.07); tipBg.fillRoundedRect(cx-215,192,430,148,8);
    tipBg.lineStyle(1,0x0088ff,0.25); tipBg.strokeRoundedRect(cx-215,192,430,148,8);
    tips.forEach((t,i)=>this.add.text(cx-200,202+i*20,t,{fontFamily:'monospace',fontSize:11,fill:'#88ccff'}));

    const btnG=this.add.graphics();
    btnG.fillGradientStyle(0x0088ff,0x0088ff,0x0044cc,0x0044cc,1);
    btnG.fillRoundedRect(cx-110,356,220,50,25);
    const btn=this.add.text(cx,381,'▶ EVACUATE!',{fontFamily:'monospace',fontSize:19,fontStyle:'bold',fill:'#ffffff'})
      .setOrigin(0.5).setInteractive({useHandCursor:true});
    btn.on('pointerdown',()=>{ SFX.alert(); this.cameras.main.fade(500,0,0,0); this.time.delayedCall(500,()=>this.scene.start('Tsunami')); });
    this.add.text(cx,420,'← Back to Hall',{fontFamily:'monospace',fontSize:12,fill:'#223344'})
      .setOrigin(0.5).setInteractive({useHandCursor:true})
      .on('pointerdown',()=>{ this.cameras.main.fade(400,0,0,0); this.time.delayedCall(400,()=>this.scene.start('Hall')); });
  }
}

// ═════════════════════════════════════════════════════════════════════════════
// █████████████████████████  TSUNAMI GAME  ████████████████████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  TsunamiScene — coastal evacuation platformer
//
//  LEVEL LAYOUT  (single scrolling scene, left→right climb):
//    Town ground (x 0-200)  →  cliffs (x 200-500)  →  hilltop safe zone (x 500+)
//    Multiple platforms at different heights to jump across
//
//  RISING WATER:
//    - Water level starts at bottom, rises steadily (8px/sec)
//    - Water speed increases every 20s (surge events triggered by siren)
//    - Touching water = game over
//    - Floating debris bobs on the surface — jump over them
//
//  OBJECTIVES:
//    - Simply reach the HILLTOP safe zone before water reaches it
//    - Bonus: reach faster = bigger time/height score
//
//  SCORING:
//    +heightReached * 3   how high you climbed (platforms bonus)
//    +timeLeft * 5        speed bonus
//    +500                 reaching the hilltop
// ═════════════════════════════════════════════════════════════════════════════
class TsunamiScene extends Phaser.Scene {
  constructor(){ super('Tsunami'); }

  create(){
    this.score       = 0;
    this.timeLeft    = 110;
    this.gameOver    = false;
    this.waterY      = H + 20;  // water surface y (decreasing = rising)
    this.waterSpeed  = 18;      // px per second rising speed
    this.surgeActive = false;
    this.waveFrame   = 0;
    this.floatDebris = [];
    this.highestY    = H;       // lowest Y player reached (highest ground)
    this.won         = false;

    const FY = H - 40;
    this.FLOOR_Y = FY;
    this.WORLD_H = H;

    this.buildCoastalTown(FY);

    // Player starts bottom-left
    this.player = new Player(this, 60, FY - 20, {
      speed:148, jumpForce:-410, canCrouch:false, canJump:true, gravity:620
    });
    this.player.addCollider(this.groundGroup);
    this.player.addCollider(this.platformGroup);

    this.buildHUD();
    this.buildWater();
    this.startSirenCycle();
    this.spawnFloatingDebris();

    // Countdown
    this.timerEvent = this.time.addEvent({delay:1000, repeat:109, callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.updateHUD();
      // Surge every 25s
      if(this.timeLeft%25===0) this.triggerSurge();
      if(this.timeLeft<=0) this.endGame(false,'Wave overtook you!');
    }});

    // Wave animation
    this.time.addEvent({delay:150, repeat:-1, callback:()=>{
      this.waveFrame=(this.waveFrame+1)%4;
      if(this.waterTiles) this.waterTiles.forEach(w=>w.setTexture(`wave_${this.waveFrame}`));
    }});

    this.phaseTxt = this.add.text(W/2,H/2,'',{
      fontFamily:'monospace',fontSize:26,fontStyle:'bold',
      fill:'#0088ff',stroke:'#000',strokeThickness:4,align:'center'
    }).setOrigin(0.5).setDepth(70).setVisible(false).setScrollFactor(0);

    this.notifTxt = this.add.text(W/2,H-132,'',{
      fontFamily:'monospace',fontSize:14,fontStyle:'bold',
      fill:'#88ddff',backgroundColor:'rgba(0,0,0,0.88)',padding:{x:12,y:6}
    }).setOrigin(0.5).setDepth(60).setVisible(false).setScrollFactor(0);

    setupMobile(this);
    const mJ=document.getElementById('mJump'); if(mJ) mJ.textContent='W/↑';
    const mS=document.getElementById('mSprint'); if(mS) mS.textContent='RUN';

    this.showBig('🌊 TSUNAMI!\nClimb to HIGH GROUND!','#0088ff');
  }

  // ── BUILD TOWN ────────────────────────────────────────────────────────────
  buildCoastalTown(FY){
    // Sky — clear dawn blue (false calm before wave)
    const bg = this.add.graphics();
    bg.fillGradientStyle(0x001a33,0x001a33,0x003366,0x002244,1);
    bg.fillRect(0,0,W,H);
    // Ocean horizon glow
    bg.fillStyle(0x0044aa,0.3); bg.fillEllipse(W/2,H,W*1.5,120);

    // Background buildings silhouettes
    [[30,FY-80,40],[100,FY-60,35],[240,FY-100,50],[340,FY-70,40],[550,FY-90,45],[680,FY-60,35]].forEach(([x,y,w])=>{
      bg.fillStyle(0x112233,0.8); bg.fillRect(x,y,w,FY-y);
      // Windows
      bg.fillStyle(0xffdd44,0.3);
      for(let wy=y+6;wy<FY-6;wy+=10) for(let wx=x+4;wx<x+w-4;wx+=8){
        if(Math.random()>0.5) bg.fillRect(wx,wy,5,6);
      }
    });

    // Ground — coastal road
    const gfx = this.add.graphics();
    gfx.fillStyle(0x444444,1); gfx.fillRect(0,FY,W,H-FY+40);
    gfx.fillStyle(0x333333,1); gfx.fillRect(0,FY,W,6);
    // Road markings
    for(let x=20;x<W;x+=40){ gfx.fillStyle(0xffdd00,0.4); gfx.fillRect(x,FY+10,20,4); }

    // Physics floor
    this.groundGroup = this.physics.add.staticGroup();
    const fb = this.add.rectangle(W/2,FY+16,W,32,0,0);
    this.physics.add.existing(fb,true); this.groundGroup.add(fb);
    this.platformGroup = this.physics.add.staticGroup();

    // ── PLATFORMS — building rooftops, cliff ledges, hilltop ──
    const platforms = [
      // {x, y, w, h, color, type}
      {x:150, y:FY-70,  w:80,  h:14, color:0x886644, type:'building roof'},
      {x:250, y:FY-50,  w:60,  h:12, color:0x776655, type:'low wall'},
      {x:330, y:FY-100, w:90,  h:14, color:0x998866, type:'building roof'},
      {x:420, y:FY-80,  w:70,  h:12, color:0xaaaaaa, type:'cliff ledge'},
      {x:490, y:FY-140, w:80,  h:14, color:0x999988, type:'cliff ledge'},
      {x:570, y:FY-110, w:65,  h:12, color:0xaab0aa, type:'cliff ledge'},
      {x:650, y:FY-170, w:85,  h:14, color:0x778877, type:'cliff ledge'},
      {x:735, y:FY-200, w:65,  h:12, color:0x668866, type:'upper cliff'},
    ];
    platforms.forEach(pd=>{
      this.add.rectangle(pd.x,pd.y,pd.w,pd.h,pd.color,0.95).setOrigin(0.5,1).setDepth(4);
      this.add.rectangle(pd.x,pd.y,pd.w-4,6,0x000000,0.15).setOrigin(0.5,1).setDepth(5);
      const pb=this.add.rectangle(pd.x,pd.y-pd.h/2,pd.w,pd.h/2,0,0).setOrigin(0.5);
      this.physics.add.existing(pb,true); this.platformGroup.add(pb);
    });

    // ── LADDERS on cliff faces ──
    [[200,FY-90],[350,FY-100],[470,FY-140],[600,FY-170]].forEach(([lx,ly])=>{
      for(let y=ly;y<FY-8;y+=16){
        this.add.image(lx,y,'ladder').setOrigin(0.5,0).setDisplaySize(16,16).setDepth(4);
      }
      // Ladder physics (thin static body)
      const lp=this.add.rectangle(lx,ly+((FY-ly)/2),(16),(FY-ly),0,0).setOrigin(0.5);
      // Ladders don't block — they're purely visual guides
    });

    // ── HILLTOP SAFE ZONE (rightmost top) ──
    this.add.image(W-60,FY-240,'hill').setOrigin(0.5,1).setDisplaySize(160,80).setDepth(4);
    // Hilltop physics platform
    const hp=this.add.rectangle(W-60,FY-240,140,16,0,0).setOrigin(0.5,1);
    this.physics.add.existing(hp,true); this.platformGroup.add(hp);
    // Safe zone glow + label
    const hglow=this.add.rectangle(W-60,FY-248,130,20,0x00ff88,0.18).setDepth(5);
    this.tweens.add({targets:hglow,alpha:{from:0.1,to:0.3},duration:900,yoyo:true,repeat:-1});
    this.add.text(W-60,FY-272,'🏔 HIGH GROUND',{fontFamily:'monospace',fontSize:11,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5).setDepth(6);
    this.hilltopZone={x:W-60, y:FY-248, w:130, h:30};

    // ── EVACUATION SIGNS on buildings ──
    [[80,FY-50],[270,FY-90],[450,FY-110]].forEach(([x,y])=>{
      this.add.image(x,y,'evac_sign').setDisplaySize(40,24).setDepth(5);
    });

    // ── SIRENS ──
    this.sirenSprites=[];
    [[50,FY-30],[300,FY-30],[550,FY-50]].forEach(([x,y])=>{
      const s=this.add.image(x,y,'siren_off').setDisplaySize(20,30).setDepth(5);
      this.sirenSprites.push(s);
    });

    // Street lamps (visual)
    [80,220,400,580,720].forEach(lx=>{
      this.add.rectangle(lx,FY-50,4,50,0x888888,0.8).setDepth(3);
      const lamp=this.add.circle(lx,FY-52,8,0xffffaa,0.9).setDepth(4);
      this.add.ellipse(lx,FY-44,30,16,0xffffaa,0.12).setDepth(3);
      this.tweens.add({targets:lamp,alpha:{from:0.7,to:1},duration:1000+lx,yoyo:true,repeat:-1});
    });
  }

  // ── WATER ────────────────────────────────────────────────────────────────
  buildWater(){
    // Water fill rectangle (graphics, redrawn each frame)
    this.waterGfx = this.add.graphics().setDepth(18).setScrollFactor(0);
    // Wave tile row (visual on top of water)
    this.waterTiles = [];
    for(let x=0;x<W;x+=96){
      const wt=this.add.image(x, this.waterY,'wave_0').setOrigin(0,1).setDisplaySize(96,48).setDepth(19).setScrollFactor(0);
      this.waterTiles.push(wt);
    }
  }

  updateWater(delta){
    // Rise
    this.waterY -= (this.waterSpeed * delta / 1000) * (this.surgeActive?2.5:1);
    this.waterY = Math.max(-100, this.waterY);

    // Redraw water body
    this.waterGfx.clear();
    this.waterGfx.fillStyle(0x0044cc,0.85);
    this.waterGfx.fillRect(0, this.waterY, W, H - this.waterY + 20);
    // Inner glow
    this.waterGfx.fillStyle(0x0066ee,0.3);
    this.waterGfx.fillRect(0, this.waterY+4, W, 20);

    // Move wave tiles
    this.waterTiles.forEach(wt=>{ wt.y = this.waterY; });

    // Animate floating debris on water
    this.floatDebris.forEach(d=>{
      if(!d.active) return;
      d.sprite.y = this.waterY - 4 + Math.sin(d.phase + Date.now()*0.002)*3;
      d.phase += 0.01;
      d.sprite.x -= 0.8; // drift left
      if(d.sprite.x < -30) d.sprite.x = W + 30;
    });

    // Player touching water?
    if(this.player && !this.gameOver && this.player.y >= this.waterY - 8){
      this.endGame(false,'Swept away by the wave!');
    }

    // Track highest point reached
    if(this.player && this.player.y < this.highestY){
      this.highestY = this.player.y;
    }

    // Water rising colour shifts darker blue
    const depth=Math.max(0,(H-this.waterY)/H);
    const r=Math.floor(0+depth*0);
    const g=Math.floor(44+depth*20);
    const b=Math.floor(180+depth*75);
    this.waterGfx.fillStyle(Phaser.Display.Color.GetColor(r,g,b),0.15);
    this.waterGfx.fillRect(0,this.waterY+24,W,8);
  }

  // ── SURGE ────────────────────────────────────────────────────────────────
  triggerSurge(){
    if(this.gameOver) return;
    this.surgeActive=true;
    this.sirenSprites.forEach(s=>s.setTexture('siren_on').setTint(0xff2200));
    this.showNotif('🚨 SURGE! Wave speeding up — CLIMB FASTER!',false);
    SFX.alert();
    // Flash screen blue
    this.cameras.main.flash(400,0,80,255);
    this.time.delayedCall(5000,()=>{
      this.surgeActive=false;
      this.sirenSprites.forEach(s=>s.setTexture('siren_off').clearTint());
    });
  }

  startSirenCycle(){
    this.time.addEvent({delay:3000,callback:()=>{
      if(this.gameOver) return;
      // Start with siren flashing
      let on=true;
      const flash=this.time.addEvent({delay:400,repeat:5,callback:()=>{
        on=!on;
        this.sirenSprites.forEach(s=>s.setTexture(on?'siren_on':'siren_off'));
      }});
    }});
  }

  // ── FLOATING DEBRIS ──────────────────────────────────────────────────────
  spawnFloatingDebris(){
    const types=['float_plank','float_barrel','float_car'];
    for(let i=0;i<6;i++){
      const x=Phaser.Math.Between(50,W-50);
      const tex=types[i%3];
      const s=this.add.image(x, this.waterY,'float_plank').setDisplaySize(48,24).setDepth(19).setScrollFactor(0);
      this.floatDebris.push({sprite:s, phase:Math.random()*Math.PI*2, active:true});
    }
  }

  // ── HUD ──────────────────────────────────────────────────────────────────
  buildHUD(){
    const hBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    hBg.fillStyle(0x000000,0.75); hBg.fillRect(0,0,W,44);

    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 1:50',{fontFamily:'monospace',fontSize:15,fontStyle:'bold',fill:'#0088ff'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);

    // Water level indicator (right side)
    this.add.text(W-14,10,'WATER ↑',{fontFamily:'monospace',fontSize:11,fill:'#4488cc'}).setOrigin(1,0).setScrollFactor(0).setDepth(41);
    const wlBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    wlBg.fillStyle(0x222244,1); wlBg.fillRect(W-90,26,80,12);
    this.waterLvlFill=this.add.graphics().setScrollFactor(0).setDepth(41);

    // Surge warning strip
    this.surgeStrip=this.add.graphics().setScrollFactor(0).setDepth(42);
    this.surgeTxt=this.add.text(W/2,44,'',{fontFamily:'monospace',fontSize:12,fontStyle:'bold',fill:'#ffffff',stroke:'#0000aa',strokeThickness:2}).setOrigin(0.5,0).setScrollFactor(0).setDepth(43).setVisible(false);

    // Status
    const sb=this.add.graphics().setScrollFactor(0).setDepth(40);
    sb.fillStyle(0x000000,0.65); sb.fillRect(0,H-22,W,22);
    this.statusTxt=this.add.text(W/2,H-11,'🌊 Water is rising — climb to HIGH GROUND →',{fontFamily:'monospace',fontSize:11,fill:'#66aaff'}).setOrigin(0.5).setScrollFactor(0).setDepth(41);
  }

  updateHUD(){
    const m=Math.floor(this.timeLeft/60),s=this.timeLeft%60;
    this.timerTxt.setText(`⏱ ${m}:${s.toString().padStart(2,'0')}`);
    if(this.timeLeft<=15) this.timerTxt.setColor('#ff4444');
    else if(this.timeLeft<=30) this.timerTxt.setColor('#ffaa00');
    this.scoreTxt.setText(`⭐ ${this.score}`);
    // Water level bar
    const pct=Math.min(1,Math.max(0,(H-this.waterY)/H));
    this.waterLvlFill.clear();
    const col=pct<0.5?0x0066cc:pct<0.75?0x0044ff:0x0022ff;
    this.waterLvlFill.fillStyle(col,1); this.waterLvlFill.fillRect(W-90,26,Math.round(80*pct),12);
    // Surge
    if(this.surgeActive){
      this.surgeStrip.clear();
      this.surgeStrip.fillStyle(0x0044cc,0.7+(Math.sin(Date.now()*0.01)*0.2));
      this.surgeStrip.fillRect(0,H-44,W,22);
      this.surgeTxt.setText('🚨 SURGE — CLIMB FASTER!').setVisible(true);
    } else {
      this.surgeStrip.clear(); this.surgeTxt.setVisible(false);
    }
  }

  showNotif(msg,ok=true){
    this.notifTxt.setText(msg).setColor(ok?'#00ff88':'#ff8844').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifTxt);
    this.tweens.add({targets:this.notifTxt,alpha:0,duration:300,delay:2400,onComplete:()=>this.notifTxt.setVisible(false).setAlpha(1)});
  }

  showBig(msg,color='#0088ff'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.5);
    this.tweens.add({targets:this.phaseTxt,scaleX:1,scaleY:1,duration:300,ease:'Back.Out'});
    this.time.delayedCall(2500,()=>this.tweens.add({targets:this.phaseTxt,alpha:0,duration:400,onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}));
  }

  // ── CHECK HILLTOP ─────────────────────────────────────────────────────────
  checkHilltop(){
    const hz=this.hilltopZone;
    return this.player.x>hz.x-hz.w/2 && this.player.x<hz.x+hz.w/2 &&
           this.player.y>hz.y-hz.h/2 && this.player.y<hz.y+hz.h+10;
  }

  // ── END GAME ──────────────────────────────────────────────────────────────
  endGame(won, reason=''){
    if(this.gameOver) return;
    this.gameOver=true;
    this.timerEvent.remove();
    this.cameras.main.resetFX();

    const heightBonus = Math.round((H - this.highestY) * 0.4);
    const timeBonus   = won ? this.timeLeft*5 : 0;
    const escapeBonus = won ? 500 : 0;
    const final       = this.score + heightBonus + timeBonus + escapeBonus;

    if(won){
      SFX.teleport();
      [400,550,700,880,1100].forEach((f,i)=>SFX.note(f,0.25,'sine',0.15,i*0.09));
      this.showBig('🏔 SAFE!\nYou reached high ground!','#ffd700');
      this.cameras.main.flash(600,0,200,255);
    } else {
      SFX.wrong();
      this.cameras.main.flash(600,0,80,180);
      this.player.kill();
      this.showBig(`🌊 GAME OVER\n${reason}`,'#0088ff');
    }
    this.cameras.main.fade(900,0,0,0);
    this.time.delayedCall(900,()=>{
      this.scene.start('Score',{
        score:final, timeBonus, survBonus:escapeBonus+heightBonus,
        location:'tsunami_coast', raw:this.score,
        died:!won, reason:won?'reached high ground':reason,
        gameType:'tsunami',
        heightBonus, escapeBonus
      });
    });
  }

  // ── UPDATE ────────────────────────────────────────────────────────────────
  update(time, delta){
    if(this.gameOver) return;

    this.player.update(delta||16.6);
    this.updateWater(delta||16.6);
    this.updateHUD();

    // Check hilltop
    if(this.checkHilltop()){
      this.score += 500;
      this.endGame(true);
      return;
    }

    // Height-based score
    const heightScore = Math.round(Math.max(0,(H-this.player.y)*0.1));
    this.score = heightScore;

    // Status
    const waterDist = this.player.y - this.waterY;
    if(waterDist < 60)       this.statusTxt.setText('🚨 WATER RIGHT BELOW — JUMP UP NOW!').setColor('#ff4444');
    else if(waterDist < 120) this.statusTxt.setText('⚠ Water close — keep climbing!').setColor('#ffaa00');
    else                     this.statusTxt.setText('🌊 Water rising — climb to HIGH GROUND →').setColor('#66aaff');
  }
}
// ── END OF TsunamiScene ──────────────────────────────────────────────────────

