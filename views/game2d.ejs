    tipBg.fillStyle(0x00ccff,0.06); tipBg.fillRoundedRect(cx-240,195,480,160,8);
    tipBg.lineStyle(1,0x00ccff,0.25); tipBg.strokeRoundedRect(cx-240,195,480,160,8);
    tips.forEach((t,i)=>this.add.text(cx-225,208+i*18,t,{fontFamily:'monospace',fontSize:10,fill:'#88eeff'}));

    const btnG=this.add.graphics();
    btnG.fillGradientStyle(0x00ccff,0x00ccff,0x0077bb,0x0077bb,1);
    btnG.fillRoundedRect(cx-110,358,220,50,25);
    this.add.text(cx,383,'▶ START!',{fontFamily:'monospace',fontSize:19,fontStyle:'bold',fill:'#000'})
      .setOrigin(0.5).setInteractive({useHandCursor:true})
      .on('pointerdown',()=>{ SFX.alert(); this.cameras.main.fade(500,0,0,0); this.time.delayedCall(500,()=>this.scene.start('Flood')); });
    this.add.text(cx,420,'← Back to Hall',{fontFamily:'monospace',fontSize:12,fill:'#224455'})
      .setOrigin(0.5).setInteractive({useHandCursor:true})
      .on('pointerdown',()=>{ this.cameras.main.fade(400,0,0,0); this.time.delayedCall(400,()=>this.scene.start('Hall')); });
  }
}

// ═════════════════════════════════════════════════════════════════════════════
// ████████████████  FLOOD LEVEL 1 — CLIMB TO ROOFTOP  ████████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  FloodScene — 4-floor apartment building, water rises from below
//
//  LAYOUT (vertical building, each floor ~80px tall):
//    Floor 1 (ground) → staircase right side → Floor 2 → staircase left →
//    Floor 3 → staircase right → Floor 4 → rooftop exit door
//
//  WATER: rises from below at ~20px/s, accelerates every 20s
//         touch water = game over
//
//  WIN: reach the rooftop door (top floor) before water
//
//  SCORING: +floorReached*100, +timeLeft*4, +400 escape bonus → pass to Level 2
// ═════════════════════════════════════════════════════════════════════════════
class FloodScene extends Phaser.Scene {
  constructor(){ super('Flood'); }

  create(){
    this.score      = 0;
    this.timeLeft   = 120;       // extra time
    this.gameOver   = false;
    this.waterY     = H + 30;
    this.waterSpeed = 4;          // very slow start — player has time to climb
    this.floodFrame = 0;
    this.floorReached = 0;
    this.reachedRoof  = false;    // true once player stands on rooftop

    // Building constants
    this.FLOOR_H = 100;  // taller floors so more space to navigate
    this.FLOORS  = 2;    // 2 floors + rooftop
    this.BLDG_X  = 120; // left edge of building
    this.BLDG_W  = W - 240;
    const GROUND = H - 40;
    this.GROUND  = GROUND;

    this.buildBuilding(GROUND);

    // Player starts ground floor
    this.player = new Player(this, this.BLDG_X+40, GROUND-20, {
      speed:140, jumpForce:-390, canCrouch:false, canJump:true, gravity:650
    });
    this.player.addCollider(this.floorGroup);
    this.player.addCollider(this.wallGroup);

    this.interactKey=this.input.keyboard.addKey(Phaser.Input.Keyboard.KeyCodes.E);

    this.buildWater();
    this.buildHUD();

    // Timer
    this.timerEvent=this.time.addEvent({delay:1000,repeat:119,callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.updateHUD();
      if(this.timeLeft%30===0) this.waterSpeed+=0.8; // very gradual acceleration
      if(this.timeLeft<=0) this.endLevel(false,'Water overtook you!');
    }});

    // Flood frame anim
    this.time.addEvent({delay:180,repeat:-1,callback:()=>{
      this.floodFrame=(this.floodFrame+1)%4;
      this.waterTiles&&this.waterTiles.forEach(w=>w.setTexture(`flood_${this.floodFrame}`));
    }});

    // Stranded frame anim
    this.time.addEvent({delay:400,repeat:-1,callback:()=>{
      this.strandedFrame=(this.strandedFrame||0)^1;
    }});
    this.strandedFrame=0;

    this.phaseTxt=this.add.text(W/2,H/2,'',{
      fontFamily:'monospace',fontSize:24,fontStyle:'bold',
      fill:'#00ccff',stroke:'#000',strokeThickness:4,align:'center'
    }).setOrigin(0.5).setDepth(70).setVisible(false).setScrollFactor(0);

    this.notifTxt=this.add.text(W/2,H-132,'',{
      fontFamily:'monospace',fontSize:13,fontStyle:'bold',
      fill:'#00ddff',backgroundColor:'rgba(0,0,0,0.88)',padding:{x:12,y:6}
    }).setOrigin(0.5).setDepth(60).setVisible(false).setScrollFactor(0);

    setupMobile(this);
    this.showBig('💧 FLOOD!\nClimb to the ROOFTOP!','#00ccff');
  }

  buildBuilding(GROUND){
    // Sky — stormy grey
    const bg=this.add.graphics();
    bg.fillGradientStyle(0x111122,0x111122,0x223344,0x112233,1);
    bg.fillRect(0,0,W,H);
    // Rain streaks
    for(let i=0;i<40;i++){
      bg.lineStyle(1,0x4488cc,0.3);
      const rx=Phaser.Math.Between(0,W);
      bg.lineBetween(rx,0,rx+10,H);
    }

    const BX=this.BLDG_X, BW=this.BLDG_W, FH=this.FLOOR_H;

    // Building outer walls
    const walls=this.add.graphics();
    walls.fillStyle(0xcccccc,1);
    walls.fillRect(BX, GROUND-FH*this.FLOORS, BW, FH*this.FLOORS);
    // Draw only left, right, bottom borders — NO top line (rooftop is the top floor)
    walls.lineStyle(3,0x999999);
    walls.lineBetween(BX, GROUND-FH*this.FLOORS, BX, GROUND);           // left wall
    walls.lineBetween(BX+BW, GROUND-FH*this.FLOORS, BX+BW, GROUND);    // right wall
    walls.lineBetween(BX, GROUND, BX+BW, GROUND);                       // bottom

    const STAIR_W = 110;  // wider gap so player passes through easily

    // Floor lines — gap on ALL floors including rooftop (stair passes through each)
    for(let f=1;f<=this.FLOORS;f++){
      const fy   = GROUND - f*FH;
      const side = (f-1)%2===0 ? 'right':'left';
      const sx   = side==='right' ? BX+BW-STAIR_W-8 : BX+8;
      const ex   = sx + STAIR_W;
      walls.lineStyle(2,0xaaaaaa);
      if(sx-BX>2)      walls.lineBetween(BX,fy,sx,fy);
      if((BX+BW)-ex>2) walls.lineBetween(ex,fy,BX+BW,fy);
    }

    // Windows on each floor
    for(let f=0;f<this.FLOORS;f++){
      const fy=GROUND-f*FH-FH;
      [BX+20,BX+80,BX+BW-100,BX+BW-40].forEach(wx=>{
        walls.fillStyle(0x88ccff,0.7); walls.fillRect(wx,fy+15,30,24);
        walls.lineStyle(2,0x666666); walls.strokeRect(wx,fy+15,30,24);
        walls.lineBetween(wx+15,fy+15,wx+15,fy+39);
        walls.lineBetween(wx,fy+27,wx+30,fy+27);
      });
    }

    // Floor labels
    for(let f=1;f<=this.FLOORS;f++){
      const fy=GROUND-f*FH;
      const label=f===this.FLOORS?'ROOFTOP':`Floor ${f}`;
      this.add.text(BX+BW/2,fy+8,label,{fontFamily:'monospace',fontSize:9,fill:'#888888'}).setOrigin(0.5,0).setDepth(2);
    }

    // ── PHYSICS ──
    this.floorGroup=this.physics.add.staticGroup();
    this.wallGroup =this.physics.add.staticGroup();

    // Ground floor
    const gf=this.add.rectangle(W/2,GROUND+8,W,20,0,0);
    this.physics.add.existing(gf,true); this.floorGroup.add(gf);

    // Building side walls
    const wallH=FH*this.FLOORS, wallMidY=GROUND-wallH/2;
    const lw=this.add.rectangle(BX-8,wallMidY,16,wallH,0,0);
    this.physics.add.existing(lw,true); this.wallGroup.add(lw);
    const rw=this.add.rectangle(BX+BW+8,wallMidY,16,wallH,0,0);
    this.physics.add.existing(rw,true); this.wallGroup.add(rw);

    // ── FLOORS + STAIRS built together ──
    // For each floor that has a stair below it: floor is split LEFT+RIGHT with
    // a gap exactly matching the stair X range. Stair step physics fills that gap.
    // Rooftop floor (f===FLOORS): fully solid, no stair.

    // Pre-compute stair info per destination floor (all floors including rooftop)
    const stairInfo = {};
    for(let f=0;f<this.FLOORS;f++){  // now includes stair up to rooftop
      const side = f%2===0 ? 'right':'left';
      const sx   = side==='right' ? BX+BW-STAIR_W-8 : BX+8;
      stairInfo[f+1] = {sx, ex:sx+STAIR_W, side};
    }

    // Build floor physics — all floors (including rooftop) have a gap at the stair
    for(let f=1;f<=this.FLOORS;f++){
      const fy = GROUND - f*FH;
      const {sx,ex} = stairInfo[f];
      // Left piece
      const lW = sx - BX;
      if(lW>2){
        const lp=this.add.rectangle(BX+lW/2,fy,lW,8,0,0);
        this.physics.add.existing(lp,true); this.floorGroup.add(lp);
      }
      // Right piece
      const rW = (BX+BW) - ex;
      if(rW>2){
        const rp=this.add.rectangle(ex+rW/2,fy,rW,8,0,0);
        this.physics.add.existing(rp,true); this.floorGroup.add(rp);
      }
    }

    // Build stairs — now includes stair up to rooftop (f=0..FLOORS-1)
    for(let f=0;f<this.FLOORS;f++){
      const fromY = GROUND - f*FH;
      const toY   = GROUND - (f+1)*FH;
      const {sx, ex, side} = stairInfo[f+1];

      // Visual steps
      const STEPS=6, stepW=Math.floor(STAIR_W/STEPS), stepH=Math.floor(FH/STEPS);
      const sg=this.add.graphics().setDepth(4);
      sg.fillStyle(0xd0c0a0,1); sg.lineStyle(1,0xb0a080,1);
      for(let s=0;s<STEPS;s++){
        const stepX = side==='right' ? sx+s*stepW : sx+(STEPS-1-s)*stepW;
        sg.fillRect(stepX, fromY-(s+1)*stepH, stepW+2, stepH);
        sg.strokeRect(stepX, fromY-(s+1)*stepH, stepW+2, stepH);
      }
      // Handrail
      const rg=this.add.graphics().setDepth(5); rg.lineStyle(3,0x8b6914,1);
      side==='right'
        ? rg.lineBetween(sx+4,fromY-4,ex-4,toY+4)
        : rg.lineBetween(ex-4,fromY-4,sx+4,toY+4);

      // Step physics — each step is a solid platform, last one AT toY (flush with floor)
      const SS=8;
      for(let r=0;r<SS;r++){
        const t = (r+1)/SS;
        const py  = fromY - t*(fromY-toY);
        const cx2 = side==='right' ? sx+t*STAIR_W : ex-t*STAIR_W;
        const sp=this.add.rectangle(cx2, py, STAIR_W/SS+8, 8, 0,0);
        this.physics.add.existing(sp,true);
        this.floorGroup.add(sp);
      }

      this.add.text(sx+STAIR_W/2, fromY-FH/2-10, '↑\nSTAIRS',{
        fontFamily:'monospace',fontSize:8,fontStyle:'bold',
        fill:'#ffcc44',stroke:'#000',strokeThickness:2,align:'center'
      }).setOrigin(0.5).setDepth(6);
    }

    // ── ROOFTOP — solid floor + EXIT DOOR to Level 2 ──
    const roofY = GROUND - this.FLOORS*FH;
    this.roofY  = roofY;

    // Rooftop parapet visual
    const roofGfx=this.add.graphics().setDepth(4);
    roofGfx.fillStyle(0x999999,1); roofGfx.fillRect(BX,roofY-8,BW,10);
    roofGfx.fillStyle(0x777777,1); roofGfx.fillRect(BX,roofY-12,BW,4);
    for(let px2=BX+10;px2<BX+BW;px2+=30){
      roofGfx.fillStyle(0x888888,1); roofGfx.fillRect(px2,roofY-20,20,8);
    }

    // ── EXIT DOOR — sits ON the rooftop floor surface ──
    // roofY is the floor LINE. Floor surface is at roofY (player stands here).
    // Door base = roofY, door top = roofY - 56 (door height 56px, going upward into the sky area)
    const doorX = BX+BW/2;
    const doorBase = roofY;          // bottom of door = floor surface
    const doorH = 56;                // door height
    const doorTop = doorBase - doorH; // top of door frame

    const dg=this.add.graphics().setDepth(6);
    // Door frame background
    dg.fillStyle(0x1a3322,1); dg.fillRect(doorX-22, doorTop, 44, doorH);
    dg.lineStyle(3,0x00ff88);  dg.strokeRect(doorX-22, doorTop, 44, doorH);
    // Door fill (glowing)
    this.exitDoorFill=this.add.rectangle(doorX, doorBase-doorH/2, 38, doorH-4, 0x00ccff, 0.5).setDepth(7);
    this.tweens.add({targets:this.exitDoorFill,alpha:{from:0.3,to:0.8},duration:600,yoyo:true,repeat:-1});
    // Doorknob
    this.add.circle(doorX+14, doorBase-doorH/2, 3, 0xffd700, 1).setDepth(8);
    // "EXIT TO ROOF" label above door
    this.add.text(doorX, doorTop-10, '🚪 EXIT TO ROOF', {fontFamily:'monospace',fontSize:10,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5,1).setDepth(8);
    // Press E hint (shown when player is near)
    this.exitHint=this.add.text(doorX, doorTop-24, '[ E ] Enter', {fontFamily:'monospace',fontSize:9,fill:'#ffd700',backgroundColor:'rgba(0,0,0,0.7)',padding:{x:4,y:2}}).setOrigin(0.5,1).setDepth(8).setVisible(false);
    // Interaction zone
    this.exitDoorZone={x:doorX, y:doorBase-doorH/2, w:50, h:doorH};

    // Rooftop solid floor physics is already built above in the floor loop (with gap at stair)
    this.rooftopZone={x:BX+BW/2,y:roofY-6,w:BW,h:20};

    // Outside ground
    const og=this.add.graphics();
    og.fillStyle(0x333344,1); og.fillRect(0,GROUND,W,H-GROUND+10);
    og.fillStyle(0x222233,0.5); og.fillRect(0,GROUND,W,6);
  }

  buildWater(){
    this.waterGfx=this.add.graphics().setDepth(18).setScrollFactor(0);
    this.waterTiles=[];
    for(let x=0;x<W;x+=64){
      const wt=this.add.image(x,this.waterY,'flood_0').setOrigin(0,1).setDisplaySize(64,32).setDepth(19).setScrollFactor(0);
      this.waterTiles.push(wt);
    }
  }

  buildHUD(){
    const hBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    hBg.fillStyle(0x000000,0.75); hBg.fillRect(0,0,W,44);
    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 2:00',{fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#00ccff'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);
    this.floorTxt=this.add.text(W-14,10,'📍 Ground',{fontFamily:'monospace',fontSize:12,fill:'#88ddff'}).setOrigin(1,0).setScrollFactor(0).setDepth(41);
    // Water level bar
    const wbg=this.add.graphics().setScrollFactor(0).setDepth(40);
    wbg.fillStyle(0x112233,1); wbg.fillRect(14,46,W-28,10);
    this.waterBar=this.add.graphics().setScrollFactor(0).setDepth(41);
    this.add.text(14,58,'💧 Water',{fontFamily:'monospace',fontSize:9,fill:'#4499cc'}).setScrollFactor(0).setDepth(41);
    // Status
    const sb=this.add.graphics().setScrollFactor(0).setDepth(40);
    sb.fillStyle(0x000000,0.65); sb.fillRect(0,H-22,W,22);
    this.statusTxt=this.add.text(W/2,H-11,'💧 Jump up the ladders 🪜 to reach the ROOFTOP!',{fontFamily:'monospace',fontSize:11,fill:'#44aacc'}).setOrigin(0.5).setScrollFactor(0).setDepth(41);
  }

  updateHUD(){
    const m=Math.floor(this.timeLeft/60),s=this.timeLeft%60;
    this.timerTxt.setText(`⏱ ${m}:${s.toString().padStart(2,'0')}`);
    if(this.timeLeft<=15) this.timerTxt.setColor('#ff4444');
    else if(this.timeLeft<=30) this.timerTxt.setColor('#ffaa00');
    this.scoreTxt.setText(`⭐ ${this.score}`);
    // Floor indicator
    const currentFloor=Math.min(this.FLOORS, Math.floor((this.GROUND-this.player.y)/this.FLOOR_H)+1);
    const floorName=currentFloor>=this.FLOORS?'ROOFTOP':`Floor ${currentFloor}`;
    this.floorTxt.setText(`📍 ${floorName}`);
    if(currentFloor>this.floorReached){
      this.floorReached=currentFloor;
      this.score+=currentFloor*100;
      SFX.correct();
      this.showNotif(`⬆ ${floorName}! +${currentFloor*100}`,true);
    }
    // Water bar
    this.waterBar.clear();
    const pct=Math.min(1,Math.max(0,(this.GROUND-this.waterY+30)/((this.FLOORS+1)*this.FLOOR_H)));
    this.waterBar.fillStyle(0x0088cc,1); this.waterBar.fillRect(14,46,Math.round((W-28)*pct),10);
  }

  showNotif(msg,ok){
    this.notifTxt.setText(msg).setColor(ok?'#00ff88':'#ff8844').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifTxt);
    this.tweens.add({targets:this.notifTxt,alpha:0,duration:300,delay:2000,onComplete:()=>this.notifTxt.setVisible(false).setAlpha(1)});
  }

  showBig(msg,color='#00ccff'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.5);
    this.tweens.add({targets:this.phaseTxt,scaleX:1,scaleY:1,duration:300,ease:'Back.Out'});
    this.time.delayedCall(2500,()=>this.tweens.add({targets:this.phaseTxt,alpha:0,duration:400,onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}));
  }

  endLevel(won, reason=''){
    if(this.gameOver) return;
    this.gameOver=true;
    this.timerEvent.remove();
    this.cameras.main.resetFX();
    const timeBonus=won?this.timeLeft*4:0;
    const bonus=won?400:0;
    const lvl1Score=this.score+timeBonus+bonus;
    if(won){
      SFX.teleport();
      this.showBig('🏠 ROOFTOP!\nLevel 2: Rescue by Boat!','#00ccff');
      this.cameras.main.fade(800,0,0,0);
      this.time.delayedCall(800,()=>this.scene.start('FloodBoat',{floodScore:lvl1Score}));
    } else {
      SFX.wrong(); this.cameras.main.flash(500,0,80,180);
      this.player.kill();
      this.showBig(`🌊 GAME OVER\n${reason}`,'#00ccff');
      this.cameras.main.fade(900,0,0,0);
      this.time.delayedCall(900,()=>this.scene.start('Score',{
        score:lvl1Score,timeBonus,survBonus:0,location:'flood_building',
        raw:this.score,died:true,reason,gameType:'flood'
      }));
    }
  }

  update(time,delta){
    if(this.gameOver) return;
    this.player.update(delta||16.6);

    // Rise water
    this.waterY-=(this.waterSpeed*(delta||16.6)/1000);
    // Rise water — stop just below rooftop once player is safe up there
    if(!this.reachedRoof){
      this.waterY-=(this.waterSpeed*(delta||16.6)/1000);
    } else {
      this.waterY=Math.max(this.waterY, this.roofY+18);
    }
    this.waterGfx.clear();
    this.waterGfx.fillStyle(0x0055aa,0.82); this.waterGfx.fillRect(0,this.waterY,W,H-this.waterY+20);
    this.waterGfx.fillStyle(0x0077cc,0.25); this.waterGfx.fillRect(0,this.waterY+4,W,18);
    this.waterTiles.forEach(wt=>wt.y=this.waterY);

    // Die touching water
    if(this.player.y>=this.waterY-8){ this.endLevel(false,'Swept away by flood!'); return; }

    // On rooftop — show exit door hint
    const onRoof = this.player.y <= this.roofY+10 && this.player.onGround;
    if(onRoof && !this.reachedRoof){
      this.reachedRoof=true;
      SFX.correct();
      this.showNotif('🏠 Rooftop! Go to the EXIT DOOR →',true);
    }
    // Show/hide exit hint when near door
    if(this.exitHint){
      const ed=this.exitDoorZone;
      const nearDoor=Math.abs(this.player.x-ed.x)<40 && this.player.y<=this.roofY+10;
      this.exitHint.setVisible(nearDoor);
    }
    // E key at exit door → finish Level 1 → Level 2
    if(Phaser.Input.Keyboard.JustDown(this.interactKey)||window._mAction){
      window._mAction=false;
      const ed=this.exitDoorZone;
      if(Math.abs(this.player.x-ed.x)<50 && this.player.y<=this.roofY+10){
        this.endLevel(true);
        return;
      }
    }

    this.updateHUD();
    const waterDist=this.player.y-this.waterY;
    if(waterDist<60)       this.statusTxt.setText('🚨 WATER BELOW — JUMP UP NOW!').setColor('#ff4444');
    else if(waterDist<130) this.statusTxt.setText('⚠ Water rising — jump up the ladders 🪜!').setColor('#ffaa00');
    else if(onRoof)        this.statusTxt.setText('🚪 Walk to the EXIT DOOR and press E!').setColor('#00ff88');
    else                   this.statusTxt.setText('💧 Jump up the ladders 🪜 to reach the ROOFTOP!').setColor('#44aacc');
  }
}

// ═════════════════════════════════════════════════════════════════════════════
// ████████████████  FLOOD LEVEL 2 — BOAT RESCUE  ██████████████████████████████
// ═════════════════════════════════════════════════════════════════════════════
//
//  FloodBoatScene — the city is submerged, you're on a rescue boat
//
//  MECHANICS:
//    - Player RIDES the boat (no walking — A/D to paddle left/right)
//    - W to speed up, S to brake/reverse
//    - Flooded street: building rooftops stick out of water
//    - 5 stranded survivors on rooftops waving for help
//    - Press E when boat is next to a rooftop to pick them up (max 2 at once)
//    - Bring to RESCUE HQ (far right, raised platform) to score
//    - Floating debris drifts — hit 3 times = game over
//    - Faster rescues = better score
// ═════════════════════════════════════════════════════════════════════════════
class FloodBoatScene extends Phaser.Scene {
  constructor(){ super('FloodBoat'); }
  init(data){ this.floodScore=data.floodScore||0; }

  create(){
    this.score       = 0;
    this.timeLeft    = 120;
    this.gameOver    = false;
    this.onBoard     = 0;   // survivors in boat
    this.rescued     = 0;   // total delivered
    this.hull        = 3;   // boat hits before game over
    this.survivors   = [];
    this.floatItems  = [];
    this.boatVX      = 0;   // boat velocity
    this.waveFrame   = 0;
    this._hitCooldown= false;
    this.strandedAnim= 0;

    const WATER_Y = H*0.42; // water surface
    this.WATER_Y  = WATER_Y;

    this.buildFloodedCity(WATER_Y);
    this.buildBoat(WATER_Y);
    this.spawnSurvivors(WATER_Y);
    this.spawnDebrisItems(WATER_Y);
    this.buildRescueHQ(WATER_Y);
    this.buildHUD();

    this.keys=this.input.keyboard.addKeys({
      left:Phaser.Input.Keyboard.KeyCodes.A,
      right:Phaser.Input.Keyboard.KeyCodes.D,
      arrowL:Phaser.Input.Keyboard.KeyCodes.LEFT,
      arrowR:Phaser.Input.Keyboard.KeyCodes.RIGHT,
      up:Phaser.Input.Keyboard.KeyCodes.W,
      down:Phaser.Input.Keyboard.KeyCodes.S,
      interact:Phaser.Input.Keyboard.KeyCodes.E,
    });

    // Timers
    this.timerEvent=this.time.addEvent({delay:1000,repeat:119,callback:()=>{
      if(this.gameOver) return;
      this.timeLeft--;
      this.updateHUD();
      if(this.timeLeft<=0) this.endGame(false,'Time ran out!');
    }});
    this.time.addEvent({delay:160,repeat:-1,callback:()=>{ this.waveFrame=(this.waveFrame+1)%4; }});
    this.time.addEvent({delay:500,repeat:-1,callback:()=>{ this.strandedAnim^=1; this.survivors.forEach(s=>{ if(!s.rescued) s.sprite.setTexture(`stranded_${this.strandedAnim}`); }); }});

    this.phaseTxt=this.add.text(W/2,H/2,'',{fontFamily:'monospace',fontSize:22,fontStyle:'bold',fill:'#00ccff',stroke:'#000',strokeThickness:4,align:'center'}).setOrigin(0.5).setDepth(70).setVisible(false);
    this.notifTxt=this.add.text(W/2,H-132,'',{fontFamily:'monospace',fontSize:13,fontStyle:'bold',fill:'#00ddff',backgroundColor:'rgba(0,0,0,0.88)',padding:{x:12,y:6}}).setOrigin(0.5).setDepth(60).setVisible(false);
    this.hintTxt=this.add.text(W/2,H-60,'',{fontFamily:'monospace',fontSize:13,fontStyle:'bold',fill:'#ffd700',backgroundColor:'rgba(0,0,0,0.8)',padding:{x:8,y:4}}).setOrigin(0.5).setScrollFactor(0).setDepth(55).setVisible(false);

    setupMobile(this);
    const mJ=document.getElementById('mJump'); if(mJ) mJ.textContent='W↑';
    const mS=document.getElementById('mSprint'); if(mS) mS.textContent='S↓';
    const mA=document.getElementById('mAction'); if(mA) mA.textContent='E';

    this.showBig('🚤 RESCUE MISSION!\nRow to survivors!','#00ccff');
  }

  buildFloodedCity(WY){
    const bg=this.add.graphics();
    bg.fillGradientStyle(0x111122,0x111122,0x223344,0x112233,1);
    bg.fillRect(0,0,W,H);
    // Rain
    for(let i=0;i<30;i++){
      bg.lineStyle(1,0x4488cc,0.2);
      const rx=Phaser.Math.Between(0,W);
      bg.lineBetween(rx,0,rx+8,H);
    }

    // Flooded water body
    const wg=this.add.graphics();
    wg.fillStyle(0x0044aa,0.88); wg.fillRect(0,WY,W,H-WY);
    wg.fillStyle(0x0066cc,0.2); wg.fillRect(0,WY,W,20);
    this.waterGfx=wg;

    // Animated wave tiles on surface
    this.waveTiles=[];
    for(let x=0;x<W;x+=64){
      const wt=this.add.image(x,WY,'flood_0').setOrigin(0,1).setDisplaySize(64,32).setDepth(8);
      this.waveTiles.push(wt);
    }

    // Submerged building tops (just rooftops sticking out)
    const roofDefs=[
      {x:100,  y:WY+10, w:100, col:0x998877},
      {x:260,  y:WY+20, w:80,  col:0x887766},
      {x:400,  y:WY+5,  w:110, col:0xaa9988},
      {x:560,  y:WY+15, w:90,  col:0x999988},
      {x:700,  y:WY+8,  w:95,  col:0x887788},
    ];
    this.rooftops=[];
    roofDefs.forEach((r,i)=>{
      // Submerged building silhouette
      const depth=Phaser.Math.Between(40,80);
      bg.fillStyle(0x334455,0.6); bg.fillRect(r.x-10,WY,r.w+20,depth);
      // Rooftop platform
      this.add.rectangle(r.x+r.w/2,r.y-4,r.w,12,r.col,1).setOrigin(0.5).setDepth(5);
      this.add.rectangle(r.x+r.w/2,r.y-4,r.w-4,8,0x000000,0.15).setOrigin(0.5).setDepth(6);
      // Chimney/water tank
      this.add.rectangle(r.x+10,r.y-12,10,14,0x776655,0.9).setOrigin(0.5,1).setDepth(6);
      this.rooftops.push({x:r.x+r.w/2, y:r.y-4, w:r.w, idx:i});
    });
  }

  buildBoat(WY){
    this.boatX=80;
    this.boatY=WY-10;
    this.boatContainer=this.add.container(this.boatX,this.boatY).setDepth(15);
    this.boatImg=this.add.image(0,0,'boat').setDisplaySize(96,40).setOrigin(0.5,1);
    this.boatContainer.add(this.boatImg);
    // Player sprite on boat
    this.playerSpr=this.add.image(0,-32,'player_idle0').setDisplaySize(32,52).setDepth(16);
    this.boatFacing=false; // facing left?

    // Wake effect
    this.wake=this.add.graphics().setDepth(14);
  }

  buildRescueHQ(WY){
    // Right side raised platform
    const hx=W-60, hy=WY-30;
    this.add.rectangle(hx,hy,80,60,0x334433,1).setOrigin(0.5,1).setDepth(4);
    this.add.rectangle(hx,hy,80,8,0x44aa44,1).setOrigin(0.5,1).setDepth(5);
    this.add.text(hx,hy-10,'🆘 HQ',{fontFamily:'monospace',fontSize:12,fontStyle:'bold',fill:'#00ff88'}).setOrigin(0.5,1).setDepth(6);
    const hqg=this.add.rectangle(hx,hy-30,76,56,0x00ff88,0.12).setDepth(5);
    this.tweens.add({targets:hqg,alpha:{from:0.08,to:0.25},duration:700,yoyo:true,repeat:-1});
    this.hqZone={x:hx,y:hy-30,w:80,h:56};

    // Flag
    this.add.rectangle(hx+30,hy-80,3,40,0x888888,1).setDepth(5);
    this.add.rectangle(hx+40,hy-80,20,14,0xff0000,1).setDepth(6);
    this.add.text(hx+40,hy-73,'SOS',{fontFamily:'monospace',fontSize:6,fill:'#ffffff'}).setOrigin(0.5).setDepth(7);
  }

  spawnSurvivors(WY){
    this.rooftops.forEach((r,i)=>{
      const glow=this.add.ellipse(r.x,r.y-18,44,20,0xffdd44,0.4).setDepth(7);
      this.tweens.add({targets:glow,scaleX:{from:0.85,to:1.15},alpha:{from:0.2,to:0.5},duration:500+i*100,yoyo:true,repeat:-1});
      const spr=this.add.image(r.x,r.y-12,'stranded_0').setOrigin(0.5,1).setDisplaySize(28,42).setDepth(9);
      this.add.text(r.x,r.y-58,'HELP!',{fontFamily:'monospace',fontSize:8,fontStyle:'bold',fill:'#ffdd44',backgroundColor:'rgba(0,0,0,0.7)',padding:{x:3,y:1}}).setOrigin(0.5).setDepth(10);
      this.survivors.push({x:r.x,y:r.y,sprite:spr,glow,rescued:false,rooftopIdx:i});
    });
  }

  spawnDebrisItems(WY){
    const types=['float_plank','float_barrel','float_car'];
    for(let i=0;i<8;i++){
      const x=Phaser.Math.Between(50,W-100);
      const spr=this.add.image(x,WY-6,types[i%3]).setDisplaySize(44,20).setDepth(12);
      this.floatItems.push({sprite:spr,x,vx:Phaser.Math.FloatBetween(-0.8,0.8)*-1,phase:Math.random()*Math.PI*2});
    }
  }

  buildHUD(){
    const hBg=this.add.graphics().setScrollFactor(0).setDepth(40);
    hBg.fillStyle(0x000000,0.75); hBg.fillRect(0,0,W,44);
    this.scoreTxt=this.add.text(14,10,'⭐ 0',{fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#ffd700'}).setScrollFactor(0).setDepth(41);
    this.timerTxt=this.add.text(W/2,10,'⏱ 2:00',{fontFamily:'monospace',fontSize:14,fontStyle:'bold',fill:'#00ccff'}).setOrigin(0.5,0).setScrollFactor(0).setDepth(41);
    this.hullTxt=this.add.text(W-14,10,'🚤❤❤❤',{fontFamily:'monospace',fontSize:13}).setOrigin(1,0).setScrollFactor(0).setDepth(41);
    this.rescueTxt=this.add.text(14,46,'🧑 On board: 0/2   🏠 Rescued: 0/5',{fontFamily:'monospace',fontSize:11,fill:'#88ddff'}).setScrollFactor(0).setDepth(41);
    const sb=this.add.graphics().setScrollFactor(0).setDepth(40);
    sb.fillStyle(0x000000,0.65); sb.fillRect(0,H-22,W,22);
    this.statusTxt=this.add.text(W/2,H-11,'🚤 Row to survivors — press E to pick up, then reach HQ!',{fontFamily:'monospace',fontSize:11,fill:'#44aacc'}).setOrigin(0.5).setScrollFactor(0).setDepth(41);
  }

  updateHUD(){
    const m=Math.floor(this.timeLeft/60),s=this.timeLeft%60;
    this.timerTxt.setText(`⏱ ${m}:${s.toString().padStart(2,'0')}`);
    if(this.timeLeft<=20) this.timerTxt.setColor('#ff4444');
    this.scoreTxt.setText(`⭐ ${this.score+this.floodScore}`);
    this.hullTxt.setText('🚤'+'❤'.repeat(this.hull)+'🖤'.repeat(Math.max(0,3-this.hull)));
    this.rescueTxt.setText(`🧑 On board: ${this.onBoard}/2   🏠 Rescued: ${this.rescued}/5`);
  }

  showNotif(msg,ok=true){
    this.notifTxt.setText(msg).setColor(ok?'#00ff88':'#ff6666').setVisible(true).setAlpha(1);
    this.tweens.killTweensOf(this.notifTxt);
    this.tweens.add({targets:this.notifTxt,alpha:0,duration:300,delay:2200,onComplete:()=>this.notifTxt.setVisible(false).setAlpha(1)});
  }

  showBig(msg,color='#00ccff'){
    this.phaseTxt.setText(msg).setColor(color).setVisible(true).setAlpha(1).setScale(0.5);
    this.tweens.add({targets:this.phaseTxt,scaleX:1,scaleY:1,duration:300,ease:'Back.Out'});
    this.time.delayedCall(2500,()=>this.tweens.add({targets:this.phaseTxt,alpha:0,duration:400,onComplete:()=>this.phaseTxt.setVisible(false).setAlpha(1)}));
  }

  tryInteract(){
    if(this.gameOver) return;
    // Drop at HQ
    const hq=this.hqZone;
    if(this.onBoard>0 && Math.abs(this.boatX-hq.x)<55 && this.boatY<hq.y+hq.h){
      const count=this.onBoard;
      this.rescued+=count; this.onBoard=0;
      this.score+=count*300;
      SFX.correct(); SFX.correct();
      this.showNotif(`🏠 ${count} rescued! +${count*300}`,true);
      this.updateHUD();
      if(this.rescued>=5) this.endGame(true);
      return;
    }
    // Pick up survivor
    if(this.onBoard<2){
      let picked=false;
      this.survivors.forEach(s=>{
        if(s.rescued||picked) return;
        if(Math.abs(this.boatX-s.x)<55 && Math.abs(this.boatY-s.y)<40){
          s.rescued=true; s.sprite.setVisible(false); s.glow.setVisible(false);
          this.onBoard++;
          SFX.correct();
          this.showNotif(`🧑 Survivor on board! (${this.onBoard}/2)`,true);
          this.updateHUD(); picked=true;
        }
      });
      if(!picked) this.showNotif('Row closer to a survivor!',false);
    } else {
      this.showNotif('Boat full — go to HQ first!',false);
    }
  }

  hitBoat(){
    if(this._hitCooldown||this.gameOver) return;
    this._hitCooldown=true;
    this.hull=Math.max(0,this.hull-1);
    this.cameras.main.flash(200,0,100,200);
    SFX.wrong();
    this.showNotif('💥 Hit debris!',false);
    this.updateHUD();
    this.time.delayedCall(1200,()=>this._hitCooldown=false);
    if(this.hull<=0) this.endGame(false,'Boat sunk!');
  }

  endGame(won, reason=''){
    if(this.gameOver) return;
    this.gameOver=true;
    this.timerEvent.remove();
    this.cameras.main.resetFX();
    const timeBonus=won?this.timeLeft*5:Math.floor(this.rescued*60);
    const survBonus=won?500:0;
    const boatScore=this.score+timeBonus+survBonus;
    const final=boatScore+this.floodScore;
    if(won){
      SFX.teleport();
      [500,650,800,1000,1200].forEach((f,i)=>SFX.note(f,0.28,'sine',0.16,i*0.09));
      this.showBig('🏆 ALL RESCUED!\nBoth levels cleared!','#ffd700');
    } else {
      SFX.wrong(); this.cameras.main.flash(500,0,80,180);
      this.showBig(`💀 GAME OVER\n${reason}`,'#ff4444');
    }
    this.cameras.main.fade(900,0,0,0);
    this.time.delayedCall(900,()=>this.scene.start('Score',{
      score:final, timeBonus, survBonus:survBonus+this.floodScore,
      location:'flood_boat', raw:boatScore,
      died:!won, reason:won?'all rescued':reason,
      gameType:'flood_full',
      floodScore:this.floodScore, boatScore, delivered:this.rescued
    }));
  }

  update(time,delta){
    if(this.gameOver) return;
    const k=this.keys;
    const dt=(delta||16.6)/1000;

    // Boat controls — A/D paddle, W speed up, S brake
    if(k.left.isDown||k.arrowL.isDown||window._joyX<-0.25) this.boatVX-=180*dt;
    if(k.right.isDown||k.arrowR.isDown||window._joyX>0.25)  this.boatVX+=180*dt;
    if(k.up.isDown)   this.boatVX*=1.02;
    if(k.down.isDown) this.boatVX*=0.92;
    // Drag
    this.boatVX*=0.96;
    this.boatVX=Math.max(-200,Math.min(200,this.boatVX));
    // Move
    this.boatX+=this.boatVX*dt;
    this.boatX=Math.max(50,Math.min(W-80,this.boatX));
    if(this.boatVX<-5) this.boatFacing=true;
    if(this.boatVX>5)  this.boatFacing=false;

    // Boat bobs on water
    this.boatY=this.WATER_Y-12+Math.sin(Date.now()*0.003)*3;
    this.boatContainer.setPosition(this.boatX,this.boatY);
    this.boatImg.setFlipX(this.boatFacing);

    // Player sprite follows boat
    this.playerSpr.setPosition(this.boatX,this.boatY-30);
    this.playerSpr.setFlipX(this.boatFacing);
    this.playerSpr.setTexture(Math.abs(this.boatVX)>20?`player_walk${Math.floor(Date.now()/120)%8}`:'player_idle0');

    // Wake
    this.wake.clear();
    if(Math.abs(this.boatVX)>10){
      this.wake.fillStyle(0xaaddff,0.35);
      const wx=this.boatFacing?this.boatX+40:this.boatX-40;
      this.wake.fillEllipse(wx,this.WATER_Y-4,60,10);
    }

    // Animate waves
    this.waveTiles.forEach(wt=>wt.setTexture(`flood_${this.waveFrame}`));

    // Float debris moves
    const boatMoving = Math.abs(this.boatVX) > 5;
    this.floatItems.forEach(d=>{
      d.phase+=0.02; d.x+=d.vx;
      if(d.x<-50) d.x=W+50; if(d.x>W+50) d.x=-50;
      d.sprite.setPosition(d.x, this.WATER_Y-6+Math.sin(d.phase)*3);
      // Only hit boat if it is MOVING — standing still = debris passes under
      if(boatMoving && !this._hitCooldown && Math.abs(d.x-this.boatX)<40 && Math.abs(d.sprite.y-this.boatY)<20) this.hitBoat();
    });

    // E key
    if(Phaser.Input.Keyboard.JustDown(k.interact)||window._mAction){ window._mAction=false; this.tryInteract(); }

    // Hint
    let hint='';
    const hq=this.hqZone;
    if(this.onBoard>0&&Math.abs(this.boatX-hq.x)<60) hint=`[ E ] Deliver ${this.onBoard} survivor${this.onBoard>1?'s':''}!`;
    else {
      const ns=this.survivors.find(s=>!s.rescued&&Math.abs(this.boatX-s.x)<60);
      if(ns&&this.onBoard<2) hint='[ E ] Pick up survivor!';
    }
    this.hintTxt.setText(hint).setVisible(hint!=='');

    // Show SAFE indicator when still — debris passes harmlessly
    if(!boatMoving){
      this.statusTxt.setText('⚓ STANDING STILL — Debris passes safely! Move to row.').setColor('#00ff88');
    } else {
      this.statusTxt.setText('🚤 Row to survivors — press E to pick up, then reach HQ!').setColor('#44aacc');
    }

    this.updateHUD();
  }
}
