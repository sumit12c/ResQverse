      '💀  Debris hits you while uncovered = GAME OVER',
      '🚪  After quake stops, walk to the EXIT door →',
      '⏱  Faster escape = higher time bonus score!',
    ];
    const tipBg=this.add.graphics();
    tipBg.fillStyle(0xffd700,0.08); tipBg.fillRoundedRect(cx-220,200,440,130,8);
    tipBg.lineStyle(1,0xffd700,0.3); tipBg.strokeRoundedRect(cx-220,200,440,130,8);
